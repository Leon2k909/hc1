    TextureRoughness "materials/railhead/rw_buffer_frame_dark_rough.png"
    TextureMetalness "materials/railhead/rw_buffer_frame_dark_metal.png"
    TextureAmbientOcclusion "materials/railhead/rw_buffer_frame_dark_ao.png"
}
