    TextureAmbientOcclusion "materials/default/default_ao.tga"
    TextureColor "materials/lowtide/lt_skip_color.png"
    TextureNormal "materials/lowtide/lt_skip_normal.png"
    TextureRoughness "materials/lowtide/lt_skip_rough.png"
    TextureMetalness "materials/lowtide/lt_skip_metal.png"
}
