// Tools/lowtide_skip.py: yellow enamel, chipped steel and corrosion
"Layer0"
{
    shader "shaders/complex.shader"
    F_SPECULAR "1"
    F_METALNESS_TEXTURE "1"
    g_flAmbientOcclusionDirectDiffuse "1"
    g_flAmbientOcclusionDirectSpecular "1"
