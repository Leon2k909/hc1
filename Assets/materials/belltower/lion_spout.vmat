// Carved lion mask for the Belltower fountain. The mesh follows the image's opaque silhouette.
"Layer0"
{
    shader "shaders/complex.shader"
    F_SPECULAR "1"
    g_flRoughnessScaleFactor "1"
    g_flMetalness "0.00"
    TextureColor "materials/belltower/lion_spout_color.png"
    TextureNormal "materials/default/default_normal.tga"
    TextureRoughness "materials/belltower/ashlar_rough.png"
    TextureAmbientOcclusion "materials/belltower/ashlar_ao.png"
    g_vColorTint "[1.0 1.0 1.0 1.0]"
    g_flModelTintAmount "1.0"
}
