# Auto detect text files and perform LF normalization
*          text=auto
*.cs       text diff=csharp
*.vpk binary
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.vmap filter=lfs diff=lfs merge=lfs -text
*.vpk filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.smd filter=lfs diff=lfs merge=lfs -text
*.vmdl_c filter=lfs diff=lfs merge=lfs -text
*.vtex_c filter=lfs diff=lfs merge=lfs -text
*.vpcf_c filter=lfs diff=lfs merge=lfs -text
*.vmap_c filter=lfs diff=lfs merge=lfs -text
*.generated.vtex_c filter=lfs diff=lfs merge=lfs -text
