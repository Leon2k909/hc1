# Auto detect text files and perform LF normalization
*          text=auto
*.cs       text diff=csharp
*.vpk binary
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.vmap filter=lfs diff=lfs merge=lfs -text
*.vpk filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.smd filter=lfs diff=lfs merge=lfs -text
*.vmdl_c filter=lfs diff=lfs merge=lfs -text
*.vtex_c filter=lfs diff=lfs merge=lfs -text
*.vpcf_c filter=lfs diff=lfs merge=lfs -text
*.vmap_c filter=lfs diff=lfs merge=lfs -text
*.generated.vtex_c filter=lfs diff=lfs merge=lfs -text

# Generated town geometry, over GitHub's 100 MB limit: in LFS, which also avoids lengthy text comparisons that
# lock native imports. The centre is 103.4 MB of GitHub's 104.9 MB limit, so it's in LFS before it crosses it.
Assets/models/maps/belltower/belltower_west.obj filter=lfs diff=lfs merge=lfs -text
Assets/models/maps/belltower/belltower_east.obj filter=lfs diff=lfs merge=lfs -text
Assets/models/maps/belltower/belltower_centre.obj filter=lfs diff=lfs merge=lfs -text

# Generated Spillway scenery: inspect the Python sources and native captures.
Assets/models/maps/spillway/spillway_mountains.obj -diff
Assets/models/maps/spillway/spillway_forest.obj -diff
Assets/models/maps/spillway/spillway_backdrop.obj -diff
