
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
!Tools/BlastLimbExport/BlastLimbExport.csproj
!Tools/ReconChecks/ReconChecks.csproj
!Tools/SharingChecks/SharingChecks.csproj
!Tools/BotStanceChecks/BotStanceChecks.csproj
!Tools/PipeClimbChecks/PipeClimbChecks.csproj
!Tools/SmokeChecks/SmokeChecks.csproj
!Tools/SlideChecks/SlideChecks.csproj
!Tools/TacticalChecks/TacticalChecks.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*
code/.vs/*

# Standalone Builds
Exports/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
# Engine-baked warehouse probes have no uncompiled texture equivalent.
!Assets/scenes/maps/[Ll]owtide/lowtide_scene_data/ddgi/warehouse-*-v3/*.vtex_c
!Assets/scenes/maps/[Ll]owtide/lowtide_scene_data/ddgi/warehouse-*-v4/*.vtex_c
!Assets/scenes/maps/[Ll]owtide/lowtide_scene_data/ddgi/warehouse-*-v5/*.vtex_c
# Engine lighting bakes have no uncompiled texture source.
# Sewage's static cubes are compiled from native camera panoramas without the
# driver's unstable runtime GGX filter; these ready-to-load copies ship with it.
!Assets/lighting/sewage/*.vtex_c
# Cerro Blanco's native indirect lighting has no uncompiled source equivalent.
!Assets/lighting/cerroblanco/daylight-v1/irradiance.vtex_c
!Assets/lighting/cerroblanco/daylight-v1/distance.vtex_c
!Assets/lighting/cerroblanco/daylight-v1/relocation.vtex_c
# Stable static cubes compiled from the retained native camera panoramas.
!Assets/lighting/cerroblanco/daylight-v1/reflection_*.vtex_c
# Riverdale's baked indirect lighting and static camera-captured reflection cubes have no
# uncompiled texture equivalents; include them so every checkout gets the same lighting.
!Assets/lighting/riverdale/daylight-v1/*.vtex_c
!Assets/lighting/belltower/town-bake-v2/*.vtex_c
!Assets/lighting/belltower/daylight-v3/*.vtex_c
!Assets/lighting/belltower/daylight-v5/*.vtex_c
!Assets/lighting/belltower/daylight-v6/*.vtex_c
!Assets/lighting/belltower/daylight-v7/*.vtex_c
!Assets/lighting/belltower/daylight-v8/irradiance.vtex_c
!Assets/lighting/belltower/daylight-v8/distance.vtex_c
!Assets/lighting/belltower/daylight-v8/relocation.vtex_c
!Assets/lighting/belltower/daylight-v9/irradiance.vtex_c
!Assets/lighting/belltower/daylight-v9/distance.vtex_c
!Assets/lighting/belltower/daylight-v9/relocation.vtex_c
# Railhead's native indirect-light bake has no uncompiled texture equivalent.
!Assets/lighting/railhead/daylight-v3/irradiance.vtex_c
!Assets/lighting/railhead/daylight-v3/distance.vtex_c
!Assets/lighting/railhead/daylight-v3/relocation.vtex_c
# Collider's native indirect-light textures have no uncompiled equivalent.
!Assets/lighting/collider/lighting-v1/irradiance.vtex_c
!Assets/lighting/collider/lighting-v1/distance.vtex_c
!Assets/lighting/collider/lighting-v1/relocation.vtex_c
!Assets/lighting/collider/lighting-v2/irradiance.vtex_c
!Assets/lighting/collider/lighting-v2/distance.vtex_c
!Assets/lighting/collider/lighting-v2/relocation.vtex_c
!Assets/lighting/collider/reflection_*_v2.vtex_c
!Assets/lighting/collider/lighting-v3/irradiance.vtex_c
!Assets/lighting/collider/lighting-v3/distance.vtex_c
!Assets/lighting/collider/lighting-v3/relocation.vtex_c
!Assets/lighting/collider/reflection_*_v3.vtex_c
!Assets/lighting/collider/lighting-v4/irradiance.vtex_c
!Assets/lighting/collider/lighting-v4/distance.vtex_c
!Assets/lighting/collider/lighting-v4/relocation.vtex_c
*.los

*launchSettings.json
*.sln
*.slnx

*idea

# Python bytecode (Tools scripts)
__pycache__/
*.pyc

# output/ keeps its text records in git: reports, verification results, tool configs, scripts and logs, so
# anyone can run the tools and see where each piece of work stands. Its models, textures, images, staging and
# before/after copies and build files stay local; the tools on git regenerate them. Files already tracked there
# are unaffected. Folders listed after this block stay out entirely.
/output/**
!/output/**/
!/output/**/*.json
!/output/**/*.jsonl
!/output/**/*.txt
!/output/**/*.md
!/output/**/*.py
!/output/**/*.cs
!/output/**/*.csv
!/output/**/*.log
!/output/**/*.html
!/output/**/*.xml
!/output/**/*.yaml
!/output/**/*.yml
!/output/**/*.ps1
!/output/**/*.sh
!/output/**/*.bat
!/output/**/*.toml
!/output/**/*.ini
!/output/**/*.cfg
!/output/**/*.js
!/output/**/*.ts
!/output/**/*.mjs
# Screenshots saved as base64 JSON.
/output/**/editor_camera_screenshot.json
# Test builds' compiler output.
/output/**/bin/
/output/**/obj/
/output/**/build/

# Generated sources and validation captures for split ragdoll clothing
/output/blast-limbs/

# Generated gun buddy preview scene and renders
/output/pocket-scout/
/output/lowtide-brick/
/output/lowtide-water/
/output/lowtide-bridge/
/output/slide-validation/
/output/slide-build.log

# Spillway's static reflection cubes are compiled from native camera panoramas.
!Assets/lighting/spillway/reflection_*.vtex_c
!Assets/lighting/spillway/lighting-v1/irradiance.vtex_c
!Assets/lighting/spillway/lighting-v1/distance.vtex_c
!Assets/lighting/spillway/lighting-v1/relocation.vtex_c
!Assets/lighting/spillway/lighting-v2/irradiance.vtex_c
!Assets/lighting/spillway/lighting-v2/distance.vtex_c
!Assets/lighting/spillway/lighting-v2/relocation.vtex_c
!Assets/lighting/spillway/lighting-v3/irradiance.vtex_c
!Assets/lighting/spillway/lighting-v3/distance.vtex_c
!Assets/lighting/spillway/lighting-v3/relocation.vtex_c
!Assets/lighting/spillway/lighting-v4/irradiance.vtex_c
!Assets/lighting/spillway/lighting-v4/distance.vtex_c
!Assets/lighting/spillway/lighting-v4/relocation.vtex_c
# Orion: the sky's compiled cubes, copied for its static reflection probes (named by their content).
!Assets/lighting/orion/reflection_sky_*.vtex_c
!Assets/lighting/orion/reflection_wet_*.vtex_c
!Assets/lighting/ares/photographic-v1/irradiance.vtex_c
!Assets/lighting/ares/photographic-v1/distance.vtex_c
!Assets/lighting/ares/photographic-v1/relocation.vtex_c
!Assets/lighting/collider/lighting-v5/irradiance.vtex_c
!Assets/lighting/collider/lighting-v5/distance.vtex_c
!Assets/lighting/collider/lighting-v5/relocation.vtex_c
!Assets/lighting/collider/lighting-v6/irradiance.vtex_c
!Assets/lighting/collider/lighting-v6/distance.vtex_c
!Assets/lighting/collider/lighting-v6/relocation.vtex_c
!Assets/lighting/collider/reflection_*_v4.vtex_c
# Orion's staging (and v1's retired assets on the machine that built v2).
/output/orion/

# Leftovers: the editor bridge's execute_csharp temp scripts, tool logs and crash dumps.
/Editor/__Exec_*.cs
/.playwright-cli/
*.stackdump
/exceptions.txt
*.mdmp
