// Biofilm binding compiled after shader schema update.
// Tools/lowtide_masonry.py: generated granite with metre-scale weathering.
"Layer0"
{
    shader "shaders/hc1_brick.shader"
    F_SPECULAR "1"
    TextureColor "materials/lowtide/masonry/granite_color.png"
    TextureNormal "materials/lowtide/masonry/granite_normal.png"
    TextureRoughness "materials/lowtide/masonry/granite_rough.png"
    TextureAmbientOcclusion "materials/default/default_ao.tga"
    TextureMetalness "materials/default/default_black_mask.tga"
    g_vBrickScale "[1.000000 1.000000 0 0]"
    g_flTintColor "[0.94 0.96 0.93]"
    TextureCanalBiofilm "materials/lowtide/masonry/canal_biofilm_color.png"
    g_flCanalBiofilm "0.9"
    TextureShedWear "materials/lowtide/masonry/shed_wear.png"
    g_flShedWear "0.700"
}
