        {
          "name": "asset_read",
          "title": "Asset Read",
          "toolset": "asset",
          "description": "Read a game resource asset's raw json - the actual data of a prefab, sound event, clothing definition or any other GameResource type. Doesn't work on binary assets like models and textures.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Asset path, as returned by asset_search."
              }
