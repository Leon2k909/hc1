    {
      "tools": [
        {
          "name": "asset_compile",
          "title": "Asset Compile",
          "toolset": "asset",
          "description": "Recompile an asset from its source file. Compile errors and warnings land in the console - check read_console after a failure.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Asset path, as returned by asset_search."
              },
              "full": {
                "type": "boolean",
                "description": "Force a full recompile instead of an incremental one.",
                "default": false
              }
            },
            "required": [
              "path"
            ]
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "Success": {
                "type": "boolean"
              },
              "Path": {
                "type": "string"
              },
              "CompiledFile": {
                "type": "string"
              },
              "Hint": {
                "type": "string"
              }
            },
            "required": []
          }
        },
        {
          "name": "asset_dependencies",
          "title": "Asset Dependencies",
          "toolset": "asset",
          "description": "Walk an asset's relationships - the assets it references (uses), the assets that depend on it, or the assets it was generated from. Deep recurses the whole chain, e.g. a model's materials and their textures.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Asset path, as returned by asset_search."
              },
              "relation": {
                "type": "string",
                "enum": [
                  "References",
                  "Dependants",
                  "Parents"
                ],
                "description": "Which direction to walk.",
                "default": "References"
              },
              "deep": {
                "type": "boolean",
                "description": "Recurse instead of returning only direct relationships.",
                "default": false
              },
              "type": {
                "type": "string",
                "description": "Filter results to one asset type - a file extension or friendly name. See asset_types."
              },
              "limit": {
                "type": "integer",
                "description": "How many results to return.",
                "minimum": 1,
                "maximum": 500,
                "default": 100
              }
            },
            "required": [
              "path"
            ]
          },
          "annotations": {
            "readOnlyHint": true
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "Path": {
                "type": "string"
              },
              "Relation": {
                "type": "string"
              },
              "Total": {
                "type": "integer",
                "description": "How many related assets exist, beyond what's shown."
              },
              "Assets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Path": {
                      "type": "string"
                    },
                    "Type": {
                      "type": "string"
                    }
                  },
                  "required": []
                }
              }
            },
            "required": []
          }
        },
