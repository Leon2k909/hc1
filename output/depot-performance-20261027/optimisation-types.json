        {
          "name": "bridge_scatter_props",
          "title": "Native Scatter Props",
          "toolset": "bridge_helpers",
          "description": "Scatter model props with a repeatable seed, optional ground snapping, rotation, scaling and grouping. Requires stopped play mode. Uses the existing Bridge helper's scene and undo behaviour.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "Project-relative model path, as returned by asset_search."
              },
              "center": {
                "type": "string",
                "description": "World-space centre as x,y,z, in Source units."
              },
              "radius": {
                "type": "number",
                "description": "Finite, nonnegative scatter radius in Source units.",
                "default": 256
              },
              "count": {
                "type": "integer",
                "description": "Number of props, from 1 to 300.",
                "default": 10
              },
