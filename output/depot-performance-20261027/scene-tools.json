            "required": []
          },
          "annotations": {
            "readOnlyHint": true
          }
        },
        {
          "name": "create_game_object",
          "title": "Create Game Object",
          "toolset": "scene",
          "description": "Create a game object in the active scene - empty or from a prefab, optionally with components. For putting a model in the scene, spawn_model is quicker. The user can undo this. Returns the new object's id for the other scene tools.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name for the new object. Empty picks a sensible default."
              },
              "parent": {
                "type": "string",
                "description": "Parent game object id. Empty parents to the scene root."
              },
              "prefab": {
                "type": "string",
                "description": "Prefab asset path to instantiate, from asset_search."
              },
              "position": {
                "type": "string",
                "description": "World position as 'x,y,z'. Default origin."
              },
              "angles": {
                "type": "string",
                "description": "Rotation as 'pitch,yaw,roll'."
              },
              "scale": {
                "type": "string",
                "description": "Scale as 'x,y,z', or a single number for uniform."
              },
              "components": {
                "type": "string",
                "description": "Comma separated component type names to add, e.g. 'ModelRenderer,BoxCollider'."
              }
            },
            "required": []
          },
          "outputSchema": {
            "type": "object",
            "properties": {
