        {
          "name": "find_game_objects",
          "title": "Find Game Objects",
          "toolset": "scene",
          "description": "Search a scene's game objects by name substring, component type and/or tag. All filters are optional and combine - empty filters list everything. Returns each match with its hierarchy path and id.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Case insensitive substring of the object's name."
              },
              "component": {
                "type": "string",
                "description": "Case insensitive substring of a component type name the object must have."
              },
              "tag": {
                "type": "string",
                "description": "A tag the object must have."
              },
              "scene": {
                "type": "string",
                "description": "Scene name or resource path from list_scenes. Empty for the active scene."
              },
              "limit": {
                "type": "integer",
                "description": "How many matches to return.",
                "minimum": 1,
                "maximum": 500,
                "default": 100
              }
            },
            "required": []
          },
          "annotations": {
            "readOnlyHint": true
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "Total": {
                "type": "integer",
                "description": "How many matched in total, beyond what's shown."
              },
              "Results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Name": {
                      "type": "string"
                    },
                    "Id": {
                      "type": "string"
                    },
                    "Path": {
                      "type": "string",
                      "description": "The object's place in the hierarchy, like 'Map/Props/Barrel'."
                    },
                    "Enabled": {
                      "type": "boolean"
                    },
                    "Components": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": []
                }
              },
              "Truncated": {
                "type": "boolean",
                "description": "True when the scene was too big to finish searching."
              }
            },
            "required": []
          }
