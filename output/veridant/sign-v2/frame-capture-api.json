{"code":"return AppDomain.CurrentDomain.GetAssemblies().Where(a=>a.GetName().Name.StartsWith(\"Sandbox\")||a.GetName().Name.StartsWith(\"tools\")).SelectMany(a=>a.GetTypes()).Where(t=>t.Name.Contains(\"Screenshot\")||t.Name.Contains(\"SceneView\")||t.Name.Contains(\"ScreenCapture\")||t.Name.Contains(\"SceneRendering\")).Select(t=>new { Name=t.FullName, Methods=t.GetMethods(System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Static|System.Reflection.BindingFlags.Instance).Where(m=>m.Name.Contains(\"Capture\")||m.Name.Contains(\"Screenshot\")||m.Name.Contains(\"Save\")).Select(m=>m.ToString()).ToArray() }).ToArray();"}
