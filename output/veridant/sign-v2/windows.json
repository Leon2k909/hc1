{"code":"return AppDomain.CurrentDomain.GetAssemblies().Where(a=>!a.IsDynamic).SelectMany(a=>a.GetTypes()).Where(t=>typeof(Editor.Window).IsAssignableFrom(t)&& (t.Name.Contains(\"Main\")||t.Name.Contains(\"Scene\")||t.Name.Contains(\"EditorWindow\"))).Select(t=>new { Name=t.FullName, Props=t.GetProperties(System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Static).Select(p=>p.ToString()).ToArray(), Fields=t.GetFields(System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Static).Select(p=>p.ToString()).ToArray() }).ToArray();"}
