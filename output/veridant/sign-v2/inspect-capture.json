{"code":"var t=AppDomain.CurrentDomain.GetAssemblies().Select(a=>a.GetType(\"Editor.Mcp.SceneTools\")).FirstOrDefault(x=>x!=null); return new { Methods=t?.GetMethods(System.Reflection.BindingFlags.Static|System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic).Where(m=>m.Name.Contains(\"Screenshot\")).Select(m=>new { Signature=m.ToString(), IL=Convert.ToHexString(m.GetMethodBody().GetILAsByteArray()) }).ToArray(), Widget=typeof(Editor.Widget).GetMethods(System.Reflection.BindingFlags.Instance|System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.NonPublic).Where(m=>m.Name.Contains(\"Render\")||m.Name.Contains(\"Grab\")||m.Name.Contains(\"Capture\")||m.Name.Contains(\"Pixmap\")).Select(m=>m.ToString()).ToArray() };"}
