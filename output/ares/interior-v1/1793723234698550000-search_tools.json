    {
      "name": "scene_tree",
      "title": "Scene Tree",
      "toolset": "scene",
      "description": "The game object hierarchy of an open scene - every object's name, id, enabled state and component types, nested like the editor's hierarchy panel. Use the ids with get_game_object to dig into a specific object.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scene": {
            "type": "string",
            "description": "Scene name or resource path from list_scenes. Empty for the active scene."
          },
          "maxDepth": {
            "type": "integer",
            "description": "How many levels deep to descend. 0 for unlimited.",
            "default": 0
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "Scene": {
            "type": "string"
          },
          "ResourcePath": {
            "type": "string"
          },
          "Objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Name": {
                  "type": "string"
                },
                "Id": {
                  "type": "string"
                },
                "Enabled": {
                  "type": "boolean"
                },
                "Components": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "Children": {
                  "type": "array",
                  "items": {},
                  "description": "Child objects. Null when the depth limit or node budget cut them off."
                },
                "ChildrenNotShown": {
                  "type": "integer",
                  "description": "How many children weren't shown."
                }
              },
              "required": []
            }
          }
        },
        "required": []
      }
    },
    {
      "name": "set_game_object",
      "title": "Set Game Object",
      "toolset": "scene",
      "description": "Change a game object - rename, enable/disable, reparent, move, rotate or scale. Only the arguments you give change; everything else stays. The user can undo this.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The game object's id, from scene_tree or find_game_objects."
          },
          "name": {
            "type": "string",
            "description": "New name."
          },
          "enabled": {
            "type": "boolean",
            "description": "Enable or disable the object."
          },
          "parent": {
            "type": "string",
            "description": "New parent game object id, or 'root' for the scene root."
          },
          "position": {
            "type": "string",
            "description": "World position as 'x,y,z'."
          },
          "angles": {
            "type": "string",
            "description": "Rotation as 'pitch,yaw,roll'."
          },
          "scale": {
            "type": "string",
            "description": "Scale as 'x,y,z', or a single number for uniform."
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
