{
  "tools": [
    {
      "name": "add_component",
      "title": "Add Component",
      "toolset": "scene",
      "description": "Add a component to a game object, optionally setting its properties in the same call. The user can undo this. Returns the component's id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The game object's id, from scene_tree or find_game_objects."
          },
          "type": {
            "type": "string",
            "description": "The component type name, e.g. 'ModelRenderer'. get_component_type documents what exists."
          },
          "properties": {
            "type": "object",
            "description": "Optional json object of property values, e.g. {\"LightColor\": \"1,0.8,0.6,1\", \"Radius\": 512}."
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Type": {
            "type": "string"
          },
          "GameObject": {
            "type": "string"
          }
        },
        "required": []
      }
    },
    {
      "name": "delete_game_object",
      "title": "Delete Game Object",
      "toolset": "scene",
      "description": "Delete a game object and its children. The user can undo this.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The game object's id, from scene_tree or find_game_objects."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_game_object",
      "title": "Get Game Object",
      "toolset": "scene",
      "description": "Everything about one game object - enabled state, tags, world transform, parent, children, and its components. Set includeComponentProperties to also get every component's serialized properties.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The game object's id, from scene_tree or find_game_objects."
          },
          "includeComponentProperties": {
            "type": "boolean",
            "description": "Include the full serialized properties of every component, not just their types.",
            "default": false
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "Scene": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "Enabled": {
            "type": "boolean"
          },
          "ActiveInHierarchy": {
            "type": "boolean"
          },
          "Tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Parent": {
            "type": "object",
            "properties": {
              "Id": {
                "type": "string"
              },
              "Name": {
                "type": "string"
              }
            },
            "required": [],
            "description": "The parent. Null when parented to the scene root."
          },
          "WorldPosition": {
            "type": "string"
          },
          "WorldRotation": {
            "type": "string"
          },
          "WorldScale": {
            "type": "string"
          },
          "Components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Type": {
                  "type": "string"
                },
                "Id": {
                  "type": "string"
                },
                "Enabled": {
                  "type": "boolean"
                },
                "Properties": {
                  "description": "The serialized properties. Null unless includeComponentProperties was set."
                }
              },
              "required": []
            }
          },
          "Children": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string"
                },
                "Name": {
                  "type": "string"
                },
                "Enabled": {
                  "type": "boolean"
                }
              },
              "required": []
            }
          }
        },
        "required": []
      }
