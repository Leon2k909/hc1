{
  "tools": [
    {
      "name": "get_game_object",
      "title": "Get Game Object",
      "toolset": "scene",
      "description": "Everything about one game object - enabled state, tags, world transform, parent, children, and its components. Set includeComponentProperties to also get every component's serialized properties.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The game object's id, from scene_tree or find_game_objects."
          },
          "includeComponentProperties": {
            "type": "boolean",
            "description": "Include the full serialized properties of every component, not just their types.",
            "default": false
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "Scene": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "Enabled": {
            "type": "boolean"
          },
          "ActiveInHierarchy": {
            "type": "boolean"
          },
          "Tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Parent": {
            "type": "object",
            "properties": {
              "Id": {
                "type": "string"
              },
              "Name": {
                "type": "string"
              }
            },
            "required": [],
            "description": "The parent. Null when parented to the scene root."
          },
          "WorldPosition": {
            "type": "string"
          },
          "WorldRotation": {
            "type": "string"
          },
          "WorldScale": {
            "type": "string"
          },
          "Components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Type": {
                  "type": "string"
                },
                "Id": {
                  "type": "string"
                },
                "Enabled": {
                  "type": "boolean"
                },
                "Properties": {
                  "description": "The serialized properties. Null unless includeComponentProperties was set."
                }
              },
              "required": []
            }
          },
          "Children": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string"
                },
                "Name": {
                  "type": "string"
                },
                "Enabled": {
                  "type": "boolean"
                }
              },
              "required": []
            }
          }
        },
        "required": []
      }
    },
    {
      "name": "scene_tree",
      "title": "Scene Tree",
      "toolset": "scene",
      "description": "The game object hierarchy of an open scene - every object's name, id, enabled state and component types, nested like the editor's hierarchy panel. Use the ids with get_game_object to dig into a specific object.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scene": {
            "type": "string",
            "description": "Scene name or resource path from list_scenes. Empty for the active scene."
          },
          "maxDepth": {
            "type": "integer",
            "description": "How many levels deep to descend. 0 for unlimited.",
            "default": 0
          }
        },
        "required": []
      },
      "annotations": {
        "readOnlyHint": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "Scene": {
            "type": "string"
          },
          "ResourcePath": {
            "type": "string"
          },
          "Objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Name": {
                  "type": "string"
                },
                "Id": {
                  "type": "string"
                },
                "Enabled": {
                  "type": "boolean"
                },
                "Components": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "Children": {
                  "type": "array",
                  "items": {},
                  "description": "Child objects. Null when the depth limit or node budget cut them off."
                },
                "ChildrenNotShown": {
                  "type": "integer",
                  "description": "How many children weren't shown."
                }
              },
              "required": []
            }
          }
        },
        "required": []
      }
    },
    {
      "name": "set_component",
      "title": "Set Component",
      "toolset": "scene",
      "description": "Set properties on a component. Give the component's id, or its game object's id plus a type name. Values use the same serialized forms get_game_object shows - strings, numbers, 'x,y,z' vectors, colors as 'r,g,b,a', asset paths as strings. Everything validates before anything applies, and the user can undo it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The component's id, or its game object's id."
          },
          "properties": {
            "type": "object",
            "description": "A json object of property name to new value."
          },
          "type": {
            "type": "string",
            "description": "The component type to change, when id is a game object."
          }
        },
        "required": [
          "id",
          "properties"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Type": {
            "type": "string"
          },
          "Applied": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": []
      }
    }
  ],
  "total": 402
}
