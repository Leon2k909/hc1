    "Tools/ares_stage_cargo_cases.py": "9203dc9453763a50af7c7eb48d23e0d0582713d24da60c46b2e699d6c4bddcbe",
    "Tools/map_kit.py": "cc60204c747d064cb1fecdb666b24c847ae89dc863c2533d3811a0445f22020d",
    "Tools/riverdale_parts.py": "a90f4f134053eb3397b2073f1ca4bb3bdc0bfb80a9521dce64ca1017e747f732",
    "Sources/Ares/crate-v2/original-case.py.txt": "3446074a3e70f93bf309b1a108f55f8122be9f9d99fbe4169abc1017df5ebb11"
