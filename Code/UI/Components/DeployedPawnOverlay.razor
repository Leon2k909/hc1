@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

@if ( !Player.IsValid() )
    return;

@if ( !Player.GetComponent<DeployedPawnHandler>().IsValid() )
    return;

@if ( !Player.GetComponent<DeployedPawnHandler>().Pawn.IsValid() )
    return;

<root>
    <div class="warning">
        <div class="flex layout align-center grow">
            <label class="small slight">@Message</label>
            <div class="grow" />
            <InputHint class="small" Action="Use" />
        </div>
    </div>
</root>

@code
{
    public Panel Overlay { get; set; }
    public Client Player => Client.Viewer;

    public string Message
    {
        get
        {
            if ( Player.Components.Get<DeployedPawnHandler>() is { } handler )
            {
                // Whole lines ("Exit Drone"), since the pawn's name takes an article in other languages.
                // The drone is the only deployable pawn; anything else would stay English.
                var drone = handler.Pawn is Drone;
                if ( Player.Pawn == handler.Pawn )
                    return drone ? Tr( "Exit Drone" ) : $"Exit {handler.Pawn.NameType}";
                else
                    return drone ? Tr( "Return to Drone" ) : $"Return to {handler.Pawn.NameType}";
            }

            return "";
        }
    }

    protected override int BuildHash()
    {
        if ( !Player.IsValid() ) return 1;

        return HashCode.Combine( Time.Now );
    }
}