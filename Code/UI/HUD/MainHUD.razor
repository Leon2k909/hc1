@namespace Facepunch.UI
@using Sandbox.Events
@inherits PanelComponent
@implements IGameEventHandler<OnScoreAddedEvent>
@implements IGameEventHandler<KillEvent>

@if ( Scene is null )
    return;

@{
    // While a team-win banner is up it's the only thing on screen: no spectate panel, crosshair or scores over it.
    var winBanner = Toast.IsWinShowing;
    var hasPawn = Client.Viewer.IsValid() && Client.Viewer.Pawn.IsValid();
    // Flying the recon octocopter, the screen is its camera's feed and the feed's own display (ReconOctocopterFeed).
    var piloting = Client.Viewer.IsValid() && ReconOctocopter.IsPiloting( Client.Viewer.PlayerPawn );
    var isValidPlayer = hasPawn && !winBanner && !piloting;
    var hideCombatMouse = isValidPlayer && GameUtils.ShouldHideCombatMouse();
    var rootClass = IsHudEnabled ? (hideCombatMouse ? "combat-cursor-hidden" : "") : "hidden";
}

<root class="@rootClass">
    @if ( isValidPlayer )
    {
        <ScopeOverlay />
        <ScreenProtectionOverlay />
        <div class="center-layer">
            <MedalFeed @ref="MedalFeed" />
        </div>

        <!-- UI Overlay (Esc) -->
        <DamageOverlay />
        <CrosshairHud />
    }

    <canvas>
        <Toast />

        @{
            var isZombies = Scene.GetAllComponents<ZombiesGameMode>().Any();
            var isBattleRoyale = GameUtils.IsBattleRoyale;
        }

        @* The round's strip (scores, clock, mode), top centre. *@
        @if ( !isBattleRoyale && !isZombies && !winBanner && !piloting )
        {
            <div class="hud top-middle round-top">
                <RoundStateDisplay />
            </div>
        }

        <div class="hud with-deadzone bottom-left gap-sm flex column">
            @if ( isValidPlayer )
            {
                <Vitals />
            }

            @if ( isBattleRoyale && !winBanner && !piloting )
            {
                <BattleRoyaleRadar />
            }
            else if ( !isZombies && !winBanner && !piloting && !(GameMode.Instance?.Hardcore ?? false) )
            {
                <Minimap />
            }
        </div>

        @if ( isZombies )
        {
            <ZombiesRoundUI />
        }

        @if ( isBattleRoyale && !winBanner )
        {
            <BattleRoyaleHud />
        }

        @if ( isValidPlayer )
        {   
            <EquipmentOverlay />
            <DefuseObjectiveHud />
            <Spectating />
            <Deathcam />
            <DefuseKitDisplay />
            <DamageIndicator />
            <KillFeed @ref="KillFeed" />
        }


        <div class="right">
            <div class="flex-grow" />
            <Voices />

            @if ( isValidPlayer )
            {
                @if ( isZombies )
                {
                    <ZombiesPointsPanel />
                }
                <div class="combat-readout">
                    <WeaponInfoComponent />
                    <Ammo />

                    @{
                        var score = Client.Viewer.GetComponent<Facepunch.UI.PlayerScore>();
                    }
                    @if ( score.IsValid() && score.BankedUAVs > 0 )
                    {
                        <div class="scorestreak-ready">
                            <label>@Tr( "UAV READY ({0})", score.BankedUAVs )</label>
                            <InputHint Action="Scorestreak" class="small" Size="@InputGlyphSize.Small" />
                        </div>
                    }
                </div>
            }

            @* The mode's name and Hot Zone's countdown are under the round's strip (RoundStateDisplay). In battle royale
               and Zombies, which have no strip, the mode's name stays here. *@
            @if ( GameMode.Instance.IsValid() && !winBanner && ( isBattleRoyale || isZombies ) )
            {
                <div class="mode-name-label" style="text-align: right; padding: 4px 8px; font-size: 9px; font-weight: bold; letter-spacing: 1px; color: rgba(255,255,255,0.6);">@Tr( GameMode.Instance.DisplayTitle )</div>
            }
        </div>

        @if ( isValidPlayer )
        {
            @* <Radio /> *@
            <ScoringSystem @ref="ScoringSystem" />
        }

        @if ( !hasPawn && !winBanner )
        {
            <RespawnScreen />
        }
    </canvas>
    
    @if ( isValidPlayer )
    {
        <!-- Full-screen overlays -->
        <MarkerSystem />

        <PlayAreaOverlay />
        <DeployedPawnOverlay />
    }

    @if ( hasPawn && !winBanner )
    {
        <ReconOctocopterFeed />
        <CombatMouseLock />
    }

    <ClassSelect />
    <ZombiesWorkbenchPanel />
    <Scoreboard />
    <EndOfMatchScreen />
</root>

@code 
{
    [ConVar( "cl_drawhud" )]
    public static bool IsHudEnabled { get; set; } = true;

    [DeveloperCommand( "Toggle HUD", "Visuals" )]
    private static void Command_ToggleHUD()
    {
        IsHudEnabled = !IsHudEnabled;
    }

    public ScoringSystem ScoringSystem { get; set; }

    public KillFeed KillFeed { get; set; }

    public MedalFeed MedalFeed { get; set; }

    protected override void OnStart()
    {
        // Re-apply saved volume settings (music mute, etc.) when entering a game,
        // so they persist across play sessions in the editor.
        GameSettingsSystem.ApplyVolumes();
    }

    void IGameEventHandler<OnScoreAddedEvent>.OnGameEvent( OnScoreAddedEvent eventArgs )
    {
        if ( !ScoringSystem.IsValid() )
        {
            return;
        }

        ScoringSystem.OnScore( eventArgs.Score, eventArgs.Reason );
    }

    void IGameEventHandler<KillEvent>.OnGameEvent( KillEvent eventArgs )
    {
        MedalFeed?.OnKill( eventArgs );
        KillSounds.OnKill( eventArgs );
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();
        if ( Input.EscapePressed )
        {
            Input.EscapePressed = false;
            // An open list (the settings' language picker), then the gunsmith (opened over the match) step back first.
            if ( !LanguageMenu.CloseAny() && !GunsmithPanel.HandleEscapeAny() && !ClassSelect.CloseAny() && !ZombiesWorkbenchPanel.CloseAny() )
                PauseMenuPanel.ToggleAny();
        }
        GameUtils.TraceCombatMouse( "MainHUD.OnUpdate.before" );
        GameUtils.UpdateCombatMouseVisibility();
        GameUtils.TraceCombatMouse( "MainHUD.OnUpdate.after" );
    }

    protected override void OnPreRender()
    {
        base.OnPreRender();
        GameUtils.TraceCombatMouse( "MainHUD.OnPreRender.before" );
        GameUtils.UpdateCombatMouseVisibility();
        GameUtils.TraceCombatMouse( "MainHUD.OnPreRender.after" );
    }

    protected override int BuildHash()
    {
        var hpManager = GameMode.Instance.IsValid() ? GameMode.Instance.GetComponentInChildren<HardpointManager>() : null;
        float relocateTimer = hpManager.IsValid() ? hpManager.RelocateTimer : 0f;
        bool isHardcore = GameMode.Instance.IsValid() && GameMode.Instance.Hardcore;
        var score = Client.Viewer.IsValid() ? Client.Viewer.GetComponent<Facepunch.UI.PlayerScore>() : null;
        int bankedUAVs = score.IsValid() ? score.BankedUAVs : 0;
        return HashCode.Combine(IsHudEnabled, Client.Viewer.IsValid(), Client.Viewer.IsValid() && Client.Viewer.Pawn.IsValid(), Math.Ceiling( relocateTimer ), isHardcore, bankedUAVs, Toast.IsWinShowing,
            Client.Viewer.IsValid() && ReconOctocopter.IsPiloting( Client.Viewer.PlayerPawn ) );
    }
}
