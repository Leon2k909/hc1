@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

@if ( Scene is null )
{
    return;
}

@if ( !Client.IsValid() )
{
    return;
}

@if ( !Respawner.IsValid() )
{
    return;
}

@if ( Client.PlayerPawn.IsValid() )
{
    return;
}

@if ( Client.RespawnState == RespawnState.Immediate ) 
{
    return;
}

<root>
    @if ( Respawner is PlayerAutoRespawner auto )
    {
        <div class="default-respawner">
            <div class="label">@Tr( "Deploying in {0}", auto.GetRespawnTime() )</div>
        </div>
    }

    @if ( Respawner is PlayerInputRespawner input )
    {
        <div class="default-respawner">
            @if (input.GetRespawnTime() <= 0f )
            {
                @* The words go around the button in the translation's order: {0} marks where it sits. *@
                <div class="label">
                    @foreach ( var piece in System.Text.RegularExpressions.Regex.Split( Tr( "Press {0} to deploy" ), "(\\{0\\})" ) )
                    {
                        @if ( piece == "{0}" )
                        {
                            <InputHint class="small" Action=@input.InputAction />
                        }
                        else if ( !string.IsNullOrWhiteSpace( piece ) )
                        {
                            <label>@piece</label>
                        }
                    }
                </div>
            }
            else
            {
                <div class="label">@Tr( "Deploying in {0}", input.GetRespawnTime() )</div>
            }
        </div>
    }

</root>

@code
{
    public Respawner Respawner => Scene?.GetAllComponents<Respawner>().FirstOrDefault();
    public Client Client => Client.Local;

    protected override int BuildHash()
    {
        var client = Client;
        if ( Scene is null || !client.IsValid() )
            return 0;

        var respawner = Respawner;
        if ( !respawner.IsValid() )
            return 1;

        // The countdown is in whole seconds, and only shows while waiting to deploy.
        var waiting = !client.PlayerPawn.IsValid() && client.RespawnState != RespawnState.Immediate;
        return System.HashCode.Combine( respawner, waiting, waiting ? respawner.GetRespawnTime() : -1,
            respawner is PlayerInputRespawner input ? input.InputAction : null );
    }
}