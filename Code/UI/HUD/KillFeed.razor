@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

<root>
    @foreach ( var entry in Entries )
    {
        var mine = IsMe( entry.AttackerSteamId );
        var died = IsMe( entry.VictimSteamId );

        <div @key="entry.Id" class="entry">
            <div class="plate @(died ? "died" : mine ? "mine" : "")">
                @if ( entry.Attacker is not null )
                {
                    <div class="name @(mine ? "is-me" : "")">
                        @if ( entry.DamageFlags.HasFlag( DamageFlags.AirShot ) )
                        {
                            <Icon class="glyph" Tint="@(mine ? "white" : entry.AttackerColor.Hex)" File="/ui/wings.png" size="18" />
                        }

                        @if ( entry.AttackerIsBot )
                        {
                            <Icon class="bot" Tint="@entry.AttackerColor.Hex" File="/ui/bot.png" size="16" />
                        }

                        <label style="@(mine ? "" : $"color:{entry.AttackerColor.Hex}")">@entry.Attacker</label>
                    </div>
                }

                <div class="method">
                    @if ( entry.DamageFlags.HasFlag( DamageFlags.Burn ) )
                    {
                        <Icon class="glyph" File="/ui/fire.png" size="20" />
                    }

                    @if ( entry.DamageFlags.HasFlag( DamageFlags.Explosion ) )
                    {
                        <Icon class="glyph" File="/ui/explosion.png" size="20" />
                    }

                    @if ( entry.Inflictor is null )
                    {
                        <label class="method-text">@Tr( "killed" )</label>
                    }
                    else if ( entry.Inflictor.StartsWith( "icon:" ) )
                    {
                        <div class="weapon" style="background-image: url( @entry.InflictorIcon );" />
                    }
                    else
                    {
                        <label class="method-text">@entry.Inflictor</label>
                    }

                    @if ( entry.DamageFlags.HasFlag( DamageFlags.WallBang ) )
                    {
                        <Icon class="glyph" File="/ui/wallbang.png" size="20" />
                    }

                    @if ( entry.HitboxTags.HasFlag( HitboxTags.Head ) )
                    {
                        <Icon class="glyph headshot" File="/ui/headshot.png" size="22" />
                    }
                </div>

                @if ( entry.Victim is not null )
                {
                    <div class="name @(died ? "is-me" : "")">
                        @if ( entry.VictimIsBot )
                        {
                            <Icon class="bot" Tint="@entry.VictimColor.Hex" File="/ui/bot.png" size="16" />
                        }

                        <label style="@(died ? "" : $"color:{entry.VictimColor.Hex}")">@entry.Victim</label>
                    </div>
                }

            </div>
        </div>
    }
</root>

@code
{
    private static KillFeed Instance { get; set; } = null;
    private static int _nextId;

    public KillFeed()
    {
        Instance = this;
    }

    public bool IsMe( ulong steamId )
    {
        return steamId != 0 && Client.Local.IsValid() && !Client.Local.IsBot && Client.Local.SteamId == steamId;
    }

    public record KillFeedEntry( int Id, string Attacker, Color AttackerColor, string Inflictor, string Victim, Color VictimColor, HitboxTags HitboxTags, DamageFlags DamageFlags,
        RealTimeSince TimeSinceAdded, ulong AttackerSteamId, ulong VictimSteamId, bool AttackerIsBot, bool VictimIsBot )
    {
        public string AttackerIcon => Attacker.Replace("icon:", "");
        public string InflictorIcon => Inflictor.Replace("icon:", "");
        public string VictimIcon => Victim.Replace( "icon:", "" );
    }

    private List<KillFeedEntry> Entries { get; set; } = new();

    private float Lifetime => 10f;

    [Rpc.Broadcast]
    public static void BroadcastKillFeedEvent( string attacker, Color attackerColor, string inflictor, string victim, Color victimColor, HitboxTags tags, DamageFlags flags,
        ulong attackerSteamId, ulong victimSteamId, bool attackerIsBot, bool victimIsBot )
    {
        if ( !Instance.IsValid() )
            return;

        Instance.Entries.Add( new KillFeedEntry( ++_nextId, attacker, attackerColor, inflictor, victim, victimColor, tags, flags, 0, attackerSteamId, victimSteamId, attackerIsBot, victimIsBot ) );
        Instance.StateHasChanged();
    }

    public static void RecordEvent( DamageInfo damageInfo )
    {
        var attackerDesc = GameUtils.GetDescription( damageInfo.Attacker );
        var inflictorDesc = GameUtils.GetDescription( damageInfo.Inflictor );
        var victimDesc = GameUtils.GetDescription( damageInfo.Victim );

        var attacker = ActorName( attackerDesc );
        if ( !string.IsNullOrEmpty( attackerDesc?.Icon ) ) attacker = $"icon:{attackerDesc.Icon}";

        // The gun's silhouette where there is one. A bot's shots come from the bot itself, so its gun is looked up.
        var weapon = WeaponOf( damageInfo.Inflictor );
        var inflictor = weapon?.Name ?? inflictorDesc?.DisplayName;
        if ( !string.IsNullOrEmpty( weapon?.Icon ) ) inflictor = $"icon:{weapon.Icon}";
        else if ( !string.IsNullOrEmpty( inflictorDesc?.Icon ) ) inflictor = $"icon:{inflictorDesc.Icon}";

        var victim = ActorName( victimDesc );
        if ( !string.IsNullOrEmpty( victimDesc?.Icon ) ) victim = $"icon:{victimDesc.Icon}";

        BroadcastKillFeedEvent(
            attacker, attackerDesc?.Color ?? Color.White,
            inflictor,
            victim, victimDesc?.Color ?? Color.White,
            //
            damageInfo.Hitbox,
            damageInfo.Flags,
            SteamIdOf( damageInfo.Attacker ),
            SteamIdOf( damageInfo.Victim ),
            IsBot( attackerDesc ),
            IsBot( victimDesc )
        );

    }

    // Bot labels come from actor identity, never from words in a human's name.
    private static bool IsBot( IDescription description ) => description is LightweightCombatBot
        || description is PlayerPawn pawn && pawn.Client.IsValid() && pawn.Client.IsBot;

    private static string ActorName( IDescription description )
    {
        if ( description is LightweightCombatBot bot ) return bot.BotName;
        var name = description?.DisplayName;
        if ( description is PlayerPawn pawn && pawn.Client.IsValid() && pawn.Client.IsBot )
        {
            var clan = pawn.Client.ClanTag;
            var marker = (string.IsNullOrWhiteSpace( clan ) ? "" : $"[{clan}] ") + "BOT ";
            if ( name?.StartsWith( marker, StringComparison.Ordinal ) == true )
                return marker[..^4] + name[marker.Length..];
        }
        return name;
    }

    // Capture identity with the event so renames and duplicate display names cannot change its highlights.
    private static ulong SteamIdOf( Component component )
    {
        var player = GameUtils.GetPlayerFromComponent( component );
        return player.IsValid() && player.Client.IsValid() && !player.Client.IsBot ? player.Client.SteamId : 0;
    }

    private static EquipmentResource WeaponOf( Component inflictor ) => inflictor switch
    {
        Equipment equipment => equipment.Resource,
        LightweightCombatBot bot => bot.WeaponResource,
        _ => null
    };

    public override void Tick()
    {
        // Limit entries so we don't get too busy
        if ( Entries.Count > 5 )
            Entries.RemoveRange( 0, Entries.Count - 5 );

        // Did we remove something? Entries are oldest first, so only look when the oldest has gone.
        if ( Entries.Count > 0 && Entries[0].TimeSinceAdded > Lifetime && Entries.RemoveAll( x => x.TimeSinceAdded > Lifetime ) > 0 )
        {
            StateHasChanged();
        }
    }
}
