@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

@if ( Scene is null || !Client.Local.IsValid() || !GameMode.Instance.IsValid() )
{
    return;
}

<root>
    <div class="strip">
        @if ( MyTeamScore is not null )
        {
            <div class="team mine" style="@(TeamStyle( MyTeam, "left" ))">
                <label class="score">@MyTeamScore</label>
            </div>
        }

        <div class="clock">
            @if ( IconPath is { } path && !string.IsNullOrEmpty( path ) )
            {
                <Icon File="@path" Size="30" />
            }
            else if ( Time.HasValue )
            {
                <label class="time @(Time.Value.TotalSeconds <= 30 ? "ending" : "")">@(Time?.ToString( @"m\:ss" ))</label>
            }
        </div>

        @if ( EnemyTeamScore is not null )
        {
            <div class="team theirs" style="@(TeamStyle( EnemyTeam, "right" ))">
                <label class="score">@EnemyTeamScore</label>
            </div>
        }
    </div>

    @* An ALL-CAPS key shows its translation in capitals with each language's rules (Turkish's dotted I); CSS's
       text-transform can't. *@
    <label class="mode">@Tr( ModeKey )</label>

    @if ( NextZone is { } seconds )
    {
        <label class="next-zone">@Tr( "NEXT ZONE: {0}s", seconds )</label>
    }

    @* Every match is hardcore while Core modes are off, so there's nothing to mark. Put back with Core.
    @if ( GameMode.Instance.IsValid() && GameMode.Instance.Hardcore )
    {
        <label class="hc-badge uppercase">HC</label>
    }
    *@
</root>

@code
{
    private Team MyTeam => Client.Local.IsValid() ? Client.Local.Team : Team.Unassigned;
    private Team EnemyTeam => MyTeam.GetOpponents();

    // Null where the mode keeps no team score (free-for-all), so only the clock shows.
    private string MyTeamScore { get; set; }
    private string EnemyTeamScore { get; set; }

    public string IconPath => GameMode.Instance.IsValid() ? GameMode.Instance.Get<ShowStatusIcon>()?.IconPath : "";
    public TimeSpan? Time => GameMode.Instance.IsValid() ? GameMode.Instance.DisplayedTime : null;

    // Built outside the Tr call, which check_translations.py reads its first string literal from.
    private string ModeKey => ( GameMode.Instance.IsValid() ? GameMode.Instance.DisplayTitle ?? "" : "" ).ToUpperInvariant();

    /// Hot Zone's countdown to the zone moving on.
    private double? NextZone
    {
        get
        {
            var manager = GameMode.Instance.IsValid() ? GameMode.Instance.GetComponentInChildren<HardpointManager>() : null;
            return manager.IsValid() ? Math.Max( 0, Math.Ceiling( manager.RelocateTimer ) ) : null;
        }
    }

    /// A team's block: its colour from the clock outwards, fading.
    private static string TeamStyle( Team team, string towards )
    {
        var hex = team.GetColor().Darken( 0.15f ).Hex;
        return $"background: linear-gradient( to {towards}, rgba( {hex}, 0.92 ), rgba( {hex}, 0.55 ) );";
    }

    public override void Tick()
    {
        if ( Scene is null || !Client.Local.IsValid() || !GameMode.Instance.IsValid() )
            return;

        if ( MyTeam != Team.Unassigned && EnemyTeam != Team.Unassigned
             && GameMode.Instance.Get<TeamScoring>() is { IsValid: true } teamScoring )
        {
            MyTeamScore = teamScoring.MyTeamScoreFormatted;
            EnemyTeamScore = teamScoring.OpposingTeamScoreFormatted;
        }
        else
        {
            MyTeamScore = null;
            EnemyTeamScore = null;
        }
    }

    protected override int BuildHash()
    {
        if ( Scene is null || !Client.Local.IsValid() || !GameMode.Instance.IsValid() )
            return 0;

        return HashCode.Combine( MyTeam, MyTeamScore, EnemyTeamScore, IconPath, (int?)Time?.TotalSeconds,
                                 GameMode.Instance.DisplayTitle, NextZone );
    }
}
