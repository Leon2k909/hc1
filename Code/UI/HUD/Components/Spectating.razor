@using System.Text;
@namespace Facepunch.UI
@inherits Panel

@attribute [StyleSheet]

@if ( !Client.Viewer.IsValid() || !SpectateSystem.IsValid() || !SpectateSystem.IsSpectating ) return;

@if ( !SpectateSystem.IsFreecam && (Client.Viewer.IsLocalPlayer || !Player.IsValid()) ) return;

<root class="hud with-deadzone">
    <div class="spectator-target">
        <InputHint class="cycle-hint small" Action="SpectatorPrev" Size="@InputGlyphSize.Small" />
        <div class="spectator-identity">
            <label class="spectator-title">@Tr( "SPECTATING" )</label>
            @if ( SpectateSystem.IsFreecam )
            {
                <label class="spectator-name">@Tr( "FREECAM" )</label>
            }
            else
            {
                <label class="spectator-name">@Player.DisplayName</label>
            }  
        </div>
        <InputHint class="cycle-hint small" Action="SpectatorNext" Size="@InputGlyphSize.Small" />
    </div>
    @if ( !SpectateSystem.IsFreecam )
    {
        <div class="spectator-controls">
            <div class="spectator-action">
                <InputHint class="small" Action="SpectatorFreeCam" Size="@InputGlyphSize.Small" />
                <label>@Tr( "Freecam" )</label>
            </div>
            <div class="spectator-action">
                <InputHint class="small" Action="SpectatorMode" Size="@InputGlyphSize.Small" />
                <label>@Tr( "Mode" )</label>
            </div>
        </div>
    }
</root>

@code
{
    public PlayerPawn Player => Client.Viewer?.PlayerPawn;

    public SpectateSystem SpectateSystem => SpectateSystem.Instance;

    protected override int BuildHash()
    {
        if ( !SpectateSystem.IsValid() || !Client.Viewer.IsValid() ) return 0;

        return HashCode.Combine( SpectateSystem.IsSpectating, SpectateSystem.IsFreecam,
            Player, Player.IsValid() ? Player.DisplayName : null );
    }
}
