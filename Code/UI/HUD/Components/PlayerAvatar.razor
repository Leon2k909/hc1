@namespace Facepunch.UI
@inherits Panel

@attribute [StyleSheet]

@if ( !Player.IsValid() ) { return; }

<root class="@AvatarClasses">
    <div class="avatar" style="@(IsFriendly && Player.IsValid() ? $"border: 0.5px solid {PlayerColor.Hex}" : "")">
        <img class="image" src="avatar:@Player.SteamId" />
    </div>

    @if ( !Pawn.IsValid() || IsDead )
    {
        <div style="background-image: url( ui/dead.png )" class="overlay" />

        return;
    }

    @if ( HasBomb )
    {
        <Icon File="/ui/bomb.png" size="24" class="bomb-indicator"></Icon>
    }

    @if (ShowHealth && Pawn.HealthComponent.State == LifeState.Alive && IsFriendly)
    {
        <div class="health">
            <div class="health-inner" style="width:@(HealthPercent)%" />
        </div>
    }
</root>

@code
{
    public PlayerPawn Pawn => Player.IsValid() ? Player.PlayerPawn : null;
    public Client Player { get; set; }
    public bool IsFriendly => Client.Local.IsValid() && Player.IsValid() && Client.Local.IsFriendly( Player );
    public Color PlayerColor => Player.IsValid() ? Player.PlayerColor : Color.White;
    private bool IsDead => !Pawn.IsValid() || !Pawn.HealthComponent.IsValid() || Pawn.HealthComponent.State != LifeState.Alive;

    private bool HasBomb => ShowBomb && !IsDead && IsFriendly && Pawn.Inventory.IsValid() && Pawn.Inventory.HasBomb;

    private int HealthPercent
    {
        get
        {
            var health = Pawn.IsValid() ? Pawn.HealthComponent : null;
            return health.IsValid() && health.MaxHealth > 0f
                ? (int)Math.Round( Math.Clamp( health.Health / health.MaxHealth, 0f, 1f ) * 100f ) : 0;
        }
    }

    public bool ShowBomb { get; set; } = true;
    public bool ShowHealth { get; set; } = true;

    private string AvatarClasses
    {
        get
        {
            if ( IsDead ) return "dead";
            return "";
        }
    }

    protected override int BuildHash()
    {
        return !Player.IsValid() ? 0 : HashCode.Combine( Player.SteamId, IsFriendly, IsDead,
            ShowHealth, HasBomb, ShowHealth && IsFriendly ? HealthPercent : 0, PlayerColor );
    }
}
