@using System.Text;
@namespace Facepunch.UI
@inherits Panel

@attribute [StyleSheet]

@if ( !Player.IsValid() || !Player.HealthComponent.IsValid() || Player.HealthComponent.State == LifeState.Alive || LastDamageInfo is null )
    return;

@{
    var killerPlayer = GameUtils.GetPlayerFromComponent( LastDamageInfo.Attacker );
    var killerDescription = GameUtils.GetDescription( LastDamageInfo.Attacker );
    var killerName = killerPlayer.IsValid()
        ? killerPlayer.DisplayName
        : killerDescription?.DisplayName ?? (IsZombiesMode ? "Zombie" : "Unknown");
}

<root class="hud with-deadzone flex column gap-xs">
    <div class="flex row">
        @if ( killerPlayer.IsValid() )
        {
            <img class="image" src="avatar:@killerPlayer.SteamId" />
        }
        <div class="flex column with-background with-padding h-full align-left justify-center" style="min-width: 275px;">
            <label class="text small upper">KILLED BY</label>
            <label>@killerName</label>
        </div>
    </div>

    <div class="flex row layout with-background with-padding align-center">
        <label>Press</label>
        <InputHint class="small" Action="Attack1" />
        <label>or</label>
        <InputHint class="small" Action="Attack2" />
        <label>to start spectating</label>
    </div>

    @if ( DamageEntries is not null && DamageEntries.Count > 0 )
    {
        <div class="flex column layout with-background with-padding">
            <label class="small slight">DAMAGE TAKEN</label>
            @foreach ( var entry in DamageEntries )
            {
                <div class="flex row gap-xs">
                    <label>@(entry.Damage.CeilToInt()) damage in @(entry.Count) hits - </label>
                    <label>@GetName( entry.Attacker )</label>
                </div>
            }
        </div>
    }

    @if ( InflictedDamageEntries is not null && InflictedDamageEntries.Count > 0 )
    {
        <div class="flex column layout with-background with-padding">
            <label class="small slight">INFLICTED DAMAGE</label>
            @foreach ( var entry in InflictedDamageEntries )
            {
                <div class="flex row gap-xs">
                    <label>@(entry.Damage.CeilToInt()) damage in @(entry.Count) hits</label>
                </div>
            }
        </div>
    }
</root>

@code
{
    public PlayerPawn Player => Client.Viewer?.PlayerPawn;

    public List<DamageTracker.GroupedDamage> DamageEntries => Client.Local.IsValid() ? GameMode.Instance?.Get<DamageTracker>()?.GetGroupedDamage( Client.Local ) : null;
    public List<DamageTracker.GroupedDamage> InflictedDamageEntries => Client.Local.IsValid() ? GameMode.Instance?.Get<DamageTracker>()?.GetGroupedInflictedDamage( Client.Local ) : null;

    public DamageInfo LastDamageInfo => Client.Local.IsValid() ? Client.Local.LastDamageInfo : null;
    public SpectateSystem SpectateSystem => SpectateSystem.Instance;
    private bool IsZombiesMode => GameMode.Instance?.Ident == "zombies";

    public string GetName( Component attacker )
    {
        var ply = GameUtils.GetDescription( attacker );

        return ply?.DisplayName ?? (IsZombiesMode ? "Zombie" : "Unknown");
    }

    protected override int BuildHash()
    {
        return !Player.IsValid() || !Player.HealthComponent.IsValid() ? 0 : HashCode.Combine( Player.HealthComponent.State, Player, Time.Now );
    }
}
