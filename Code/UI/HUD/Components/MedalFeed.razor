@using Sandbox
@using System.Collections.Generic
@namespace Facepunch.UI
@inherits Panel

<root>
    @foreach ( var medal in Medals )
    {
        <div @key="medal.Id" class="medal-slot @medal.Family @(medal.Fading ? "leaving" : "")">
            <div class="medal-award">
                <div class="medal-emblem">
                    <div class="medal-impact"></div>
                    <img class="medal-art" src="@($"ui/medals/{medal.Art}.png")" />
                    @if ( medal.Family != "multikill" )
                    {
                        <div class="medal-rank"><label>@medal.Rank</label></div>
                    }
                </div>
                <div class="medal-ribbon">
                    <div class="medal-sweep"></div>
                    <label class="medal-title @(medal.Title.Length > 16 ? "long-title" : "")">@medal.Title</label>
                    <div class="medal-detail">
                        <div class="medal-rule"></div>
                        <label class="medal-subtitle">@medal.Subtitle</label>
                        <div class="medal-rule"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</root>

@code
{
    private sealed class MedalInstance
    {
        public int Id { get; init; }
        public string Title { get; init; }
        public string Subtitle { get; init; }
        public string Family { get; init; }
        public string Art { get; init; }
        public string Rank { get; init; }
        public TimeSince TimeCreated { get; set; } = 0;
        public bool Fading { get; set; }
        public bool ShouldFade => TimeCreated > 1.6f;
        public bool Dead => TimeCreated > 1.9f;
    }

    private readonly List<MedalInstance> Medals = new();
    private readonly Queue<MedalInstance> PendingMedals = new();
    private TimeSince TimeSinceLastKill = 999f;
    private int RapidKillCount;
    private int LifeKillStreak;
    private int NextMedalId;
    private int Revision;

    public override void Tick()
    {
        base.Tick();

        if ( TimeSinceLastKill > 3.0f )
            RapidKillCount = 0;

        var changed = false;
        if ( Medals.Count > 0 )
        {
            var medal = Medals[0];
            if ( medal.Dead )
            {
                Medals.Clear();
                changed = true;
            }
            else if ( medal.Fading != medal.ShouldFade )
            {
                medal.Fading = medal.ShouldFade;
                changed = true;
            }
        }

        if ( Medals.Count == 0 && PendingMedals.TryDequeue( out var next ) )
        {
            next.TimeCreated = 0f;
            Medals.Add( next );
            changed = true;
        }

        if ( changed )
            RefreshFeed();

        // Use parent bounds so narrow editor views work as well as fullscreen.
        var width = Parent?.Box.Rect.Width * ScaleFromScreen ?? 1920f;
        SetClass( "compact-medals", width > 0 && width < 1100f );
    }

    public void OnKill( KillEvent eventArgs )
    {
        if ( !MainHUD.IsHudEnabled )
            return;

        var damageInfo = eventArgs.DamageInfo;
        if ( IsLocalPlayerDeath( damageInfo ) )
        {
            RapidKillCount = 0;
            LifeKillStreak = 0;
            TimeSinceLastKill = 999f;
            Medals.Clear();
            PendingMedals.Clear();
            RefreshFeed();
            return;
        }

        if ( !IsLocalPlayerKill( damageInfo ) )
            return;

        RapidKillCount = TimeSinceLastKill <= 3.0f ? RapidKillCount + 1 : 1;
        TimeSinceLastKill = 0;
        LifeKillStreak++;

        switch ( RapidKillCount )
        {
            case 2:
                AddMedal( "DOUBLE KILL", "RAPID ELIMINATIONS", "multikill", "2", "double-kill" );
                break;
            case 3:
                AddMedal( "TRIPLE KILL", "RAPID ELIMINATIONS", "multikill", "3", "triple-kill" );
                break;
            case 4:
                AddMedal( "FURY KILL", "RAPID ELIMINATIONS", "multikill", "4", "fury-kill" );
                break;
            case 5:
                AddMedal( "FRENZY KILL", "RAPID ELIMINATIONS", "multikill", "5", "frenzy-kill" );
                break;
        }

        switch ( LifeKillStreak )
        {
            case 5:
                AddMedal( "BLOODTHIRSTY", "KILL STREAK", "streak", "5" );
                break;
            case 10:
                AddMedal( "MERCILESS", "KILL STREAK", "streak", "10" );
                break;
            case 15:
                AddMedal( "RUTHLESS", "KILL STREAK", "streak", "15" );
                break;
        }

        var hitbox = damageInfo.Hitbox;
        if ( hitbox.HasFlag( HitboxTags.Head ) )
            AddMedal( "HEADSHOT", "PRECISION KILL", "precision", "HS" );

        if ( IsOneShotOneKill( damageInfo ) )
            AddMedal( "ONE SHOT, ONE KILL", "SINGLE SHOT ELIMINATION", "precision", "1" );
    }

    private bool IsLocalPlayerKill( Facepunch.DamageInfo damageInfo )
    {
        var localPawn = Client.Viewer?.Pawn as PlayerPawn;
        if ( !localPawn.IsValid() )
            return false;

        var killerPlayer = GameUtils.GetPlayerFromComponent( damageInfo.Attacker );
        if ( killerPlayer != localPawn )
            return false;

        var victimPlayer = GameUtils.GetPlayerFromComponent( damageInfo.Victim );
        var victimBot = GameUtils.GetLightweightBotFromComponent( damageInfo.Victim );
        if ( !victimPlayer.IsValid() && !victimBot.IsValid() )
            return false;

        var killerTeam = GameUtils.GetTeamFromComponent( damageInfo.Attacker );
        var victimTeam = GameUtils.GetTeamFromComponent( damageInfo.Victim );
        var isFriendly = killerTeam != Team.Unassigned && killerTeam == victimTeam;
        var isSuicide = victimPlayer == localPawn;

        return !isFriendly && !isSuicide;
    }

    private bool IsLocalPlayerDeath( Facepunch.DamageInfo damageInfo )
    {
        var localPawn = Client.Viewer?.Pawn as PlayerPawn;
        if ( !localPawn.IsValid() )
            return false;

        var victimPlayer = GameUtils.GetPlayerFromComponent( damageInfo.Victim );
        return victimPlayer == localPawn;
    }

    private static bool IsOneShotOneKill( Facepunch.DamageInfo damageInfo )
    {
        if ( damageInfo.WasExplosion || damageInfo.WasMelee || damageInfo.WasFallDamage )
            return false;

        var victimHealth = GameUtils.GetPlayerFromComponent( damageInfo.Victim )?.HealthComponent
            ?? GameUtils.GetLightweightBotFromComponent( damageInfo.Victim )?.HealthComponent;

        var maxHealth = victimHealth.IsValid() ? victimHealth.MaxHealth : 100f;
        return damageInfo.Damage >= maxHealth - 0.01f;
    }

    private void AddMedal( string title, string subtitle, string family, string rank, string art = null )
    {
        var medal = new MedalInstance
        {
            Id = ++NextMedalId,
            Title = title,
            Subtitle = subtitle,
            Family = family,
            Art = art ?? family,
            Rank = rank
        };

        PendingMedals.Enqueue( medal );
        while ( PendingMedals.Count > 24 )
            PendingMedals.Dequeue();

        if ( Medals.Count == 0 )
        {
            var first = PendingMedals.Dequeue();
            first.TimeCreated = 0f;
            Medals.Add( first );
        }

        RefreshFeed();
    }

    private void RefreshFeed()
    {
        Revision++;
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        return Revision;
    }
}
