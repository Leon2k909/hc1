@namespace Facepunch.UI
@inherits Panel
@implements IPadScope
@attribute [StyleSheet]

@if ( !IsVisible ) return;

@{
    var entries = SortedEntries;
    var ts = TeamScoring;
    var localTeam = LocalTeam;
}

<root class="eom-screen @ResultClass">

    @* ── HEADER ─────────────────────────────────────────────────── *@
    <div class="eom-header">
        <label class="eom-result-label">@ResultText</label>
        @if ( ts is not null )
        {
            <div class="eom-team-scores">
                <span class="eom-ct-score" style="color: @Team.CounterTerrorist.GetColor().Hex">
                    @ts.Scores.GetValueOrDefault( Team.CounterTerrorist )
                </span>
                <span class="eom-dash"> — </span>
                <span class="eom-t-score" style="color: @Team.Terrorist.GetColor().Hex">
                    @ts.Scores.GetValueOrDefault( Team.Terrorist )
                </span>
            </div>
        }
        <label class="eom-mode-label">@Tr( GameMode.Instance?.DisplayTitle?.ToUpper() ?? "" )</label>
    </div>

    @* ── SCOREBOARD ───���──────────────────────────────────────────── *@
    <div class="eom-table-wrap">
        <div class="eom-table-header eom-row">
            <span class="col-mvp"></span>
            <span class="col-name">@Tr( "PLAYER" )</span>
            <span class="col-stat">@Tr( "KILLS" )</span>
            <span class="col-stat">@Tr( "DEATHS" )</span>
            <span class="col-stat">K/D</span>
            <span class="col-stat">@Tr( "SCORE" )</span>
        </div>
        @foreach ( var e in entries )
        {
            var rowClass = $"eom-row{(e.IsLocal ? " is-local" : "")}{(e.IsMvp ? " is-mvp" : "")}";
            <div class="@rowClass">
                <span class="col-mvp">@(e.IsMvp ? "★" : "")</span>
                <span class="col-name">@e.Name</span>
                <span class="col-stat">@e.Kills</span>
                <span class="col-stat">@e.Deaths</span>
                <span class="col-stat">@e.KdStr</span>
                <span class="col-stat">@e.Score</span>
            </div>
        }
    </div>

    @* ── XP SECTION ──────────────────────────────────────────────── *@
    <div class="eom-xp-section">
        <div class="eom-xp-info-row">
            <label class="eom-xp-earned">+@XpEarned XP</label>
            @if ( WonMatch )
            {
                <label class="eom-win-bonus">@Tr( "WIN BONUS INCLUDED" )</label>
            }
            @if ( LeveledUp )
            {
                <label class="eom-level-up-badge">@Tr( "LEVEL UP!" )</label>
            }
        </div>
        <div class="eom-bar-row">
            <label class="eom-lv-label">@Tr( "LV {0}", LevelBefore )</label>
            <div class="eom-level-bar">
                @* Already-earned portion *@
                <div class="eom-bar-old" style="width: @(ProgressBefore * 100f)%;"></div>
                @* Newly-earned portion (capped at end of bar on level-up) *@
                @if ( LeveledUp )
                {
                    <div class="eom-bar-new" style="width: @((1f - ProgressBefore) * 100f)%;"></div>
                }
                else
                {
                    <div class="eom-bar-new" style="width: @(MathF.Max( 0f, ProgressAfter - ProgressBefore ) * 100f)%;"></div>
                }
            </div>
            <label class="eom-lv-label">@Tr( "LV {0}", LeveledUp ? Progression.GetLevel() : LevelBefore )</label>
        </div>
    </div>

    @if ( GameMode.Instance?.IsRanked == true )
    {
        <div class="eom-ranked-result">
            <img class="eom-rank-emblem" src=@Rank.GetEmblem( Rank.GetTierIndex() ) />
            <div class="eom-rank-copy">
                <label class="eom-rank-heading">@Tr( Rank.IsPlaced ? "RANKED RESULT" : "PLACEMENT COMPLETE" )</label>
                <label class="eom-rank-name" style="color: @Rank.GetTierColor();">@Rank.Translate( Rank.GetRankName().ToUpper() )</label>
                <label class="eom-rank-progress">@(Rank.IsPlaced ? Tr( "{0:0.#}% THROUGH RANK", Rank.GetDivisionProgress() * 100f ) : Tr( "{0} / {1} PLACEMENT MATCHES", Rank.PlacementsCompleted, Rank.PlacementMatches ))</label>
            </div>
            <label class="eom-rank-return">@Tr( "RETURNING TO RANKED" )</label>
        </div>
    }

    @* ── FOOTER ───────────────────────────────────────────────────── *@
    <div class="eom-footer">
        @if ( CanPlayAgain )
        {
            @if ( _startError is not null )
            {
                <label class="eom-footer-note">@Tr( _startError )</label>
            }
            <div class="eom-leave-btn @(_starting ? "disabled" : "")" @onclick=@LeaveGame>
                <label>@Tr( "LEAVE GAME" )</label>
            </div>
            <div class="eom-continue-btn pad-first @(_starting ? "disabled" : "")" @onclick=@PlayAgain>
                <label>@(_starting ? Tr( "STARTING…" ) : Tr( "PLAY AGAIN" ))</label>
            </div>
        }
        else
        {
            <div class="eom-continue-btn pad-first" @onclick=@Dismiss>
                <label>@Tr( "CONTINUE" )</label>
            </div>
        }
        <label class="eom-timer-label">@SecondsLeft<span class="eom-timer-s">s</span></label>
    </div>

</root>

@code
{
    // ── Static entry-point ──────────────────────────────────────────

    private static EndOfMatchScreen Instance { get; set; }
    public static bool IsAnyVisible => Instance is not null && Instance.IsVisible;

    /// <summary>
    /// Broadcast from the host to show the end-of-match screen on all clients.
    /// <paramref name="winningTeam"/> is <see cref="Team.Unassigned"/> for a draw
    /// or a free-for-all mode where team scoring isn't used.
    /// </summary>
    [Rpc.Broadcast( NetFlags.HostOnly )]
    public static void Show( Team winningTeam )
    {
        if ( !Instance.IsValid() ) return;
        Instance.DoShow( winningTeam );
    }

    // ── State ───────────────────────────────────────────────────────

    private bool IsVisible { get; set; }
    private Team WinningTeam { get; set; }

    private RealTimeSince TimeSinceShown;
    private const float AutoDismissTime = 15f;

    private bool XpAwarded;
    private int XpEarned;
    private int LevelBefore;
    private float ProgressBefore;
    private float ProgressAfter;
    private bool LeveledUp;

    private int _lastSecondsLeft = -1;

    private const int WinBonusXp    = 200;
    private const int MatchBonusXp  =  50;
    private const int MaxMatchXp    = 2000;

    // ── Derived helpers ────���────────────────────────────────────────

    private TeamScoring TeamScoring => GameMode.Instance?.Get<TeamScoring>();
    private Team LocalTeam => Client.Local?.Team ?? Team.Unassigned;
    // Battle royale has no teams: you win by being the last one standing, and otherwise it's your placing.
    private static BattleRoyaleMatch Royale => GameUtils.IsBattleRoyale ? BattleRoyaleMatch.Current : null;
    private bool WonMatch  => Royale is { } royale ? royale.LocalPlayerWon : WinningTeam != Team.Unassigned && WinningTeam == LocalTeam;
    private bool IsDraw    => Royale is not null ? !WonMatch : WinningTeam == Team.Unassigned;

    private string ResultClass => WonMatch ? "victory" : IsDraw ? "draw" : "defeat";
    // In the player's language. "{0} PLACE" is given the English ordinal ("2ND") and the bare number, which the other
    // languages write their own ordinal with ("{1}. Platz").
    private string ResultText  => WonMatch ? Tr( "VICTORY" ) : Royale is { LocalPlacement: > 0 } placed
        ? Tr( "{0} PLACE", BattleRoyaleHud.Ordinal( placed.LocalPlacement ), placed.LocalPlacement ) : Tr( IsDraw ? "MATCH OVER" : "DEFEAT" );
    private int    SecondsLeft => Math.Max( 0, (int)MathF.Ceiling( AutoDismissTime - TimeSinceShown ) );

    // ── Player-entry list ───────────────────────────────────────────

    private class EomEntry
    {
        public string Name    { get; init; }
        public int    Kills   { get; init; }
        public int    Deaths  { get; init; }
        public int    Score   { get; init; }
        public bool   IsLocal { get; init; }
        public bool   IsMvp   { get; set; }
        public string KdStr   => $"{(float)Kills / MathF.Max( 1f, Deaths ):0.00}";
    }

    private List<EomEntry> SortedEntries
    {
        get
        {
            var list = new List<EomEntry>();

            foreach ( var client in GameUtils.AllPlayers )
            {
                var ps = client.GetComponent<PlayerScore>();
                list.Add( new EomEntry
                {
                    Name    = client.DisplayName,
                    Kills   = ps?.Kills  ?? 0,
                    Deaths  = ps?.Deaths ?? 0,
                    Score   = ps?.Score  ?? 0,
                    IsLocal = client == Client.Local,
                } );
            }

            // Battle royale's bots are everyone for themselves, so they have no team.
            foreach ( var bot in GameUtils.LightweightBots.Where( b => b.IsValid() && (b.Team != Team.Unassigned || Royale is not null) ) )
            {
                list.Add( new EomEntry
                {
                    Name   = $"BOT {bot.BotName}",
                    Kills  = bot.Kills,
                    Deaths = bot.Deaths,
                    Score  = bot.Score,
                } );
            }

            var sorted = list.OrderByDescending( e => e.Score ).ToList();
            if ( sorted.Count > 0 )
                sorted[0].IsMvp = true;

            // A battle royale's field is dozens: the top ten, and you.
            if ( Royale is not null && sorted.Count > 10 )
                sorted = sorted.Take( 10 ).Concat( sorted.Skip( 10 ).Where( e => e.IsLocal ) ).ToList();

            return sorted;
        }
    }

    // ── Lifecycle ───────────────────────────────────────────────────

    public EndOfMatchScreen()
    {
        Instance = this;
    }

    private void DoShow( Team winningTeam )
    {
        WinningTeam  = winningTeam;
        IsVisible    = true;
        TimeSinceShown = 0;
        XpAwarded    = false;
        _starting    = false;
        _startError  = null;

        AwardXp();
        StateHasChanged();
    }

    private void AwardXp()
    {
        if ( XpAwarded ) return;
        XpAwarded = true;

        var localClient = Client.Local;
        if ( !localClient.IsValid() ) return;

        var ps    = localClient.GetComponent<PlayerScore>();
        var score = ps?.Score ?? 0;

        LevelBefore   = Progression.GetLevel();
        ProgressBefore = Progression.GetLevelProgress();

        XpEarned = Math.Min( score * 2 + MatchBonusXp + (WonMatch ? WinBonusXp : 0), MaxMatchXp );
        Progression.AddXP( XpEarned );

        LeveledUp    = Progression.GetLevel() > LevelBefore;
        ProgressAfter = Progression.GetLevelProgress();

        DailyChallenges.OnMatchFinished( WonMatch );
    }

    private void Dismiss()
    {
        IsVisible = false;
        StateHasChanged();
    }

    // ── Play again ──────────────────────────────────────────────────

    /// <summary>
    /// A match that ends by sending everyone back to the menu (KillGameOnEnd: battle royale) offers the same mode on the
    /// same map again. A map vote has its own choices, and a ranked match goes back to Ranked by itself.
    /// </summary>
    private static KillGameOnEnd MenuOnEnd => GameMode.Instance is { IsRanked: false } mode ? mode.Get<KillGameOnEnd>() : null;

    private bool CanPlayAgain => _starting || MenuOnEnd is not null;

    /// <summary>Set while the lobby closes and the new match's map loads.</summary>
    private bool _starting;

    /// <summary>Why the last try failed, in English (translated where it's drawn).</summary>
    private string _startError;

    /// <summary>
    /// Leaves this match's lobby and starts the same mode on the same map in one of the player's own, as the map vote's
    /// mode cards do (MatchLauncher.LeaveAndStart). Meanwhile KillGameOnEnd.IsLeaving stops the match sending this
    /// machine to the menu over it.
    /// </summary>
    private async void PlayAgain()
    {
        if ( _starting ) return;

        var mode = MatchLauncher.ModeOf( GameMode.Instance );
        var map = Game.ActiveScene?.Source as SceneFile ?? (Royale is not null ? BattleRoyaleMatch.GetChosenMap() : null);
        if ( !mode.IsValid() || map is null )
        {
            _startError = "Something went wrong";
            StateHasChanged();
            return;
        }

        var menuOnEnd = MenuOnEnd;
        Sound.Play( "ui_button_press" );
        _starting = true;
        _startError = null;
        if ( menuOnEnd.IsValid() ) menuOnEnd.IsLeaving = true;
        StateHasChanged();

        if ( await MatchLauncher.LeaveAndStart( mode, map ) || !IsValid ) return;

        // Still in the lobby: the match goes back to the menu as before.
        _starting = false;
        _startError = "Couldn't leave this lobby. Try again.";
        if ( menuOnEnd.IsValid() ) menuOnEnd.IsLeaving = false;
        StateHasChanged();
    }

    private void LeaveGame()
    {
        if ( _starting ) return;

        Sound.Play( "ui_button_press" );
        GameUtils.ReturnToMainMenu();
    }

    // ── Pad (PadNavigation) ──────────────────────────────────────
    // The pad starts on CONTINUE or PLAY AGAIN; B continues, where there's nothing to start.
    public Panel PadFirstFocus => null;

    public bool PadBack()
    {
        if ( CanPlayAgain ) return false;

        Sound.Play( "ui_button_press" );
        Dismiss();
        return true;
    }

    public bool PadTab( int direction ) => false;

    public override void Tick()
    {
        if ( !IsVisible ) return;
        PadNavigation.Offer( this, this );

        // The map vote runs for the same 15s this screen does, so without this the two sit on top of
        // each other for the whole window and the vote can be neither read nor clicked.
        if ( Facepunch.MapVoteSystem.Instance.IsValid() )
        {
            Dismiss();
            return;
        }

        // Stays up while the next match starts: it's the only sign anything is happening.
        if ( TimeSinceShown >= AutoDismissTime && !_starting )
        {
            Dismiss();
            return;
        }

        // Only re-render once per second (for the countdown label).
        var secs = SecondsLeft;
        if ( secs != _lastSecondsLeft )
        {
            _lastSecondsLeft = secs;
            StateHasChanged();
        }
    }
}
