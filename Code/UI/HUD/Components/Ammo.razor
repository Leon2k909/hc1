@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

@if ( !Player.IsValid() )
    return;

@if ( !Player.CurrentEquipment.IsValid() )
    return;

@* Bottom right, straight on the world with no plate. On top, the lethal and tactical equipment carried, with their
   counts and keys. Then the weapon's name and fire mode beside the magazine's rounds (the chambered round raised) over
   the reserve, split by an orange rule, and a thin bar for the magazine. A knife or grenade shows its name alone. *@
<root>
    @if ( Carried.Count > 0 )
    {
        <div class="gear">
            @foreach ( var item in Carried )
            {
                <div class="gear-item @(item.InHand ? "in-hand" : "")">
                    @if ( !string.IsNullOrEmpty( item.Resource.Icon ) )
                    {
                        <div class="gear-icon"><div class="gear-image" style="background-image:url(@item.Resource.Icon);" /></div>
                    }
                    @if ( item.Count > 1 )
                    {
                        <label class="gear-count">@($"×{item.Count}")</label>
                    }
                    <InputHint Action="@($"Slot{(int)item.Resource.Slot}")" class="small" Size="@InputGlyphSize.Small" />
                </div>
            }
        </div>
    }

    <div class="readout">
        <div class="about">
            <label class="weapon-name">@Player.CurrentEquipment.Resource.Name</label>
            @if ( Shoot.IsValid() && HasAmmo is not null )
            {
                <div class="firemode">
                    <Icon File=@FireModeFile Size="@(14)" class="mode-icon" />
                    <label class="mode-name">@Tr( FireModeKey )</label>
                    @if ( Shoot.FireModes.Count > 1 )
                    {
                        <InputHint Action="FireMode" class="small" Size="@InputGlyphSize.Small" />
                    }
                </div>
            }
        </div>

        @if ( HasAmmo is { } ammo )
        {
            <div class="rule" />
            <div class="counts">
                <div class="mag-line">
                    <label class="mag">@ammo.AmmoInMagazine</label>
                    @if ( ammo.ChamberedRounds > 0 )
                    {
                        <label class="chamber">+@ammo.ChamberedRounds</label>
                    }
                </div>
                <label class="reserve">@ammo.ReserveAmmo</label>
            </div>
        }
    </div>

    @if ( HasAmmo is not null )
    {
        <div class="mag-bar"><div class="fill" style="width: @(MagPercent)%;" /></div>
    }
</root>

@code
{
    /// <summary>
    /// The player's inventory
    /// </summary>
    public PlayerInventory Inventory => Player.Inventory;

    /// The player
    public PlayerPawn Player => Client.Viewer.PlayerPawn;

    private Equipment _ammoOf;
    private WeaponAmmo _ammo;

    /// The weapon in hand's ammo, looked up once per weapon: Tick and BuildHash ask for it several times a frame.
    private WeaponAmmo HasAmmo
    {
        get
        {
            var equipment = Player?.CurrentEquipment;
            if ( equipment != _ammoOf || (_ammo is not null && !_ammo.IsValid()) )
            {
                _ammoOf = equipment;
                _ammo = equipment?.Components?.Get<WeaponAmmo>( FindMode.EverythingInSelfAndDescendants );
            }

            return _ammo;
        }
    }

    // A class, not a record: s&box's codegen has failed on records.
    private sealed class GearItem
    {
        public EquipmentResource Resource;
        public int Count;
        public bool InHand;
    }

    /// The lethal, then tactical, equipment carried: each grenade is its own Equipment, so a kind's count is how many
    /// there are.
    private List<GearItem> Carried
    {
        get
        {
            var list = new List<GearItem>();
            if ( !Player.IsValid() || Inventory is null )
                return list;

            var current = Player.CurrentEquipment;
            foreach ( var slot in GearSlots )
            {
                foreach ( var group in Inventory.Equipment.Where( x => x.IsValid() && x.Resource is not null && x.Resource.Slot == slot )
                             .GroupBy( x => x.Resource ) )
                {
                    list.Add( new GearItem { Resource = group.Key, Count = group.Count(), InHand = current.IsValid() && current.Resource == group.Key } );
                }
            }

            return list;
        }
    }

    private static readonly EquipmentSlot[] GearSlots = { EquipmentSlot.Lethal, EquipmentSlot.Tactical };

    private float MagFraction
    {
        get
        {
            var ammo = HasAmmo;
            if ( ammo is null ) return 1f;
            var max = ammo.GetEffectiveMaxAmmo();
            return max > 0 ? Math.Clamp( ammo.AmmoInMagazine / (float)max, 0f, 1f ) : 1f;
        }
    }

    private int MagPercent => (int)Math.Round( MagFraction * 100f );

    /// "empty" with nothing left to fire, "low" at a quarter of a magazine or less.
    private string AmmoState
    {
        get
        {
            var ammo = HasAmmo;
            if ( ammo is null ) return "no-ammo";
            if ( ammo.Ammo <= 0 ) return "empty";
            return MagFraction <= 0.25f ? "low" : "";
        }
    }

    public Shootable Shoot => Player.CurrentEquipment.IsValid() ? Player.CurrentEquipment.Components.Get<Shootable>( FindMode.EnabledInSelfAndDescendants ) : null;

    private string FireModeFile
    {
        get
        {
            if ( !Shoot.IsValid() ) return null;

            return $"ui/firemode/{Shoot.CurrentFireMode.ToString().ToLowerInvariant()}.png";
        }
    }

    // The gunsmith's names for the modes. Built outside the Tr call, which check_translations.py reads its first string
    // literal from.
    private string FireModeKey => !Shoot.IsValid() ? "" : Shoot.CurrentFireMode switch
    {
        FireMode.Automatic => "FULL-AUTO",
        FireMode.Burst => "BURST",
        _ => "SEMI-AUTO",
    };

    // The state's class is set here: a <root class="@(...)"> adds a class but doesn't take it off again.
    public override void Tick()
    {
        base.Tick();
        var state = Player.IsValid() && Player.CurrentEquipment.IsValid() ? AmmoState : "";
        SetClass( "no-ammo", state == "no-ammo" );
        SetClass( "empty", state == "empty" );
        SetClass( "low", state == "low" );
    }

    protected override int BuildHash()
    {
        if ( !Player.IsValid() || !Player.CurrentEquipment.IsValid() )
            return 0;
        var ammo = HasAmmo;
        return HashCode.Combine( Player, ammo?.Ammo, ammo?.ReserveAmmo, ammo?.GetEffectiveMaxAmmo(), Player?.CurrentEquipment,
                                 FireModeFile, AmmoState, GearHash() );
    }

    /// The lethal and tactical equipment carried, in order, and which kind is in hand: everything Carried groups,
    /// without grouping it.
    private int GearHash()
    {
        var hash = new HashCode();
        if ( Inventory is null )
            return 0;

        var current = Player.CurrentEquipment;
        hash.Add( current.IsValid() ? current.Resource : null );
        foreach ( var equipment in Inventory.Equipment )
        {
            if ( equipment.IsValid() && equipment.Resource is { Slot: EquipmentSlot.Lethal or EquipmentSlot.Tactical } resource )
                hash.Add( resource );
        }

        return hash.ToHashCode();
    }
}
