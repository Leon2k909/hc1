@namespace Facepunch.UI
@attribute [StyleSheet]
@inherits Panel

@* Who's talking, one plate each like the kill feed's: their level, avatar, name and team, ending in their team's
   colour at the screen edge. You're on it too while your mic hears you, with who can hear you. The green square at
   the top right is s&box's own mic light (its MicOverlay), which it draws over every game. *@
<root>
    @foreach ( var row in Rows )
    {
        var teamColor = row.Team.GetColor().Hex;
        var logo = LogoPath( row );

        <div @key="row.Key" class="speaker @(row.IsLocal ? "is-me" : "") @(row.IsDead ? "dead" : "")">
            <VoiceMeter Voice=@row.Voice Steady=@(row.IsLocal || row.Voice is null) />
            <img class="avatar" src="avatar:@row.SteamId" style="border-color: @teamColor;" />

            <div class="who">
                <label class="name">@row.Name</label>
                <div class="tags">
                    @foreach ( var tag in Tags( row ) )
                    {
                        <div class="@tag.Class">
                            @if ( tag.Icon is not null )
                            {
                                <i>@tag.Icon</i>
                            }
                            <label style="@(tag.Color is null ? "" : $"color: {tag.Color};")">@tag.Text</label>
                        </div>
                    }
                </div>
            </div>

            @if ( !string.IsNullOrEmpty( logo ) )
            {
                <div class="logo" style="background-image: url( @logo );"></div>
            }

            <div class="edge" style="background-color: @teamColor;"></div>
        </div>
    }
</root>

@code
{
    /// <summary> How long a row stays after the voice stops, so the gaps between words don't flicker it. </summary>
    private const float Linger = 0.4f;

    /// <summary> dev_voices_sample: made-up rows to check the layout with, as well as anyone really talking. </summary>
    public static bool ShowSample { get; set; }

    /// <summary> Someone talking, and what the list says about them. </summary>
    private sealed record Row( Guid Key, string Name, ulong SteamId, Team Team, Voice Voice, bool IsLocal, bool IsSpectator,
        bool IsEnemy, bool IsSquadmate, bool IsDead );

    /// <summary> One of a row's labels: its text, CSS class, colour (a team's) and Material icon. </summary>
    private sealed record Tag( string Text, string Class, string Color = null, string Icon = null );

    /// <summary> Everyone talking, in the scene's order, so rows don't move when someone else starts. </summary>
    private List<Row> Rows
    {
        get
        {
            var rows = new List<Row>();

            foreach ( var voice in Scene.GetAllComponents<PlayerVoiceComponent>() )
            {
                var client = voice.Client.IsValid() ? voice.Client : voice.GetComponent<Client>();
                if ( !client.IsValid() || !client.IsConnected )
                    continue;

                var isLocal = client.IsLocalPlayer;
                if ( IsTalking( voice, client, isLocal ) )
                {
                    rows.Add( new Row( client.Id, client.DisplayName, client.SteamId, client.Team, voice, isLocal, IsSpectator( client ),
                        IsEnemy( client ), IsSquadmate( client ), IsDead( client ) ) );
                }
            }

            if ( ShowSample )
                rows.AddRange( SampleRows() );

            return rows;
        }
    }

    /// <summary> When your mic last heard you. </summary>
    private RealTimeSince _sinceHeardYou = 999f;

    private bool IsTalking( PlayerVoiceComponent voice, Client client, bool isLocal )
    {
        if ( isLocal )
        {
            // IsRecording is only whether the mic is open (all the time without push-to-talk), and your own voice never
            // plays here to set LastPlayed. Application.IsMicrophoneRecording is whether the mic actually hears you.
            if ( voice.IsRecording && Application.IsMicrophoneRecording )
                _sinceHeardYou = 0;

            return _sinceHeardYou < Linger;
        }

        // A muted player's voice isn't played (PlayerVoiceComponent.ShouldHearVoice); this also drops their row at once.
        return !CommunicationMuteState.IsVoiceMuted( client ) && voice.LastPlayed < Linger;
    }

    private IEnumerable<Tag> Tags( Row row )
    {
        if ( row.IsLocal )
        {
            yield return new Tag( Tr( "YOU" ), "chip me" );
            yield return new Tag( LocalScope, "scope", Icon: "hearing" );
        }
        else if ( row.IsSpectator )
        {
            yield return new Tag( Tr( "SPECTATOR" ), "team spectator" );
        }
        else if ( row.Team != Team.Unassigned )
        {
            yield return new Tag( Tr( row.Team.GetName().ToUpperInvariant() ), "team", row.Team.GetColor().Hex );

            if ( row.IsEnemy )
                yield return new Tag( Tr( "ENEMY" ), "chip" );
        }

        if ( row.IsSquadmate )
            yield return new Tag( Tr( "SQUAD" ), "chip squad" );

        if ( row.IsDead )
            yield return new Tag( Tr( "DEAD" ), "chip dead" );
    }

    /// <summary>
    /// Who hears you, by your Voice settings: TeamVoiceChatFilter's rules, which also send everything to spectators and
    /// to your killer for a moment (Death Comms). Everyone is unassigned in free-for-all, so Team Only reaches everyone.
    /// </summary>
    private string LocalScope
    {
        get
        {
            if ( !Scene.GetAllComponents<TeamVoiceChatFilter>().Any() )
                return Tr( "EVERYONE" );

            if ( GameSettingsSystem.Current.VoiceProximity )
                return Tr( "NEARBY" );

            return TeamVoiceChatFilter.ActiveMode switch
            {
                VoiceChatMode.TeamOnly when !GameUtils.IsFreeForAllMode => Tr( "TEAM ONLY" ),
                VoiceChatMode.PartyOnly => Tr( "PARTY ONLY" ),
                _ => Tr( "EVERYONE" ),
            };
        }
    }

    /// <summary> Watching a team game from neither team. </summary>
    private static bool IsSpectator( Client client ) => !GameUtils.IsFreeForAllMode && client.Team == Team.Unassigned;

    /// <summary> On the other team from you, which you hear through Global or Proximity Voice or Death Comms. </summary>
    private static bool IsEnemy( Client client )
    {
        var you = Client.Local;
        return you.IsValid() && you.Team != Team.Unassigned && client.Team != Team.Unassigned && !client.IsFriendly( you );
    }

    /// <summary> In your Steam party, the menus' squad (as the scoreboard marks them). </summary>
    private static bool IsSquadmate( Client client )
    {
        var connection = client.Connection;
        return !client.IsLocalPlayer && connection is not null && (PartyRoom.Current?.Members.Any( x => x.Id == connection.SteamId ) ?? false);
    }

    /// <summary> Their body lies where they died until they respawn, so a player with no pawn yet isn't dead. </summary>
    private static bool IsDead( Client client )
    {
        var pawn = client.PlayerPawn;
        return pawn.IsValid() && pawn.HealthComponent.IsValid() && pawn.HealthComponent.State == LifeState.Dead;
    }

    /// <summary> Their team's crest, the spectators' eye, or nothing in free-for-all. </summary>
    private static string LogoPath( Row row ) => row.IsSpectator ? "/ui/teams/spectator.png" : row.Team.GetIconPath();

    /// <summary>
    /// You, a squadmate on your team, a dead enemy with a long name and (in team modes) a spectator, all with your
    /// avatar. Outside a team you're on Red Team.
    /// </summary>
    private static IEnumerable<Row> SampleRows()
    {
        var you = Client.Local;
        var ffa = GameUtils.IsFreeForAllMode;
        var team = ffa ? Team.Unassigned : you.IsValid() && you.Team != Team.Unassigned ? you.Team : Team.Terrorist;
        var steamId = (ulong)Game.SteamId;

        yield return new Row( SampleKey( 1 ), you.IsValid() ? you.DisplayName : "You", steamId, team, null, true, false, false, false, false );
        yield return new Row( SampleKey( 2 ), "Sample Squadmate", steamId, team, null, false, false, false, true, false );
        yield return new Row( SampleKey( 3 ), "Sample Enemy With A Long Name", steamId, team.GetOpponents(), null, false, false, !ffa, false, true );

        if ( !ffa )
            yield return new Row( SampleKey( 4 ), "Sample Spectator", steamId, Team.Unassigned, null, false, true, false, false, false );
    }

    private static Guid SampleKey( int n ) => new( n, 0, 0, new byte[8] );

    // Made when first wanted: a hotload leaves a new field null on a list that's already up.
    private List<PlayerVoiceComponent> _voices;

    // The rows' fields as Rows would make them, without making them: this runs every frame, mostly with nobody talking.
    protected override int BuildHash()
    {
        var hash = new HashCode();
        var local = ShowSample;

        _voices ??= new();
        _voices.Clear();
        Scene.GetAll( _voices );
        foreach ( var voice in _voices )
        {
            var client = voice.Client.IsValid() ? voice.Client : voice.GetComponent<Client>();
            if ( !client.IsValid() || !client.IsConnected )
                continue;

            var isLocal = client.IsLocalPlayer;
            if ( !IsTalking( voice, client, isLocal ) )
                continue;

            hash.Add( client.Id );
            hash.Add( client.DisplayName );
            hash.Add( client.SteamId );
            hash.Add( client.Team );
            hash.Add( voice );
            hash.Add( isLocal );
            hash.Add( IsSpectator( client ) );
            hash.Add( IsEnemy( client ) );
            hash.Add( IsSquadmate( client ) );
            hash.Add( IsDead( client ) );
            local |= isLocal;
        }

        if ( ShowSample )
        {
            foreach ( var row in SampleRows() )
                hash.Add( row );
        }

        // Only your own row says who hears you.
        if ( local )
            hash.Add( LocalScope );

        return hash.ToHashCode();
    }
}
