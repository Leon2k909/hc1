@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

@if ( !Pawn.IsValid() || !HealthComponent.IsValid() ) return;

@* Bottom left: health's number and bar, armour's under it. The plate is darkest at the screen's edge and fades out
   towards the middle, and its edge takes health's state colour (Tick). *@
<root>
    <div class="plate">
        <div class="edge" />
        <div class="sheen" />

        <div class="health-row">
            <label class="value">@Health</label>
            <div class="bar-column">
                <div class="caption-row">
                    <Icon File="/ui/health.png" Size="@(12)" />
                    <label class="caption">@Tr( "HEALTH" )</label>
                </div>
                <div class="segments">
                    @for ( var k = 0; k < Segments; k++ )
                    {
                        <div class="seg"><div class="fill" style="width: @(SegmentFill( k ))%;" /></div>
                    }
                </div>
            </div>
        </div>

        @if ( ArmorComponent.IsValid() )
        {
            <div class="armor-row">
                <div class="armor-value">
                    <Icon File="/ui/armor.png" Size="@(13)" />
                    <label class="value-sm">@Armor</label>
                </div>
                <div class="armor-bar"><div class="fill" style="width: @(ArmorPercent)%;" /></div>
                @if ( HasHelmet )
                {
                    <div class="helmet" title="@Tr( "HELMET" )">
                        <Icon File="/ui/helmet.png" Size="@(14)" />
                    </div>
                }
            </div>
        }
    </div>
</root>

@code
{
    // The health bar's segments: 10 points each at the usual 100.
    private const int Segments = 10;

    public Pawn Pawn => Client.Viewer.Pawn;
    public HealthComponent HealthComponent => Pawn.HealthComponent;
    public ArmorComponent ArmorComponent => Pawn.GetComponent<ArmorComponent>();
    public int Health => HealthComponent?.Health.CeilToInt() ?? 0;
    public int Armor => ArmorComponent?.Armor.CeilToInt() ?? 0;
    public bool HasHelmet => ArmorComponent?.HasHelmet ?? false;

    private float HealthFraction => HealthComponent.IsValid() && HealthComponent.MaxHealth > 0
        ? Math.Clamp( HealthComponent.Health / HealthComponent.MaxHealth, 0f, 1f ) : 0f;

    private int ArmorPercent
    {
        get
        {
            var max = ArmorComponent.IsValid() ? ArmorComponent.MaxArmor : 0f;
            return max > 0 ? (int)Math.Round( Math.Clamp( ArmorComponent.Armor / max, 0f, 1f ) * 100f ) : 0;
        }
    }

    /// How full segment k is, 0 to 100.
    private int SegmentFill( int k )
    {
        var filled = HealthFraction * Segments - k;
        return (int)Math.Round( Math.Clamp( filled, 0f, 1f ) * 100f );
    }

    protected override int BuildHash()
    {
        return !Pawn.IsValid() ? 0 : HashCode.Combine( Health, Armor, HasHelmet, ArmorPercent, Pawn.HealthComponent?.State );
    }

    // The state's classes are set here: a <root class="@(...)"> adds a class but doesn't take it off again.
    public override void Tick()
    {
        base.Tick();
        var valid = Pawn.IsValid() && HealthComponent.IsValid();
        SetClass( "low-health", valid && HealthFraction < 0.3f );
        SetClass( "hurt", valid && HealthFraction >= 0.3f && HealthFraction < 0.6f );
        SetClass( "no-armor", valid && ( !ArmorComponent.IsValid() || Armor <= 0 ) );
    }
}
