@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

@if ( !Player.IsValid() ) return;

@* The loadout, right side. It shows only while the player is switching (a slot key, the wheel, a new weapon in hand
   or a pickup) and fades out ShowSeconds after (Tick sets "shown"). *@
<root class="hud">
    @foreach ( var slotGroup in Inventory.Equipment.OrderBy( x => x.Resource.Slot ).GroupBy( x => x.Resource.Slot ) )
    {
        <div class="slot @SlotClass( slotGroup.Key )">
            <div class="items">
                @* Each grenade is its own Equipment, so a kind carried twice is one row with its count. *@
                @foreach ( var kind in slotGroup.GroupBy( x => x.Resource ) )
                {
                    <EquipmentRow Equipment=@(Pick( kind )) Count=@(kind.Count()) />
                }
            </div>
            <div class="key">
                <InputHint Action="@($"Slot{SlotIndex( slotGroup.Key )}")" class="small" Size="@InputGlyphSize.Small" />
            </div>
            <div class="mark" />
        </div>
    }
</root>

@code
{
    /// How long the list stays up after the last switch.
    private const float ShowSeconds = 2.2f;

    public PlayerPawn Player => Client.Viewer?.PlayerPawn;
    public PlayerInventory Inventory => Player.Inventory;
    public Equipment CurrentEquipment => Player?.CurrentEquipment;

    private Equipment _lastEquipment;
    private int _lastCount = -1;
    private int _lastInventoryHash;
    private RealTimeSince _sinceSwitch = 999f;

    public string SlotClass( EquipmentSlot slot )
    {
        var wpn = CurrentEquipment;
        return wpn.IsValid() && wpn.Resource.Slot == slot ? "active" : "";
    }

    public int SlotIndex( EquipmentSlot slot ) => (int)slot;

    /// The one in hand if it's of this kind, so its row lights up.
    private Equipment Pick( IEnumerable<Equipment> kind )
    {
        var current = CurrentEquipment;
        foreach ( var equipment in kind )
        {
            if ( equipment == current )
                return equipment;
        }

        return kind.First();
    }

    public override void Tick()
    {
        base.Tick();

        if ( !Player.IsValid() )
        {
            SetClass( "shown", false );
            return;
        }

        var current = CurrentEquipment;
        var count = EquipmentCount();
        if ( current != _lastEquipment || count != _lastCount || _inventoryHash != _lastInventoryHash || SwitchPressed() )
            _sinceSwitch = 0f;

        _lastEquipment = current;
        _lastCount = count;
        _lastInventoryHash = _inventoryHash;
        SetClass( "shown", _sinceSwitch < ShowSeconds );
    }

    /// The inputs PlayerInventory switches with, so pressing the slot already in hand still brings the list up.
    private bool SwitchPressed()
    {
        if ( !Player.IsLocallyControlled )
            return false;

        if ( Input.MouseWheel.y != 0f && !Input.Keyboard.Down( "ALT" ) )
            return true;

        if ( Input.Pressed( "NextSlot" ) || Input.Pressed( "PrevSlot" ) )
            return true;

        foreach ( var action in SlotActions )
        {
            if ( Input.Pressed( action ) )
                return true;
        }

        return false;
    }

    /// The slot keys' input actions ("Slot1", ...), made once rather than every frame.
    private static readonly string[] SlotActions = Enum.GetValues<EquipmentSlot>()
        .Where( x => x != EquipmentSlot.Undefined )
        .Select( x => $"Slot{(int)x}" )
        .ToArray();

    private double _countedAt = double.NaN;
    private PlayerPawn _countedPlayer;
    private int _count;
    private int _inventoryHash;

    /// Snapshot the count and displayed equipment once per frame and viewed pawn for Tick and BuildHash.
    private int EquipmentCount()
    {
        var player = Player;
        if ( _countedAt != RealTime.NowDouble || _countedPlayer != player )
        {
            _countedAt = RealTime.NowDouble;
            _countedPlayer = player;
            _count = 0;
            var hash = new HashCode();
            foreach ( var equipment in Inventory?.Equipment ?? Enumerable.Empty<Equipment>() )
            {
                _count++;
                hash.Add( equipment );
                hash.Add( equipment.Resource );
                hash.Add( equipment.Resource?.Slot );
                hash.Add( equipment.Resource?.Name );
                hash.Add( equipment.Resource?.Icon );
            }
            _inventoryHash = hash.ToHashCode();
        }

        return _count;
    }

    protected override int BuildHash()
    {
        if ( !Player.IsValid() ) return 0;

        EquipmentCount();
        return HashCode.Combine( Player, _inventoryHash, CurrentEquipment );
    }
}
