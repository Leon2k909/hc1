@namespace Facepunch.UI
@inherits Panel

@* One kind of equipment in the loadout list (WeaponInfoComponent): its name, how many when more than one, then its
   picture. *@
<root>
    @if ( Equipment.IsValid() )
    {
        <label class="gunname">@Equipment.Resource.Name</label>
        @if ( Count > 1 )
        {
            <label class="count">@($"\u00d7{Count}")</label>
        }

        @if ( !string.IsNullOrEmpty( Equipment.Resource.Icon ) )
        {
            <div class="icon">
                <div class="image" style="background-image:url(@Equipment.Resource.Icon);" />
            </div>
        }
    }
</root>

@code
{
    /// <summary>
    ///  The equipment's slot
    /// </summary>
    public EquipmentSlot Slot => Equipment?.Resource.Slot ?? default;

    /// <summary>
    /// The player's equipment.
    /// </summary>
    public Equipment Equipment { get; set; }

    /// How many of its kind the player carries (each grenade is its own Equipment).
    public int Count { get; set; } = 1;

    public PlayerPawn Player => Equipment?.Owner;
    public bool IsActive => Player?.CurrentEquipment == Equipment;

    // Set here: a <root class="@(...)"> adds a class but doesn't take it off again, so a row could stay lit after a switch.
    public override void Tick()
    {
        base.Tick();
        SetClass( "is-active", IsActive );
    }

    protected override int BuildHash()
    {
        return HashCode.Combine( IsActive, Equipment, Count );
    }
}
