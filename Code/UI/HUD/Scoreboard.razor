@using System;
@using Sandbox.UI;

@namespace Facepunch.UI
@inherits Panel

@attribute [StyleSheet]

@if ( Scene is null || !IsActive || !GameMode.Instance.IsValid() || !Client.Local.IsValid() )
{
    return;
}

@{
    var groups = GroupedPlayers;
    var columns = IsZombies ? ZombiesColumns : IScore.Find( Client.Local ).Select( x => x.Attribute.Name ).ToArray();
    var splitRosters = !IsZombies && groups.Count( x => x.Team != Team.Unassigned ) == 2 && columns.Length <= 5;
    var teamScoring = GameMode.Instance.Get<TeamScoring>();
}

<root class="hidden scoreboard-root">
    <div class="scoreboard-panel">
        <div class="match-heading">
            <div class="match-identity">
                <label class="eyebrow">@Tr( "SCOREBOARD" )</label>
                <label class="match-title">@Tr( Name?.ToUpperInvariant() )</label>
            </div>
            <div class="match-state">
                @if ( !string.IsNullOrWhiteSpace( Status ) )
                {
                    <label class="match-status">@Tr( Status )</label>
                }
                @if ( RoundNumber is { } roundNumber && RoundLimit is { } roundLimit )
                {
                    <label class="match-round">@Tr( "ROUND {0} OF {1}", roundNumber, roundLimit )</label>
                }
            </div>
            @if ( Time is { } matchTime )
            {
                <div class="match-clock">
                    <i>schedule</i>
                    <label>@matchTime.ToString( @"m\:ss" )</label>
                </div>
            }
        </div>

        <div class="scoreboard-body">
            <div class="rosters @(splitRosters ? "split-rosters" : "single-roster")">
                @if ( IsZombies )
                {
                    var players = ZombiesPlayers;
                    <div class="team-roster coop-roster">
                        <div class="team-heading">
                            <i class="coop-icon">groups</i>
                            <div class="team-identity">
                                <label class="team-name">@Tr( "SQUAD" )</label>
                                <label class="team-count">@players.Count @Tr( "PLAYERS" )</label>
                            </div>
                        </div>
                        <ScoreboardColumns Columns=@columns />
                        @for ( int playerIndex = 0; playerIndex < players.Count; playerIndex++ )
                        {
                            var player = players[playerIndex];
                            <ScoreboardRow @key="player.Id" Client=@player Position=@(playerIndex + 1) Columns=@columns OnInspectPlayer=@((Action<Client>)InspectPlayer) />
                        }
                    </div>
                }
                else
                {
                    @foreach ( var group in groups.Where( x => x.Team != Team.Unassigned ) )
                    {
                        var team = group.Team;
                        <div class="team-roster">
                            <div class="team-heading" style="@GetTeamBannerStyle( team )">
                                <Icon class="team-logo" file="@team.GetIconPath()" size="48" />
                                <div class="team-identity">
                                    <label class="team-name">@Tr( team.GetName().ToUpperInvariant() )</label>
                                    <label class="team-count">@group.Entries.Count @Tr( "PLAYERS" )</label>
                                </div>
                                @if ( LightweightBotManager.CanManageBots )
                                {
                                    <button class="add-bot" onclick=@(() => AddBot( team )) tooltip=@(Tr( "Add Bot" ))>
                                        <i>person_add</i>
                                        <label>@Tr( "ADD BOT" )</label>
                                    </button>
                                }
                                @if ( teamScoring is not null )
                                {
                                    <label class="team-score">@teamScoring.GetFormattedScore( team )</label>
                                }
                            </div>

                            @if ( group.Entries.Count > 0 )
                            {
                                <ScoreboardColumns Columns=@columns />
                                @for ( int playerIndex = 0; playerIndex < group.Entries.Count; playerIndex++ )
                                {
                                    var player = group.Entries[playerIndex];
                                    <ScoreboardRow @key="player.Id" Client=@player.Client Bot=@player.Bot Position=@(playerIndex + 1) Columns=@columns OnInspectPlayer=@((Action<Client>)InspectPlayer) />
                                }
                            }
                            else
                            {
                                <div class="empty-team">
                                    <i>groups</i>
                                    <label>0 @Tr( "PLAYERS" )</label>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if ( !IsZombies && RoundLimit.HasValue && teamScoring is not null
                && GameMode.Instance.Get<RoundBasedTeamScoring>() is not null
                && GameMode.Instance.Get<TeamEarlyWinCondition>() is not null )
            {
                <div class="round-history"><GameOverview /></div>
            }

            @if ( !IsZombies )
            {
                @foreach ( var group in groups.Where( x => x.Team == Team.Unassigned ) )
                {
                    <div class="spectator-list">
                        <Icon file="/ui/teams/spectator.png" size="18" />
                        <label class="spectator-heading">@Tr( "SPECTATORS" )</label>
                        @foreach ( var entry in group.Entries )
                        {
                            var spectator = entry.Client;
                            <button class="spectator-name" onclick=@(() => InspectPlayer( spectator ))>@entry.DisplayName</button>
                        }
                    </div>
                }
            }
        </div>

        <div class="communications">
            <div class="voice-label"><i>headset_mic</i><label>@Tr( "VOICE CHANNEL:" )</label></div>
            <div class="voice-options">
                <button class="voice-option @(GameSettingsSystem.Current.VoiceChatMode == VoiceChatMode.Auto ? "selected" : "")" onclick=@(() => SetVoiceMode( VoiceChatMode.Auto ))>@Tr( "AUTO" )</button>
                <button class="voice-option @(GameSettingsSystem.Current.VoiceChatMode == VoiceChatMode.Global ? "selected" : "")" onclick=@(() => SetVoiceMode( VoiceChatMode.Global ))>@Tr( "LOBBY" )</button>
                <button class="voice-option @(GameSettingsSystem.Current.VoiceChatMode == VoiceChatMode.TeamOnly ? "selected" : "")" onclick=@(() => SetVoiceMode( VoiceChatMode.TeamOnly ))>@Tr( "TEAM" )</button>
                <button class="voice-option @(GameSettingsSystem.Current.VoiceChatMode == VoiceChatMode.PartyOnly ? "selected" : "")" onclick=@(() => SetVoiceMode( VoiceChatMode.PartyOnly ))>@Tr( "PARTY" )</button>
            </div>
            <button class="proximity-option @(GameSettingsSystem.Current.VoiceProximity ? "selected" : "")" onclick=@ToggleProximity>
                <i>@(GameSettingsSystem.Current.VoiceProximity ? "spatial_audio_off" : "spatial_audio")</i>
                <label>@Tr( "PROX CHAT" )</label>
            </button>
        </div>
        <div class="scoreboard-footer">
            <label class="sharing-hint">@Tr( "Click a player to copy their gun builds or crosshair." )</label>
            <div class="scoreboard-key">
                <InputHint Action="Score" Size=@InputGlyphSize.Small />
                <label>@Tr( "SCOREBOARD" )</label>
            </div>
        </div>
    </div>
    @if ( InspectedPlayer.IsValid() )
    {
        <ScoreboardPlayerDetails Client=@InspectedPlayer OnClosed=@ClosePlayerDetails />
    }
</root>

@code
{
    public string Status => GameMode.Instance?.DisplayedStatus;
    public string Name => GameMode.Instance?.DisplayTitle;
    public TimeSpan? Time => GameMode.Instance?.DisplayedTime;

    public int? RoundNumber => GameMode.Instance.IsValid() ? GameMode.Instance.Get<RoundCounter>()?.Round : null;
    public int? RoundLimit => GameMode.Instance.IsValid() ? GameMode.Instance.Get<RoundLimit>()?.MaxRounds : null;

    private IEnumerable<ScoreboardEntry> Entries => GameUtils.AllPlayers
        .Select( x => new ScoreboardEntry { Client = x } )
        .Concat( ScoreboardBots.Select( x => new ScoreboardEntry { Bot = x } ) );

    /// <summary>
    /// One row per bot. Each life is a new bot object and bodies stay around for a while, so a bot that has died has
    /// several: show the living one, or its latest body while it waits to respawn.
    /// </summary>
    private static IEnumerable<LightweightCombatBot> ScoreboardBots => GameUtils.LightweightBots
        .Where( x => x.IsValid() && x.Team != Team.Unassigned )
        .GroupBy( x => (x.Team, x.BotName) )
        .Select( x => x.OrderByDescending( bot => bot.IsAlive ).ThenByDescending( bot => bot.Deaths ).First() );

    /// <summary> Zombies is co-op, so its scoreboard is one list, with no team headings. </summary>
    public static bool IsZombies => ZombiesRoundSystem.Current.IsValid();

    /// <summary>
    /// Zombies' columns, in <see cref="ScoreboardRow"/>'s order: its points and zombie kills, since the multiplayer score
    /// never moves there.
    /// </summary>
    public static readonly string[] ZombiesColumns = { "Points", "Kills" };

    /// <summary> A player's zombies economy, on their pawn: none while they're dead, waiting for the next round. </summary>
    public static ZombiesPlayerEconomy GetZombiesEconomy( Client client ) =>
        client.IsValid() && client.PlayerPawn.IsValid() ? client.PlayerPawn.GetComponent<ZombiesPlayerEconomy>() : null;

    /// <summary> The players, most points first. </summary>
    private List<Client> ZombiesPlayers => GameUtils.AllPlayers
        .Where( x => x.IsValid() && !x.IsBot )
        .OrderByDescending( x => GetZombiesEconomy( x )?.Points ?? -1 )
        .ThenBy( x => x.DisplayName )
        .ToList();

    /// <summary> A team's banner: its colour, strong at the logo and fading toward its score. </summary>
    private static string GetTeamBannerStyle( Team team )
    {
        var color = team.GetColor();
        return $"background-image: linear-gradient( to right, {color.WithAlpha( 0.85f ).Hex}, {color.WithAlpha( 0.22f ).Hex} );";
    }

    private void AddBot( Team team )
    {
        LightweightBotManager.Instance?.AddBot( team );
        StateHasChanged();
    }

    /// <summary>
    /// Modes that score by team list both teams, even one with nobody on it: kicking every bot from a team used to
    /// take its heading off the scoreboard, and its Add Bot button with it.
    /// </summary>
    private static bool ListsBothTeams => GameMode.Instance.IsValid() && GameMode.Instance.Get<TeamScoring>() is not null;

    /// <summary> Each team's rows, best score first: the local player's team, then the other, then spectators. </summary>
    private List<(Team Team, List<ScoreboardEntry> Entries)> GroupedPlayers
    {
        get
        {
            var localTeam = Client.Local.IsValid() ? Client.Local.Team : Team.Unassigned;
            var groups = Entries
                .GroupBy( x => x.Team )
                .ToDictionary( x => x.Key, x => x.OrderByDescending( entry => entry.Score ).ThenBy( entry => entry.DisplayName ).ToList() );

            if ( ListsBothTeams )
            {
                groups.TryAdd( Team.Terrorist, new() );
                groups.TryAdd( Team.CounterTerrorist, new() );
            }

            return groups
                .OrderBy( x => GetTeamSort( x.Key, localTeam ) )
                .ThenBy( x => x.Key )
                .Select( x => (x.Key, x.Value) )
                .ToList();
        }
    }

    private int GetTeamSort( Team team, Team localTeam )
    {
        if ( team == localTeam ) return 0;
        if ( team == Team.Unassigned ) return 2;
        return 1;
    }

    public bool IsActive { get; set; }
    private Client InspectedPlayer { get; set; }

    private void InspectPlayer( Client player )
    {
        if ( !player.IsValid() || player.IsBot ) return;
        InspectedPlayer = player;
        StateHasChanged();
    }

    private void ClosePlayerDetails()
    {
        InspectedPlayer = null;
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        if ( !IsActive || !Client.Local.IsValid() || !GameMode.Instance.IsValid() ) return 0;

        var hash = new HashCode();

        hash.Add( IsActive );
        hash.Add( InspectedPlayer );
        hash.Add( Name );
        hash.Add( Status );
        // Only rebuild when the displayed second changes, not on every frame while Score is held.
        hash.Add( Time is { } displayedTime ? (long)displayedTime.TotalSeconds : -1L );
        hash.Add( RoundNumber );
        hash.Add( RoundLimit );
        hash.Add( CommunicationMuteState.Version );
        hash.Add( GameSettingsSystem.Current.VoiceChatMode );
        hash.Add( GameSettingsSystem.Current.VoiceProximity );
        hash.Add( LightweightBotManager.CanManageBots );
        hash.Add( IsZombies );
        hash.Add( Client.Local.Team );

        if ( IsZombies )
        {
            // The rows are in points order.
            foreach ( var player in ZombiesPlayers )
            {
                hash.Add( player.Id );
                hash.Add( player.DisplayName );
                hash.Add( GetZombiesEconomy( player )?.Points );
            }

            return hash.ToHashCode();
        }

        foreach ( var column in IScore.Find( Client.Local ) ) hash.Add( column.Attribute.Name );

        var scoring = GameMode.Instance.Get<TeamScoring>();
        foreach ( var team in GroupedPlayers )
        {
            hash.Add( team.Team );
            hash.Add( scoring?.GetFormattedScore( team.Team ) );

            foreach ( var player in team.Entries )
            {
                hash.Add( player.Id );
                hash.Add( player.DisplayName );
                hash.Add( player.Score );
                hash.Add( player.Kills );
                hash.Add( player.Deaths );
            }
        }

        return hash.ToHashCode();
    }

    public override void Tick()
    {
        IsActive = Input.Down( "Score" );
        if ( !IsActive || !InspectedPlayer.IsValid() ) InspectedPlayer = null;
        SetClass( "visible", IsActive );
        ResponsiveLayout.Update( this );
    }

    private void SetVoiceMode( VoiceChatMode mode )
    {
        GameSettingsSystem.Current.VoiceChatMode = mode;
        GameSettingsSystem.Save();
        StateHasChanged();
    }

    private void ToggleProximity()
    {
        GameSettingsSystem.Current.VoiceProximity = !GameSettingsSystem.Current.VoiceProximity;
        GameSettingsSystem.Save();
        StateHasChanged();
    }

    private sealed class ScoreboardEntry
    {
        public Client Client { get; init; }
        public LightweightCombatBot Bot { get; init; }

        public bool IsBot => Bot.IsValid();
        public Team Team => IsBot ? Bot.Team : Client.Team;
        public string DisplayName => IsBot ? $"BOT {Bot.BotName}" : Client.DisplayName;
        public int Score => IsBot ? Bot.Score : Client.GetComponent<PlayerScore>()?.Score ?? 0;
        public int Kills => IsBot ? Bot.Kills : Client.GetComponent<PlayerScore>()?.Kills ?? 0;
        public int Deaths => IsBot ? Bot.Deaths : Client.GetComponent<PlayerScore>()?.Deaths ?? 0;
        public int Id => IsBot ? Bot.Id.GetHashCode() : Client.Id.GetHashCode();
    }
}
