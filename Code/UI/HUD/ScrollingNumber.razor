@namespace Facepunch.UI
@inherits Panel

<root>
    <label class="important">@SmoothValue.CeilToInt()</label>
</root>

@code
{
    public float SmoothValue { get; set; } = 0f;
    public int Value { get; set; } = 0;
    public float Speed = 50f;

    public override void Tick()
    {
        // Large awards must catch up before the score feed expires. Clearing the feed
        // also clears the animation, so a new streak starts from its own score.
        var rate = MathF.Max( Speed, MathF.Abs( Value - SmoothValue ) * 12f );
        SmoothValue = Value == 0 ? 0f : SmoothValue.Approach( (float)Value, rate * Time.Delta );
    }

    protected override int BuildHash()
    {
        return HashCode.Combine( SmoothValue.CeilToInt() );
    }
}
