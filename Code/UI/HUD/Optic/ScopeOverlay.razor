@namespace Facepunch.UI
@inherits Panel

@*
    MW2022-style picture-in-picture lens. The gun and optic housing stay visible; this draws the magnified
    view (OpticZoom.LensTexture) over the optic's glass, with the reticle, edge darkening and a thin rim.
*@

<root style="opacity: @(OpticZoom.ReflexSightVisible ? 1f : Alpha)">
    @if (OpticZoom.ReflexSightVisible)
    {
        <div class="reflex-dot dot"></div>
    }
    <div class="mount" style="left: @(OffsetX)%; top: @(OffsetY)%; opacity: @(OpticZoom.ReflexSightVisible ? 0f : 1f);">
        <div class="lens" @ref="Lens" style="width: @(LensWidthPercent)%; height: @(LensHeightPercent)%;">
            <MarkerSystem ScopeView="@(true)" />
            @if (OpticZoom.OverlayDotVisible)
            {
                <div class="dot"></div>
            }
            <ScopeShadow class="eye-shadow" />
        </div>
    </div>
</root>

@code
{
    /// <summary>Lens diameter as a fraction of screen height, matched to the optic's glass at the aim position.</summary>
    float Diameter => OpticZoom.LensDiameter;

    Panel Lens { get; set; }
    Texture _bound;

    // Fade only as the optic reaches/leaves the eye. Misalignment inside a raised scope is opaque black shadow.
    float Alpha => MathF.Round( OpticZoom.LensVisibility, 3 );

    float LensHeightPercent => MathF.Round( Diameter * OpticZoom.LensScale * 100f, 2 );
    float LensWidthPercent => MathF.Round( Diameter * OpticZoom.LensScale * 100f * Screen.Height / Screen.Width, 2 );

    float OffsetX => MathF.Round( OpticZoom.ScopeOffset.x * 100f * Screen.Height / Screen.Width, 2 );
    float OffsetY => MathF.Round( OpticZoom.ScopeOffset.y * 100f, 2 );

    public override void Tick()
    {
        var texture = OpticZoom.LensTexture;
        SetClass( "hidden", !OpticZoom.ReflexSightVisible && (Alpha <= 0f || texture is null) );

        if ( Lens is not null && texture != _bound )
        {
            _bound = texture;
            Lens.Style.SetBackgroundImage( texture );
        }
    }

    protected override int BuildHash() => HashCode.Combine( Alpha, LensWidthPercent, LensHeightPercent, OffsetX, OffsetY, OpticZoom.OverlayDotVisible, OpticZoom.ReflexSightVisible );
}
