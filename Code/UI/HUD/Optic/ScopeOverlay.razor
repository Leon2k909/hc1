@namespace Facepunch.UI
@inherits Panel

@*
    MW2022-style picture-in-picture lens. The gun and optic housing stay visible; this draws the magnified
    view (OpticZoom.LensTexture) over the optic's glass, with the reticle, edge darkening and a thin rim.
*@

@* The opacity, the mount's place and the lens's size follow the sway every frame: Tick sets them, so only the dots rebuild this. *@
<root>
    @if (OpticZoom.ReflexSightVisible)
    {
        <div class="reflex-dot dot"></div>
    }
    <div class="mount" @ref="Mount">
        <div class="lens" @ref="Lens">
            <MarkerSystem ScopeView="@(true)" />
            @if (OpticZoom.OverlayDotVisible)
            {
                <div class="dot"></div>
            }
            <ScopeShadow class="eye-shadow" />
        </div>
    </div>
</root>

@code
{
    /// <summary>Lens diameter as a fraction of screen height, matched to the optic's glass at the aim position.</summary>
    float Diameter => OpticZoom.LensDiameter;

    Panel Mount { get; set; }
    Panel Lens { get; set; }
    Texture _bound;

    // What was last set, so a steady scope doesn't restyle every frame.
    float _opacity = float.NaN, _mountOpacity = float.NaN;
    Vector2 _offset = new( float.NaN ), _size = new( float.NaN );

    // Fade only as the optic reaches/leaves the eye. Misalignment inside a raised scope is opaque black shadow.
    float Alpha => MathF.Round( OpticZoom.LensVisibility, 3 );

    float LensHeightPercent => MathF.Round( Diameter * OpticZoom.LensScale * 100f, 2 );
    float LensWidthPercent => MathF.Round( Diameter * OpticZoom.LensScale * 100f * Screen.Height / Screen.Width, 2 );

    float OffsetX => MathF.Round( OpticZoom.ScopeOffset.x * 100f * Screen.Height / Screen.Width, 2 );
    float OffsetY => MathF.Round( OpticZoom.ScopeOffset.y * 100f, 2 );

    public override void Tick()
    {
        var texture = OpticZoom.LensTexture;
        SetClass( "hidden", !OpticZoom.ReflexSightVisible && (Alpha <= 0f || texture is null) );

        if ( Lens is not null && texture != _bound )
        {
            _bound = texture;
            Lens.Style.SetBackgroundImage( texture );
        }

        var reflex = OpticZoom.ReflexSightVisible;
        var opacity = reflex ? 1f : Alpha;
        if ( opacity != _opacity )
        {
            _opacity = opacity;
            Style.Opacity = opacity;
        }

        if ( Mount is not null )
        {
            var offset = new Vector2( OffsetX, OffsetY );
            if ( offset != _offset )
            {
                _offset = offset;
                Mount.Style.Left = Length.Percent( offset.x );
                Mount.Style.Top = Length.Percent( offset.y );
            }

            var mountOpacity = reflex ? 0f : 1f;
            if ( mountOpacity != _mountOpacity )
            {
                _mountOpacity = mountOpacity;
                Mount.Style.Opacity = mountOpacity;
            }
        }

        if ( Lens is not null )
        {
            var size = new Vector2( LensWidthPercent, LensHeightPercent );
            if ( size != _size )
            {
                _size = size;
                Lens.Style.Width = Length.Percent( size.x );
                Lens.Style.Height = Length.Percent( size.y );
            }
        }
    }

    // A rebuild can make new panels (a hotload does), which start unstyled.
    protected override void OnAfterTreeRender( bool firstTime )
    {
        _bound = null;
        _opacity = _mountOpacity = float.NaN;
        _offset = _size = new Vector2( float.NaN );
    }

    protected override int BuildHash() => HashCode.Combine( OpticZoom.OverlayDotVisible, OpticZoom.ReflexSightVisible );
}
