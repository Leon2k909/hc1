@using Facepunch.UI
@namespace Facepunch
@inherits Panel
@implements IPadScope

<root class="hc1">
    <div class="text">
        <label>@Text</label>
    </div>

    <div class="options">
        <a class="button standard pad-target" @ref="SubmitButton" onclick="@(() => OnSubmitButton())">
            <label>@ButtonLabel( SubmitText, "OK" )</label>
        </a>

        @* A notice passes no cancel text, and has only its OK. *@
        @if ( !string.IsNullOrEmpty( CancelText ) )
        {
            <a class="button standard pad-target" onclick="@(() => OnCancelButton())">
                <label>@ButtonLabel( CancelText, "Cancel" )</label>
            </a>
        }
    </div>
</root>

@code
{
    public string Text { get; set; }
    public string SubmitText { get; set; } = "OK";
    public string CancelText { get; set; } = "Cancel";

    public Action OnCancel { get; set; }
    public Action OnSubmit { get; set; }

    /// <summary>
    /// A button's label. The dialog's own defaults ("OK", "Cancel") show in the player's language; a label the caller
    /// passed is shown as given, since callers translate their own text.
    /// </summary>
    private static string ButtonLabel( string text, string byDefault ) => text == byDefault ? Tr( byDefault ) : text;

    private void OnCancelButton()
    {
        OnCancel?.Invoke();
        Delete();
    }

    private void OnSubmitButton()
    {
        OnSubmit?.Invoke();
        Delete();
    }

    // The pad (PadNavigation): over whatever it was opened on, starting on OK; B cancels, or dismisses a notice.
    private Panel SubmitButton { get; set; }

    public override void Tick()
    {
        base.Tick();
        PadNavigation.Offer( this, this, 100 );
    }

    public Panel PadFirstFocus => SubmitButton;

    public bool PadBack()
    {
        if ( string.IsNullOrEmpty( CancelText ) ) OnSubmitButton();
        else OnCancelButton();
        return true;
    }

    public bool PadTab( int direction ) => false;

    protected override int BuildHash()
    {
        return HashCode.Combine(Text, SubmitText, CancelText);
    }
}