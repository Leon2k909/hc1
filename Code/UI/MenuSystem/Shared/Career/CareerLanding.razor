@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@attribute [StyleSheet]
@namespace Facepunch.UI

<root class="hc1 progression-page">
    <MenuTopbar Title="CAREER RECORD" ParentTitle="PROFILE" ParentAction=@BackToBarracks BackAction=@BackToBarracks />
    <div class="progression-body">
        <div class="player-stats">
            <label class="section-title">@Tr( "FIELD STATISTICS" )</label>
            <CareerStat Name="Kills" Stat="kills" />
            <CareerStat Name="Headshot Kills" Stat="kills-headshots" />
            <CareerStat Name="Deaths" Stat="deaths" />
        </div>

        <div class="progression-content">
            <div class="career-heading">
                <label class="career-title">@Tr( "CAREER RECORD" )</label>
                <label class="career-subtitle">@Tr( "Your experience, milestones and performance in the field." )</label>
            </div>
            <div class="player-rank-card">
                <label class="rank-badge">@Progression.GetLevel()</label>
                <div class="rank-info">
                    <div class="rank-title">
                        @if ( Progression.GetPrestige() > 0 )
                        {
                            <img class="rank-prestige" src="/ui/prestige/prestige_@(Progression.GetPrestige())_readable.png" />
                            <label>@Tr( "PRESTIGE {0}", Progression.GetPrestige() )</label>
                            <label class="rank-separator">/</label>
                        }
                        <label>@Tr( "LEVEL {0}", Progression.GetLevel() )</label>
                    </div>
                    <div class="rank-xp-wrap">
                        <div class="rank-xp-fill" style="width: @((Progression.GetLevelProgress() * 100f).ToString("0.#"))%;" />
                    </div>
                    <label class="rank-xp-label">@RankProgressLabel</label>
                    @if ( Progression.GetLevel() >= Progression.MaxLevel && Progression.GetPrestige() < 10 )
                    {
                        <div class="prestige-action primary" onclick=@EnterPrestigeMode><label>@Tr( "ENTER PRESTIGE MODE" )</label></div>
                    }
                </div>
            </div>

            <div class="milestone-heading">
                <label class="section-title">@Tr( "SERVICE MILESTONES" )</label>
                <label class="milestone-description">@Tr( "Each prestige resets your player level and weapon attachment unlocks. You keep your camos. Reach Prestige 10 for Master Prestige status." )</label>
            </div>
            <div class="prestige-grid">
                @for ( int i = 1; i <= 10; i++ )
                {
                    var isUnlocked = Progression.GetPrestige() >= i;
                    <div class="prestige-card @(isUnlocked ? "unlocked" : "locked")">
                        <img src="/ui/prestige/prestige_@(i)_readable.png" />
                        <label class="prestige-name">@Tr( "PRESTIGE {0}", i )</label>
                        <label class="prestige-status">@Tr( isUnlocked ? "REACHED" : "LOCKED" )</label>
                    </div>
                }
            </div>

            <label class="section-title">@Tr( "WEAPON RECORD" )</label>
            <div class="weapon-stats-grid">
                @foreach ( var equip in ResourceLibrary.GetAll<EquipmentResource>().Where( x => x.Slot == EquipmentSlot.Primary || x.Slot == EquipmentSlot.Secondary ) )
                {
                    <CareerWeapon Equipment=@equip />
                }
            </div>
        </div>
    </div>
</root>

@code
{
    private string RankProgressLabel => Progression.GetLevel() >= Progression.MaxLevel
        ? Tr( "MAXIMUM LEVEL REACHED" )
        : Tr( "{0} XP TO LEVEL {1}", Math.Max( 0, Progression.GetXPForNextLevel() - Progression.GetXPIntoLevel() ).ToString( "N0" ), Progression.GetLevel() + 1 );

    private void BackToBarracks() => this.Navigate( "/barracks" );
       
    public void OnNavigationOpen()
    {
        MainMenuRoot.Instance?.SetActiveRoute( "/barracks" );
        if ( MainMenuRoot.Instance.IsValid() )
            MainMenuRoot.Instance.SetBlur( true );
    }
    
    public void OnNavigationClose() 
    {
        if ( MainMenuRoot.Instance.IsValid() )
        {
            MainMenuRoot.Instance.SetBlur( false );
        }
    }

    void EnterPrestigeMode()
    {
        Progression.EnterPrestigeMode();
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        return HashCode.Combine( Progression.GetXP(), Progression.GetLevel(), Progression.GetPrestige() );
    }
}
