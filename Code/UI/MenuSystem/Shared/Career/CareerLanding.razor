@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@attribute [StyleSheet]
@namespace Facepunch.UI

<root class="hc1 progression-page">
    <MenuTopbar Title="CAREER RECORD" ParentTitle="PROFILE" ParentAction=@BackToBarracks BackAction=@BackToBarracks />
    <div class="progression-body">
        <div class="player-stats">
            <label class="section-title">@Tr( "FIELD STATISTICS" )</label>
            <CareerStat Name="Kills" Stat="kills" />
            <CareerStat Name="Headshot Kills" Stat="kills-headshots" />
            <CareerStat Name="Deaths" Stat="deaths" />
        </div>

        <div class="progression-content">
            <div class="career-heading">
                <label class="career-title">@Tr( "CAREER RECORD" )</label>
                <label class="career-subtitle">@Tr( "Your experience, milestones and performance in the field." )</label>
            </div>
            <div class="player-rank-card">
                <label class="rank-badge">@Progression.GetLevel()</label>
                <div class="rank-info">
                    <div class="rank-title">
                        @if ( Progression.GetPrestige() > 0 )
                        {
                            <img class="rank-prestige" src="/ui/prestige/prestige_@(Progression.GetPrestigeEmblem())_readable.png" />
                            <label>@Tr( "PRESTIGE {0}", Progression.GetPrestige() )</label>
                            <label class="rank-separator">/</label>
                        }
                        <label>@Tr( "LEVEL {0}", Progression.GetLevel() )</label>
                    </div>
                    <div class="rank-xp-wrap">
                        <div class="rank-xp-fill" style="width: @((Progression.GetLevelProgress() * 100f).ToString("0.#"))%;" />
                    </div>
                    <label class="rank-xp-label">@RankProgressLabel</label>
                    @if ( Progression.GetLevel() >= Progression.MaxLevel && Progression.GetPrestige() < 10 )
                    {
                        <div class="prestige-action primary" onclick=@EnterPrestigeMode><label>@Tr( "ENTER PRESTIGE MODE" )</label></div>
                    }
                </div>
            </div>

            <div class="milestone-heading">
                <label class="section-title">@Tr( "SERVICE MILESTONES" )</label>
                <label class="milestone-description">@Tr( "Each prestige resets your player level and weapon attachment unlocks. You keep your camos. Reach Prestige 10 for Master Prestige status." )</label>
                @if ( Progression.GetPrestige() > 1 )
                {
                    <label class="milestone-description">@Tr( "Pick any prestige you've reached to show its emblem." )</label>
                }
            </div>
            <div class="prestige-grid">
                @for ( int i = 1; i <= 10; i++ )
                {
                    var prestige = i;
                    var isUnlocked = Progression.GetPrestige() >= prestige;
                    var isEquipped = isUnlocked && Progression.GetPrestigeEmblem() == prestige;
                    <div class="prestige-card @(isUnlocked ? "unlocked" : "locked") @(isEquipped ? "equipped" : "")" onclick=@(() => PickEmblem( prestige ))>
                        <img src="/ui/prestige/prestige_@(prestige)_readable.png" />
                        <label class="prestige-name">@Tr( "PRESTIGE {0}", prestige )</label>
                        <label class="prestige-status">@Tr( isEquipped ? "EQUIPPED" : isUnlocked ? "REACHED" : "LOCKED" )</label>
                    </div>
                }
            </div>

            <div class="weapon-record">
                @{
                    var weapons = GetRecordWeapons();
                    var visibleWeapons = GetVisibleWeapons( weapons );
                }
                <div class="weapon-record-heading">
                    <label class="section-title">@Tr( "WEAPON RECORD" )</label>
                    <label class="weapon-record-count">@Tr( "{0} / {1} WEAPONS", visibleWeapons.Count, weapons.Count )</label>
                </div>
                <div class="weapon-categories">
                    <button class="weapon-category @(SelectedCategory is null ? "active" : "")" onclick=@(() => SelectCategory( null ))>
                        <label>@Tr( "ALL WEAPONS" )</label>
                        <label class="category-count">@weapons.Count</label>
                    </button>
                    @foreach ( var group in weapons.GroupBy( x => x.Category ).OrderBy( x => x.Key ) )
                    {
                        var category = group.Key;
                        <button class="weapon-category @(SelectedCategory == category ? "active" : "")" onclick=@(() => SelectCategory( category ))>
                            <label>@Tr( CategoryLabel( category ) )</label>
                            <label class="category-count">@group.Count()</label>
                        </button>
                    }
                </div>
                <div class="weapon-record-tools">
                    <div class="weapon-search">
                        <i>search</i>
                        <TextEntry class="weapon-search-entry" Value=@WeaponSearch OnTextEdited=@SetWeaponSearch Placeholder=@(Tr( "Search weapons" )) />
                    </div>
                    <div class="weapon-sort">
                        <label class="weapon-sort-label">@Tr( "SORT BY" )</label>
                        @foreach ( var sort in Enum.GetValues<WeaponRecordSort>() )
                        {
                            var option = sort;
                            <button class="weapon-sort-option @(SelectedSort == option ? "active" : "")" onclick=@(() => SelectSort( option ))>
                                <label>@Tr( SortLabel( option ) )</label>
                            </button>
                        }
                    </div>
                    @if ( HasWeaponFilters )
                    {
                        <button class="weapon-clear" onclick=@ClearWeaponFilters><i>close</i><label>@Tr( "CLEAR FILTERS" )</label></button>
                    }
                </div>
                @if ( visibleWeapons.Count == 0 )
                {
                    <div class="weapon-record-empty">
                        <i>search_off</i>
                        <label class="weapon-empty-title">@Tr( "No weapons match your filters." )</label>
                        <label>@Tr( "Try another name or category." )</label>
                    </div>
                }
                else
                {
                    <div class="weapon-stats-grid">
                        @foreach ( var equip in visibleWeapons )
                        {
                            <CareerWeapon @key="equip.ResourcePath" Equipment=@equip />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</root>

@code
{
    private enum WeaponRecordSort { Name, Kills, Level }

    private WeaponCategory? SelectedCategory { get; set; }
    private string WeaponSearch { get; set; } = "";
    private WeaponRecordSort SelectedSort { get; set; } = WeaponRecordSort.Name;
    private bool HasWeaponFilters => SelectedCategory.HasValue || !string.IsNullOrEmpty( WeaponSearch );

    private static List<EquipmentResource> GetRecordWeapons() => ResourceLibrary.GetAll<EquipmentResource>()
        .Where( x => x.Slot is EquipmentSlot.Primary or EquipmentSlot.Secondary ).ToList();

    private List<EquipmentResource> GetVisibleWeapons( List<EquipmentResource> weapons )
    {
        var query = NormalizeWeaponName( WeaponSearch );
        var matches = weapons.Where( x => (!SelectedCategory.HasValue || x.Category == SelectedCategory.Value)
            && NormalizeWeaponName( x.Name ).Contains( query, StringComparison.OrdinalIgnoreCase ) );

        var sorted = SelectedSort switch
        {
            WeaponRecordSort.Kills => matches.OrderByDescending( x => WeaponStats.Get( "kills", x ) ),
            // XP also orders progress within the same level.
            WeaponRecordSort.Level => matches.OrderByDescending( WeaponProgression.GetXP ),
            _ => matches.OrderBy( x => x.Name, StringComparer.OrdinalIgnoreCase )
        };

        return sorted.ThenBy( x => x.Name, StringComparer.OrdinalIgnoreCase ).ThenBy( x => x.ResourcePath ).ToList();
    }

    private static string NormalizeWeaponName( string name ) => new string( (name ?? "")
        .Where( char.IsLetterOrDigit ).ToArray() );

    private static string CategoryLabel( WeaponCategory category ) => category switch
    {
        WeaponCategory.AssaultRifle => "ASSAULT",
        WeaponCategory.Sniper => "SNIPER",
        WeaponCategory.Marksman => "MARKSMAN",
        WeaponCategory.None => "OTHER",
        _ => category.ToString().ToUpperInvariant()
    };

    private static string SortLabel( WeaponRecordSort sort ) => sort switch
    {
        WeaponRecordSort.Kills => "Kills",
        WeaponRecordSort.Level => "Level",
        _ => "Name"
    };

    private void SelectCategory( WeaponCategory? category )
    {
        SelectedCategory = category;
        StateHasChanged();
    }

    private void SetWeaponSearch( string text )
    {
        WeaponSearch = text ?? "";
        StateHasChanged();
    }

    private void SelectSort( WeaponRecordSort sort )
    {
        SelectedSort = sort;
        StateHasChanged();
    }

    private void ClearWeaponFilters()
    {
        SelectedCategory = null;
        WeaponSearch = "";
        StateHasChanged();
    }

    private string RankProgressLabel => Progression.GetLevel() >= Progression.MaxLevel
        ? Tr( "MAXIMUM LEVEL REACHED" )
        : Tr( "{0} XP TO LEVEL {1}", Math.Max( 0, Progression.GetXPForNextLevel() - Progression.GetXPIntoLevel() ).ToString( "N0" ), Progression.GetLevel() + 1 );

    private void BackToBarracks() => this.Navigate( "/barracks" );
       
    public void OnNavigationOpen()
    {
        MainMenuRoot.Instance?.SetActiveRoute( "/barracks" );
        if ( MainMenuRoot.Instance.IsValid() )
            MainMenuRoot.Instance.SetBlur( true );
    }
    
    public void OnNavigationClose() 
    {
        if ( MainMenuRoot.Instance.IsValid() )
        {
            MainMenuRoot.Instance.SetBlur( false );
        }
    }

    void EnterPrestigeMode()
    {
        Progression.EnterPrestigeMode();
        StateHasChanged();
    }

    /// <summary>A reached prestige's card shows its emblem in the menus and on the scoreboard; a locked one does nothing.</summary>
    void PickEmblem( int prestige )
    {
        if ( prestige > Progression.GetPrestige() ) return;
        Progression.SetPrestigeEmblem( prestige );
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( Progression.GetXP() );
        hash.Add( Progression.GetLevel() );
        hash.Add( Progression.GetPrestige() );
        hash.Add( Progression.GetPrestigeEmblem() );
        hash.Add( GameText.Current );
        hash.Add( SelectedCategory );
        hash.Add( WeaponSearch );
        hash.Add( SelectedSort );
        foreach ( var weapon in GetRecordWeapons() )
        {
            hash.Add( weapon.ResourcePath );
            hash.Add( weapon.Name );
            hash.Add( weapon.Category );
            if ( SelectedSort == WeaponRecordSort.Kills ) hash.Add( WeaponStats.Get( "kills", weapon ) );
            if ( SelectedSort == WeaponRecordSort.Level ) hash.Add( WeaponProgression.GetXP( weapon ) );
        }
        return hash.ToHashCode();
    }
}
