@using Sandbox;
@using Sandbox.UI;

@namespace Facepunch.UI
@inherits Panel

<root class="career-stat">
    <label class="name">
        @Tr( Name )
    </label>


    <label class="value">
        @StatValue
    </label>
</root>

@code
{
    /// <summary> The stat's English name ("Kills"), translated where it's shown. </summary>
    public string Name { get; set; }
    public string Stat { get; set; }

    private double StatValue => Stats.Get( Stat );

    protected override int BuildHash()
    {
        return HashCode.Combine( StatValue );
    }
}
