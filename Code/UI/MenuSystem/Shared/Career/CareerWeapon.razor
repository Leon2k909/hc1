@using Sandbox;
@using Sandbox.UI;

@namespace Facepunch.UI
@inherits Panel

<root class="career-weapon">
    <div class="weapon-heading">
        <label class="weapon-name">@Equipment.Name</label>
        <div class="weapon-icon" style="background-image: url(@Equipment.Icon);" />
    </div>
    <div class="weapon-level-row">
        <label class="weapon-level-badge">@Tr( "LEVEL {0}", WeaponProgression.GetLevel( Equipment ) )</label>
        <div class="weapon-xp-bar-wrap">
            <div class="weapon-xp-bar-fill" style="width: @((WeaponProgression.GetLevelProgress( Equipment ) * 100f).ToString("0.#"))%;" />
        </div>
    </div>
    <div class="weapon-stat-row">
        <label>@Tr( "Kills" )</label>
        <label class="weapon-stat-value">@WeaponStats.Get( "kills", Equipment )</label>
    </div>
    <div class="weapon-stat-row">
        <label>@Tr( "Headshot Kills" )</label>
        <label class="weapon-stat-value">@WeaponStats.Get( "kills-headshots", Equipment )</label>
    </div>
</root>

@code
{
    public EquipmentResource Equipment { get; set; }
    public string Value { get; set; }

        protected override int BuildHash()
    {
        return HashCode.Combine( Equipment, WeaponStats.Get( "kills-headshots", Equipment ), WeaponStats.Get( "kills", Equipment ),
            WeaponProgression.GetXP( Equipment ) );
    }
}
