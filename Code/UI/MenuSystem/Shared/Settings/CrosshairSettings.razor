@using Sandbox;
@using Sandbox.UI;
@using Facepunch;
@inherits Panel
@namespace Facepunch.UI
@attribute [StyleSheet]

<root class="crosshair-settings">
    <div class="ch-tabs">
        <button class="ch-tab @(_tab == "crosshair" ? "selected" : "")" @onmousedown=@(() => SetTab( "crosshair" ))>@Tr( "Crosshair" )</button>
        <button class="ch-tab @(_tab == "hit" ? "selected" : "")" @onmousedown=@(() => SetTab( "hit" ))>@Tr( "Hit Marker" )</button>
    </div>

    <div class="ch-body">
    <div class="ch-scroll">
    @if ( _tab == "crosshair" )
    {
        <div class="ch-label">@Tr( "Style" )</div>
        <div class="ch-chips">
            <button class="ch-chip @(Cfg.Style == "none" ? "selected" : "")" @onmousedown=@(() => SetStyle( "none" ))>@Tr( "None" )</button>
            <button class="ch-chip @(Cfg.Style == "hc1" ? "selected" : "")" @onmousedown=@(() => SetStyle( "hc1" ))>HC1</button>
            <button class="ch-chip @(Cfg.Style == "classic" ? "selected" : "")" @onmousedown=@(() => SetStyle( "classic" ))>@Tr( "Classic" )</button>
            <button class="ch-chip @(Cfg.Style == "modern" ? "selected" : "")" @onmousedown=@(() => SetStyle( "modern" ))>@Tr( "Modern" )</button>
            <button class="ch-chip @(Cfg.Style == "custom" ? "selected" : "")" @onmousedown=@(() => SetStyle( "custom" ))>@Tr( "Custom" )</button>
        </div>

        <div class="ch-label mt">@Tr( "Enabled" )</div>
        <div class="ch-chips">
            <button class="ch-chip @(Cfg.Enabled ? "selected" : "")" @onmousedown=@(() => { Cfg.Enabled = true; Save(); })>@Tr( "On" )</button>
            <button class="ch-chip @(!Cfg.Enabled ? "selected" : "")" @onmousedown=@(() => { Cfg.Enabled = false; Save(); })>@Tr( "Off" )</button>
        </div>

        <div class="ch-label mt">@Tr( "Hide On ADS" )</div>
        <div class="ch-chips">
            <button class="ch-chip @(Cfg.HideOnAds ? "selected" : "")" @onmousedown=@(() => { Cfg.HideOnAds = true; Save(); })>@Tr( "On" )</button>
            <button class="ch-chip @(!Cfg.HideOnAds ? "selected" : "")" @onmousedown=@(() => { Cfg.HideOnAds = false; Save(); })>@Tr( "Off" )</button>
        </div>

        @if ( Cfg.Style == "hc1" )
        {
            @* HC1's own crosshair (Crosshair.cs) reads these game settings; they had shown only in a search. *@
            <div class="ch-native">
                @foreach ( var property in NativeSettings )
                {
                    <SettingEntry Target=@GameSettingsSystem.Current Description=@property />
                }
            </div>
        }

        @if ( Cfg.Style == "custom" )
        {
            <div class="ch-label mt">@Tr( "Color" )</div>
            <div class="ch-chips">
                @foreach ( var hex in ColorPresets )
                {
                    var h = hex;
                    <button class="ch-swatch @(Cfg.Color == h ? "selected" : "")" style="background-color:@h" @onmousedown=@(() => { Cfg.Color = h; Save(); })></button>
                }
            </div>

            <div class="ch-label mt">@Tr( "Alpha - {0}%", Math.Round( Cfg.Alpha * 100 ) )</div>
            <div class="ch-chips">
                @foreach ( var v in AlphaSteps )
                {
                    var val = v;
                    <button class="ch-chip @(Math.Abs( Cfg.Alpha - val ) < 0.01f ? "selected" : "")" @onmousedown=@(() => { Cfg.Alpha = val; Save(); })>@(Math.Round( val * 100 ))%</button>
                }
            </div>

            <div class="ch-label mt">@Tr( "Thickness - {0}px", Cfg.Thickness )</div>
            <div class="ch-chips">
                @foreach ( var v in ThicknessSteps )
                {
                    var val = v;
                    <button class="ch-chip @(Cfg.Thickness == val ? "selected" : "")" @onmousedown=@(() => { Cfg.Thickness = val; Save(); })>@val</button>
                }
            </div>

            <div class="ch-label mt">@Tr( "Length - {0}px", Cfg.Size )</div>
            <div class="ch-chips">
                @foreach ( var v in CrosshairSizeSteps )
                {
                    var val = v;
                    <button class="ch-chip @(Cfg.Size == val ? "selected" : "")" @onmousedown=@(() => { Cfg.Size = val; Save(); })>@val</button>
                }
            </div>

            <div class="ch-label mt">@Tr( "Gap - {0}px", Cfg.Gap )</div>
            <div class="ch-chips">
                @foreach ( var v in GapSteps )
                {
                    var val = v;
                    <button class="ch-chip @(Cfg.Gap == val ? "selected" : "")" @onmousedown=@(() => { Cfg.Gap = val; Save(); })>@val</button>
                }
            </div>

            <div class="ch-label mt">@Tr( "Options" )</div>
            <div class="ch-chips">
                <button class="ch-chip @(Cfg.Dot ? "selected" : "")" @onmousedown=@(() => { Cfg.Dot = !Cfg.Dot; Save(); })>@Tr( "Center Dot" )</button>
                <button class="ch-chip @(Cfg.TStyle ? "selected" : "")" @onmousedown=@(() => { Cfg.TStyle = !Cfg.TStyle; Save(); })>@Tr( "T-Style" )</button>
                <button class="ch-chip @(Cfg.Outline ? "selected" : "")" @onmousedown=@(() => { Cfg.Outline = !Cfg.Outline; Save(); })>@Tr( "Outline" )</button>
            </div>

            @if ( Cfg.Outline )
            {
                <div class="ch-label mt">@Tr( "Outline Thickness - {0}px", Cfg.OutlineThickness )</div>
                <div class="ch-chips">
                    @foreach ( var v in OutlineSteps )
                    {
                        var val = v;
                        <button class="ch-chip @(Cfg.OutlineThickness == val ? "selected" : "")" @onmousedown=@(() => { Cfg.OutlineThickness = val; Save(); })>@val</button>
                    }
                </div>

                <div class="ch-label mt">@Tr( "Outline Alpha - {0}%", Math.Round( Cfg.OutlineAlpha * 100 ) )</div>
                <div class="ch-chips">
                    @foreach ( var v in AlphaSteps )
                    {
                        var val = v;
                        <button class="ch-chip @(Math.Abs( Cfg.OutlineAlpha - val ) < 0.01f ? "selected" : "")" @onmousedown=@(() => { Cfg.OutlineAlpha = val; Save(); })>@(Math.Round( val * 100 ))%</button>
                    }
                </div>
            }
        }
    }

    @if ( _tab == "hit" )
    {
        <div class="ch-label">@Tr( "Style" )</div>
        <div class="ch-chips">
            <button class="ch-chip @(Cfg.HitStyle == "none" ? "selected" : "")" @onmousedown=@(() => SetHitStyle( "none" ))>@Tr( "None" )</button>
            <button class="ch-chip @(Cfg.HitStyle == "x" ? "selected" : "")" @onmousedown=@(() => SetHitStyle( "x" ))>X</button>
            <button class="ch-chip @(Cfg.HitStyle == "ring" ? "selected" : "")" @onmousedown=@(() => SetHitStyle( "ring" ))>@Tr( "Ring" )</button>
            <button class="ch-chip @(Cfg.HitStyle == "dot" ? "selected" : "")" @onmousedown=@(() => SetHitStyle( "dot" ))>@Tr( "Dot" )</button>
            <button class="ch-chip @(Cfg.HitStyle == "diamond" ? "selected" : "")" @onmousedown=@(() => SetHitStyle( "diamond" ))>@Tr( "Diamond" )</button>
        </div>

        <div class="ch-label mt">@Tr( "Color" )</div>
        <div class="ch-chips">
            @foreach ( var hex in ColorPresets )
            {
                var h = hex;
                <button class="ch-swatch @(Cfg.HitColor == h ? "selected" : "")" style="background-color:@h" @onmousedown=@(() => { Cfg.HitColor = h; Save(); })></button>
            }
        </div>

        <div class="ch-label mt">@Tr( "Alpha - {0}%", Math.Round( Cfg.HitAlpha * 100 ) )</div>
        <div class="ch-chips">
            @foreach ( var v in AlphaSteps )
            {
                var val = v;
                <button class="ch-chip @(Math.Abs( Cfg.HitAlpha - val ) < 0.01f ? "selected" : "")" @onmousedown=@(() => { Cfg.HitAlpha = val; Save(); })>@(Math.Round( val * 100 ))%</button>
            }
        </div>

        <div class="ch-label mt">@Tr( "Thickness - {0}px", Cfg.HitThickness )</div>
        <div class="ch-chips">
            @foreach ( var v in ThicknessSteps )
            {
                var val = v;
                <button class="ch-chip @(Cfg.HitThickness == val ? "selected" : "")" @onmousedown=@(() => { Cfg.HitThickness = val; Save(); })>@val</button>
            }
        </div>

        <div class="ch-label mt">@Tr( "Size - {0}px", Cfg.HitSize )</div>
        <div class="ch-chips">
            @foreach ( var v in HitSizeSteps )
            {
                var val = v;
                <button class="ch-chip @(Cfg.HitSize == val ? "selected" : "")" @onmousedown=@(() => { Cfg.HitSize = val; Save(); })>@val</button>
            }
        </div>

        <div class="ch-label mt">@Tr( "Duration - {0}ms", Cfg.HitDuration )</div>
        <div class="ch-chips">
            @foreach ( var v in DurationSteps )
            {
                var val = v;
                <button class="ch-chip @(Cfg.HitDuration == val ? "selected" : "")" @onmousedown=@(() => { Cfg.HitDuration = val; Save(); Preview?.PlayHit(); })>@val</button>
            }
        </div>

        <div class="ch-label mt">@Tr( "Options" )</div>
        <div class="ch-chips">
            <button class="ch-chip @(Cfg.HitOutline ? "selected" : "")" @onmousedown=@(() => { Cfg.HitOutline = !Cfg.HitOutline; Save(); })>@Tr( "Outline" )</button>
        </div>

        @if ( Cfg.HitOutline )
        {
            <div class="ch-label mt">@Tr( "Outline Thickness - {0}px", Cfg.HitOutlineThickness )</div>
            <div class="ch-chips">
                @foreach ( var v in OutlineSteps )
                {
                    var val = v;
                    <button class="ch-chip @(Cfg.HitOutlineThickness == val ? "selected" : "")" @onmousedown=@(() => { Cfg.HitOutlineThickness = val; Save(); })>@val</button>
                }
            </div>

            <div class="ch-label mt">@Tr( "Outline Alpha - {0}%", Math.Round( Cfg.HitOutlineAlpha * 100 ) )</div>
            <div class="ch-chips">
                @foreach ( var v in AlphaSteps )
                {
                    var val = v;
                    <button class="ch-chip @(Math.Abs( Cfg.HitOutlineAlpha - val ) < 0.01f ? "selected" : "")" @onmousedown=@(() => { Cfg.HitOutlineAlpha = val; Save(); })>@(Math.Round( val * 100 ))%</button>
                }
            </div>
        }
    }

    <div class="ch-footer">
        <button class="ch-btn subtle" @onmousedown=ResetDefaults>@Tr( "Reset Defaults" )</button>
    </div>
    </div>

    <CrosshairPreview @ref="Preview" Mode=@_tab />
    </div>
</root>

@code
{
    string _tab = "crosshair";

    static readonly string[] ColorPresets = new[]
    {
        "#ffffff", "#ff4444", "#ff8800", "#ffee00",
        "#44ff44", "#3cff7a", "#00ccff", "#8844ff"
    };

    static readonly float[] AlphaSteps = new[] { 0.2f, 0.4f, 0.6f, 0.8f, 1.0f };
    static readonly int[] ThicknessSteps = new[] { 1, 2, 3, 4, 6 };
    static readonly int[] CrosshairSizeSteps = new[] { 4, 6, 8, 10, 14, 20 };
    static readonly int[] GapSteps = new[] { 0, 2, 4, 6, 8, 12 };
    static readonly int[] OutlineSteps = new[] { 0, 1, 2, 3, 4 };
    static readonly int[] HitSizeSteps = new[] { 8, 12, 16, 24, 32, 48 };
    static readonly int[] DurationSteps = new[] { 150, 250, 420, 600, 900 };

    CrosshairConfig Cfg => CrosshairManager.Config;

    CrosshairPreview Preview { get; set; }

    static IEnumerable<PropertyDescription> NativeSettings =>
        TypeLibrary.GetPropertyDescriptions( GameSettingsSystem.Current ).Where( x => x.Group == "Crosshair" );

    void SetTab( string tab )
    {
        _tab = tab;
        StateHasChanged();
    }

    void SetStyle( string style )
    {
        Cfg.Style = style;
        Save();
    }

    void SetHitStyle( string style )
    {
        Cfg.HitStyle = style;
        Save();
        Preview?.PlayHit();
    }

    void Save()
    {
        CrosshairManager.SaveConfig();
        StateHasChanged();
    }

    void ResetDefaults()
    {
        CrosshairManager.ResetConfig();
        StateHasChanged();
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( _tab );
        hash.Add( Cfg.Style );
        hash.Add( Cfg.Enabled );
        hash.Add( Cfg.HideOnAds );
        hash.Add( Cfg.Color );
        hash.Add( Cfg.Alpha );
        hash.Add( Cfg.Thickness );
        hash.Add( Cfg.Size );
        hash.Add( Cfg.Gap );
        hash.Add( Cfg.Dot );
        hash.Add( Cfg.TStyle );
        hash.Add( Cfg.Outline );
        hash.Add( Cfg.OutlineThickness );
        hash.Add( Cfg.OutlineAlpha );
        hash.Add( Cfg.HitStyle );
        hash.Add( Cfg.HitColor );
        hash.Add( Cfg.HitAlpha );
        hash.Add( Cfg.HitThickness );
        hash.Add( Cfg.HitSize );
        hash.Add( Cfg.HitDuration );
        hash.Add( Cfg.HitOutline );
        hash.Add( Cfg.HitOutlineThickness );
        hash.Add( Cfg.HitOutlineAlpha );
        return hash.ToHashCode();
    }
}