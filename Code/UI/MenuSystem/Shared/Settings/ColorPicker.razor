@namespace Facepunch.UI
@inherits Panel

<style>
    ColorPicker .channels
    {
        width: 100%;
        justify-content: center;
    }

    /* Each channel box grows to 180px, and in a narrower row the three share it instead of wrapping. */
    ColorPicker .channel
    {
        flex-grow: 1;
        flex-shrink: 1;
        flex-basis: 0;
        min-width: 0;
        max-width: 180px;
    }

    /* The channel's name keeps its width and the number gives way: in a narrow box "Green" wrapped letter by letter
       ("Gree / n", the emblem editor, 2026-10-05). */
    ColorPicker .channel label
    {
        flex-shrink: 0;
        white-space: nowrap;
    }

    ColorPicker .channel TextEntry
    {
        min-width: 0;
        flex-shrink: 1;
    }
</style>

<root class="layout column">
    <ColorSlider Value:bind="@Value" />

    <div class="channels layout padding gap align-center">
        <div class="channel layout padding with-background flex center space-between">
            <label class="small slight">@Tr( "Red" )</label>
            <TextEntry Value:bind="@Red" />
        </div>

        <div class="channel layout padding with-background flex center space-between">
            <label class="small slight">@Tr( "Green" )</label>
            <TextEntry Value:bind="@Green" />
        </div>

        <div class="channel layout padding with-background flex center space-between">
            <label class="small slight">@Tr( "Blue" )</label>
            <TextEntry Value:bind="@Blue" />
        </div>
    </div>

</root>

@code
{
    public Color Value { get; set; } = Color.Red;

    public int Red
    {
        get => Value.ToColor32().r;
        set => Value = Value with { r = (float)value / 255f };
    }

    public int Green
    {
        get => Value.ToColor32().g;
        set => Value = Value with { g = (float)value / 255f };
    }

    public int Blue
    {
        get => Value.ToColor32().b;
        set => Value = Value with { b = (float)value / 255f };
    }
}