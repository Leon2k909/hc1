@using Sandbox.UI
@using Sandbox

@inherits Panel
@implements IPadAdjustable
@namespace Facepunch.UI

<style>
    .box {
        width: 24px;
        height: 24px;
    }
</style>

<root class="border-bottom">
    @if ( Description is not null )
    {
        @if ( Description.PropertyType == typeof( GameLanguage ) )
        {
            <div class="with-padding grow language-setting">
                <div class="setting-text">
                    <label class="name">@LanguageTitle</label>
                    <label class="setting-hint">@Tr( "Language changes apply immediately and are saved automatically." )</label>
                </div>
                <div class="grow" />
                <div class="language-controls">
                    <div class="choice-options english-variants">
                        @foreach ( var language in EnglishVariants )
                        {
                            <button class="choice-option pad-target @(GameText.Current == language ? "selected" : "")" onclick=@(() => PickEnglish( language ))>
                                <div class="language-variant-text">
                                    <label>@GameText.NativeName( language )</label>
                                    <label class="language-spelling">@(language == GameLanguage.EnglishUK ? "Customise / Colour" : "Customize / Color")</label>
                                </div>
                                @if ( GameText.Current == language )
                                {
                                    <i>check</i>
                                }
                            </button>
                        }
                    </div>
                    <LanguagePicker />
                </div>
            </div>
        }
        else if ( Description.PropertyType == typeof( VoiceChatMode ) )
        {
            <div class="with-padding choice-setting">
                <label class="name">@SettingTitle</label>
                <div class="choice-options">
                    @foreach ( var mode in Enum.GetValues<VoiceChatMode>() )
                    {
                        <button class="choice-option @(Equals( Value, mode ) ? "selected" : "")" onclick=@(() => Value = mode)><label>@Tr( VoiceModeTitle( mode ) )</label></button>
                    }
                </div>
            </div>
        }
        else if ( Description.PropertyType == typeof( LobbyInput ) )
        {
            <div class="with-padding choice-setting">
                <div class="setting-text">
                    <label class="name">@SettingTitle</label>
                    <label class="setting-hint">@Tr( "Controller Only or Mouse & Keyboard Only keeps you in lobbies for that input: the games you host take only those players, and you only join theirs." )</label>
                </div>
                <div class="choice-options">
                    @foreach ( var input in Enum.GetValues<LobbyInput>() )
                    {
                        <button class="choice-option with-icon @(Equals( Value, input ) ? "selected" : "")" onclick=@(() => Value = input)><i>@LobbyInputRules.Icon( input )</i><label>@Tr( LobbyInputRules.Title( input ) )</label></button>
                    }
                </div>
            </div>
        }
        else if ( Description.PropertyType == typeof( float ) || Description.PropertyType == typeof( int ) )
        {
            <div class="with-padding">
                <label class="name">@SettingTitle</label>
                <div class="grow" />
            </div>

            <div class="control">
                @if ( Range is not null )
                {
                    <CustomSlider style="width: 250px;" class="devslider" Value:bind=@Value Min=@Range.Min Max=@Range.Max Step=@Range.Step ShowTextEntry="@false" />
                    <label class="slider-value">@SliderText</label>
                }
                else
                {
                    <CustomSlider class="devslider" Value:bind=@Value />
                }
            </div>
        }
        else if ( Description.PropertyType == typeof( bool ) && Choices is not null )
        {
            <div class="with-padding grow switch-setting">
                <label class="name">@SettingTitle</label>
                <div class="grow" />
                <div class="switch">
                    <div class="switch-option @(Equals( Value, false ) ? "selected" : "")" onclick=@(() => Value = false)><label>@Tr( Choices.WhenFalse )</label></div>
                    <div class="switch-option @(Equals( Value, true ) ? "selected" : "")" onclick=@(() => Value = true)><label>@Tr( Choices.WhenTrue )</label></div>
                </div>
            </div>
        }
        else if ( Description.PropertyType == typeof( bool ) )
        {
            <div class="with-padding border-bottom grow">
                <label class="name">@SettingTitle</label>
                <div class="grow" />
                <Checkbox Value:bind=@Value />
            </div>
        }
        else if ( Description.PropertyType == typeof( Color ) )
        {
            <div class="with-padding border-bottom">
                <label class="name" style="min-width: 64px;">@SettingTitle</label>
            </div>

            <div class="control layout column">
                <ColorPicker Value:bind="@Value" />
            </div>
        }
    }
</root>

@code
{
    public object Target { get; set; }
    public object Value
    {
        get => Description.GetValue( Target );
        set
        {
            Description.SetValue( Target, value );
            if ( Target is GameSettings )
                GameSettingsSystem.Apply();
        }
    }
    public PropertyDescription Description { get; set; }

    public RangeAttribute Range => Description.GetCustomAttribute<RangeAttribute>();

    // The slider's value beside it, to its step's decimals: a sensitivity's 1.00, a field of view's 85.
    private string SliderText
    {
        get
        {
            var value = Convert.ToSingle( Value );
            var step = Range?.Step ?? 1f;
            return value.ToString( step >= 1f ? "0" : step >= 0.1f ? "0.0" : "0.00" );
        }
    }
    public ChoicesAttribute Choices => Description.GetCustomAttribute<ChoicesAttribute>();

    // Other languages look these up by a fuller name: "Master" alone is also the top rank, which they name differently,
    // and the abbreviations aren't theirs.
    private static readonly Dictionary<string, string> FullTitles = new()
    {
        ["Master"] = "Master volume",
        ["SFX"] = "Sound effects",
        ["UI"] = "Interface sounds",
    };

    private string SettingTitle => !GameText.IsEnglish && FullTitles.TryGetValue( Description.Title, out var full )
        ? Tr( full ) : Tr( Description.Title );

    // The English name stays beside the translation, so the setting can be found in a language you can't read.
    private static string LanguageTitle => GameText.IsEnglish ? Tr( "Language" ) : $"{Tr( "Language" )} / Language";

    private static readonly GameLanguage[] EnglishVariants = { GameLanguage.EnglishUK, GameLanguage.EnglishUS };

    private static void PickEnglish( GameLanguage language )
    {
        LanguageMenu.CloseAny();
        Sound.Play( "ui_button_press" );
        if ( GameText.Current != language ) GameText.SetLanguage( language );
    }

    private static string VoiceModeTitle( VoiceChatMode mode ) => mode switch
    {
        VoiceChatMode.Global => "Global (Whole Lobby)",
        VoiceChatMode.TeamOnly => "Team Only",
        VoiceChatMode.PartyOnly => "Party Only",
        _ => "Auto (GameMode Default)"
    };

    // ── Pad (PadNavigation) ──────────────────────────────────────────────────────
    // A row of a kind this draws is one pad target: up and down move between rows, left and right change the row, and
    // A presses its control (PadPoint).

    private bool IsPadRow => Description?.PropertyType is { } type && (type == typeof( bool ) || type == typeof( float )
        || type == typeof( int ) || type == typeof( Color ) || type == typeof( GameLanguage ) || type == typeof( VoiceChatMode )
        || type == typeof( LobbyInput ));

    public override void Tick()
    {
        base.Tick();
        SetClass( PadNavigation.TargetClass, IsPadRow );
    }

    /// <summary> Where A presses: the checkbox, the chosen option, the slider's thumb, the language field. </summary>
    public Panel PadPoint
    {
        get
        {
            var type = Description?.PropertyType;
            if ( type == typeof( GameLanguage ) ) return Descendants.OfType<LanguagePicker>().FirstOrDefault();
            if ( type == typeof( float ) || type == typeof( int ) ) return Descendants.FirstOrDefault( x => x.HasClass( "thumb" ) );
            if ( type == typeof( bool ) && Choices is null ) return Descendants.OfType<Checkbox>().FirstOrDefault();

            // A colour's name: the picker beside it has nothing a press could set well.
            if ( type == typeof( Color ) ) return Descendants.FirstOrDefault( x => x.HasClass( "name" ) );

            return Descendants.FirstOrDefault( x => x.HasClass( "selected" ) );
        }
    }

    /// <summary>
    /// Left and right: a slider steps (PadNavMath.SliderStep), a switch or a checkbox goes to its left (off) or right
    /// (on) side, and a row of choices to the next one. The language and a colour have nothing to step through.
    /// </summary>
    public bool PadAdjust( int direction, float heldFor )
    {
        var type = Description?.PropertyType;

        if ( type == typeof( bool ) )
        {
            var on = direction > 0;
            if ( !Equals( Value, on ) )
            {
                Value = on;
                Sound.Play( "ui_button_hover" );
            }
            return true;
        }

        if ( type == typeof( float ) || type == typeof( int ) )
        {
            var current = Convert.ToSingle( Value );
            var next = PadNavMath.SliderStep( current, Range?.Min ?? 0f, Range?.Max ?? 100f, Range?.Step ?? 1f, direction, heldFor );
            if ( next != current )
                Value = type == typeof( int ) ? (object)(int)MathF.Round( next ) : next;
            return true;
        }

        if ( type == typeof( VoiceChatMode ) ) return Cycle<VoiceChatMode>( direction );
        if ( type == typeof( LobbyInput ) ) return Cycle<LobbyInput>( direction );
        return false;
    }

    /// <summary> The next choice that way, stopping at the ends. </summary>
    private bool Cycle<T>( int direction ) where T : struct, Enum
    {
        var values = Enum.GetValues<T>();
        var index = Array.IndexOf( values, (T)Value );
        var next = Math.Clamp( index + direction, 0, values.Length - 1 );
        if ( next != index )
        {
            Value = values[next];
            Sound.Play( "ui_button_hover" );
        }
        return true;
    }

    protected override int BuildHash() => HashCode.Combine( Description, Description?.GetValue( Target ), GameText.Current );
}
