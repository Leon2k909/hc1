@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@attribute [StyleSheet]
@namespace Facepunch.UI

<root class="hc1 landing store-page">

    @* ===================== MAIN CONTENT ===================== *@
    <div class="content store-content">
        <div class="store-header">
            <label class="store-title">ITEM SHOP</label>
            <label class="store-sub">Use Razed Coins (RC) to purchase exclusive items.</label>
            <div class="debug-btn" onclick=@(() => AddCoins(1000))>
                <i>add_circle</i>
                <label>DEBUG: +1000 COINS</label>
            </div>
        </div>

        <div class="store-grid">
            <div class="store-item">
                <div class="item-img" style="background-color: rgba(255,152,0, 0.2);">
                    <i style="font-size: 64px; color: #ff9800; opacity: 0.8;">star</i>
                </div>
                <label class="item-name">DOUBLE XP TOKEN</label>
                <label class="item-desc">Double your progression XP for 1 hour.</label>
                <div class="buy-btn @(CurrencyBalance >= 500 ? "" : "disabled")" onclick=@(() => BuyItem("xp_boost", 500))>
                    <i>shopping_cart</i>
                    <label>500 RC</label>
                </div>
            </div>
            <div class="store-item">
                <div class="item-img" style="background-image: url('camos/ui/mastery.vtex'); background-color: #333; background-size: cover; border: 1px solid rgba(255,255,255,0.1);" />
                <label class="item-name">MASTERY CAMO</label>
                <label class="item-desc">Unlock the exclusive Mastery camo for all weapons.</label>
                <div class="buy-btn @(CurrencyBalance >= 2500 ? "" : "disabled")" onclick=@(() => BuyItem("mastery_camo", 2500))>
                    <i>shopping_cart</i>
                    <label>2,500 RC</label>
                </div>
            </div>
        </div>
    </div>
</root>

@code
{
    public void OnNavigationOpen()  => MainMenuRoot.Instance?.SetActiveRoute( "/store" );
    public void OnNavigationClose() { }

    private ulong LocalSteamId => Client.Local?.SteamId ?? Connection.Local?.SteamId ?? 0UL;
    private string LocalName
    {
        get
        {
            var name = Client.Local?.DisplayName ?? Connection.Local?.DisplayName;
            return string.IsNullOrWhiteSpace( name ) ? "Player" : name;
        }
    }
    private int PlayerLevel => Progression.GetLevel();
    private int CurrencyBalance => CurrencyManager.GetBalance();

    void AddCoins( int amount )
    {
        CurrencyManager.Add( amount );
    }

    void BuyItem( string itemId, int price )
    {
        if ( CurrencyManager.Spend( price ) )
        {
            Log.Info( $"Successfully purchased {itemId} for {price} RC" );
            // TODO: Actually grant the item in Game.Cookies
        }
        else
        {
            Log.Info( $"Not enough RC to purchase {itemId}" );
        }
    }

    protected override int BuildHash()
    {
        return HashCode.Combine( LocalSteamId, LocalName, PlayerLevel, CurrencyBalance );
    }
}
