@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@attribute [StyleSheet]
@namespace Facepunch.UI

<root class="hc1 store-page">
    <MenuTopbar Title="STORE" />
    <div class="store-content">
        <div class="store-header">
            <div class="store-heading">
                <label class="store-title">@Tr( "ITEM SHOP" )</label>
                <label class="store-sub">@Tr( "Use Razed Coins (RC) to purchase exclusive items." )</label>
            </div>
            <div class="store-balance">
                <label class="balance-label">@Tr( "YOUR BALANCE" )</label>
                <label class="balance-value">@CurrencyBalance.ToString("N0") RC</label>
            </div>
        </div>

        <div class="store-grid">
            <div class="store-item">
                <div class="item-img xp-art"><i>star</i><label>2XP</label></div>
                <div class="item-info">
                    <label class="item-name">@Tr( "DOUBLE XP TOKEN" )</label>
                    <label class="item-desc">@Tr( "Double your progression XP for 1 hour." )</label>
                    <div class="buy-btn primary @(CurrencyBalance >= 500 ? "" : "disabled")" onclick=@(() => BuyItem("xp_boost", 500))>
                        <i>shopping_cart</i>
                        <label>500 RC</label>
                    </div>
                </div>
            </div>
            <div class="store-item">
                <div class="item-img camo-art" />
                <div class="item-info">
                    <label class="item-name">@Tr( "MASTERY CAMO" )</label>
                    <label class="item-desc">@Tr( "Unlock the exclusive Mastery camo for all weapons." )</label>
                    <div class="buy-btn primary @(CurrencyBalance >= 2500 ? "" : "disabled")" onclick=@(() => BuyItem("mastery_camo", 2500))>
                        <i>shopping_cart</i>
                        <label>2,500 RC</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="store-tools">
            <div class="debug-btn" onclick=@(() => AddCoins(1000))>
                <i>add_circle</i>
                <label>DEBUG: +1000 COINS</label>
            </div>
        </div>
    </div>
</root>

@code
{
    public void OnNavigationOpen()  => MainMenuRoot.Instance?.SetActiveRoute( "/store" );
    public void OnNavigationClose() { }

    private int CurrencyBalance => CurrencyManager.GetBalance();

    void AddCoins( int amount )
    {
        CurrencyManager.Add( amount );
    }

    void BuyItem( string itemId, int price )
    {
        if ( CurrencyManager.Spend( price ) )
        {
            Log.Info( $"Successfully purchased {itemId} for {price} RC" );
            // TODO: Actually grant the item in Game.Cookies
        }
        else
        {
            Log.Info( $"Not enough RC to purchase {itemId}" );
        }
    }

    protected override int BuildHash()
    {
        return HashCode.Combine( CurrencyBalance );
    }
}
