@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Network;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@namespace Facepunch.UI
@attribute [StyleSheet]

<root class="hc1 lobby-list">
    <MenuTopbar Title="SESSIONS" />

    <div class="sb-body">
        <ServerBrowser CurrentLobby:bind=@Lobby  @ref="Browser" />
    </div>

    <div class="sb-footer">
        <div class="sb-btn" onclick=@(() => Refresh())><i>refresh</i><label>@Tr( "Refresh" )</label></div>
        <a class="sb-btn" href="/new"><i>add</i><label>@Tr( "Create Game" )</label></a>
        <div class="sb-btn primary @(CanJoin ? "" : "disabled")" onclick=@(() => TryJoin())><i>play_arrow</i><label>@JoinLabel</label></div>
    </div>
</root>

@code
{
    public ServerBrowser Browser { get; set; }

    public Lobby? Lobby { get; set; }

    private bool CanJoin => Lobby.HasValue && !Lobby.Value.IsFull;

    private string JoinLabel => Tr( Lobby.HasValue && Lobby.Value.IsFull ? "Session Full" : "Join Session" );

    private void Refresh()
    {
        Browser.Refresh();
    }

    private void Create()
    {
        this.Navigate( "/new" );
    }

    private void TryJoin()
    {
        if ( !Lobby?.HasData ?? false )
        {
            DialogModal.Show(Tr( "This server is outdated and you may experience issues - we'd advise making your own lobby instead!" ), Tr( "OK" ), Tr( "Join anyway" ), null, () =>
            {
                Join();
            });
        }
        else
        {
            Join();
        }
    }

    private async void Join()
    {
        if ( !Lobby.HasValue ) return;

        var lobby = Lobby.Value;
        if ( lobby.IsFull ) return;

        if ( await Networking.TryConnectSteamId( lobby.LobbyId ) )
		{
			Log.Info( "joined lobby!" );
		}
    }

    public void OnNavigationOpen()
    {
        MainMenuRoot.Instance?.SetActiveRoute( "/lobbies" );
        if ( MainMenuRoot.Instance.IsValid() )
            MainMenuRoot.Instance.SetBlur( true );
    }

    public void OnNavigationClose()
    {
        if ( MainMenuRoot.Instance.IsValid() )
        {
            MainMenuRoot.Instance.SetBlur( false );
        }
    }

    // The selection arrives through the ServerBrowser binding, so rebuild the footer when it changes.
    protected override int BuildHash() => HashCode.Combine( Lobby?.LobbyId, Lobby?.IsFull );
}
