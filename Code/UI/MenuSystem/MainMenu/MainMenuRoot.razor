@using Sandbox.Menu
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits NavigationHost
@implements IPadScope
@namespace Facepunch.UI

<root class="main-menu-root">
    <div @ref="BackgroundPanel" class="background @( HasBlur ? "blur" : "")" />

    @* ── Persistent global nav — always on every page ─────────── *@
    <div class="global-nav">

        <a class="gnav-logo" href="/">
            <label class="gnav-game-name">RAZED</label>
        </a>

        @* ── Nav tabs + bumpers (bumpers only show with controller) ── *@
        <div class="gnav-tabs-group">
            @if ( Input.UsingController )
            {
                <div class="gnav-ctrl-btn" @onclick=@NavPrev>LB</div>
            }

            <div class="gnav-items">
                <a class="gnav-item @(IsActive("/") ? "active" : "")" href="/">
                    <i>home</i>
                    <label>@Tr( "PLAY" )</label>
                    <div class="gnav-item-bar" />
                </a>
                <div class="gnav-item" @onclick=@OpenGunsmith>
                    <i>build</i>
                    <label>@Tr( "WEAPONS" )</label>
                    <div class="gnav-item-bar" />
                </div>
                <a class="gnav-item @(IsActive("/operators") ? "active" : "")" href="/operators">
                    <i>badge</i>
                    <label>@Tr( "OPERATORS" )</label>
                    <div class="gnav-item-bar" />
                </a>
                <a class="gnav-item @(IsActive("/ranked") ? "active" : "")" href="/ranked">
                    <i>military_tech</i>
                    <label>@Tr( "RANKED" )</label>
                    <div class="gnav-item-bar" />
                </a>
                <a class="gnav-item @(IsActive("/new") ? "active" : "")" href="/new">
                    <i>tune</i>
                    <label>@Tr( "CUSTOM GAME" )</label>
                    <div class="gnav-item-bar" />
                </a>
                <a class="gnav-item @(IsActive("/barracks") ? "active" : "")" href="/barracks">
                    <i>star</i>
                    <label>@Tr( "PROFILE" )</label>
                    <div class="gnav-item-bar" />
                </a>
                <a class="gnav-item @(IsActive("/lobbies") ? "active" : "")" href="/lobbies">
                    <i>dns</i>
                    <label>@Tr( "SESSIONS" )</label>
                    <div class="gnav-item-bar" />
                </a>
                <a class="gnav-item @(IsActive("/store") ? "active" : "")" href="/store">
                    <i>storefront</i>
                    <label>@Tr( "STORE" )</label>
                    <div class="gnav-item-bar" />
                </a>
            </div>

            @if ( Input.UsingController )
            {
                <div class="gnav-ctrl-btn" @onclick=@NavNext>RB</div>
            }
        </div>

        <PartyPanel />

        <div class="gnav-right">
            <div class="gnav-round-btns" @ref="RoundButtons">
                <div class="gnav-round-btn @(_openMenu == HeaderMenu.More ? "open" : "")" @onclick=@(() => ToggleMenu( HeaderMenu.More ))>
                    <i>grid_view</i>
                    <label class="gnav-tip">@Tr( "MORE" )</label>
                </div>
                <div class="gnav-round-btn @(_openMenu == HeaderMenu.Notifications ? "open" : "")" @onclick=@(() => ToggleMenu( HeaderMenu.Notifications ))>
                    <i>notifications</i>
                    <label class="gnav-tip">@Tr( "NOTIFICATIONS" )</label>
                </div>
                <a class="gnav-round-btn @(IsActive("/settings") ? "open" : "")" href="/settings">
                    <i>settings</i>
                    <label class="gnav-tip">@Tr( "SETTINGS" )</label>
                </a>

                @if ( _openMenu == HeaderMenu.More )
                {
                    <div class="gnav-dropdown" @ref="Dropdown">
                        <div class="gnav-menu-item" @onclick=@OpenTheater>
                            <i>theaters</i>
                            <label>@Tr( "THEATER" )</label>
                        </div>
                        <div class="gnav-menu-item" @onclick=@ReportBug>
                            <i>bug_report</i>
                            <label>@Tr( "REPORT A BUG" )</label>
                        </div>
                        <div class="gnav-menu-divider" />
                        <div class="gnav-menu-item warn" @onclick=@QuitGame>
                            <i>power_settings_new</i>
                            <label>@Tr( "QUIT GAME" )</label>
                        </div>
                    </div>
                }
                else if ( _openMenu == HeaderMenu.Notifications )
                {
                    @* Nothing sends notifications yet. Hand-written "what's new" notes read as fake update notices, so they're out. *@
                    <div class="gnav-dropdown notifications">
                        <label class="gnav-dropdown-title">@Tr( "NOTIFICATIONS" )</label>
                        <div class="gnav-notifications-empty">
                            <i>notifications_none</i>
                            <label>@Tr( "No notifications" )</label>
                        </div>
                    </div>
                }
            </div>

            <a class="gnav-profile" href="/barracks">
                @if ( Progression.GetPrestigeEmblem() > 0 )
                {
                    <img class="gnav-prestige" src="/ui/prestige/prestige_@(Progression.GetPrestigeEmblem())_readable.png" />
                }
                <div class="gnav-profile-info">
                    <label class="gnav-profile-name">@LocalName</label>
                    <label class="gnav-profile-level">@Tr( "LV {0}", PlayerLevel )</label>
                </div>
                @if ( LocalSteamId != 0 )
                {
                    <img class="gnav-avatar" src="avatar:@LocalSteamId" />
                }
                else
                {
                    <div class="gnav-avatar gnav-avatar-placeholder"><i>person</i></div>
                }
                <label class="gnav-tip">@Tr( "PROFILE" )</label>
            </a>
            <div class="gnav-icon-btn" @onclick=@OpenFriendsList>
                <i>group</i>
                <label class="gnav-tip right">@Tr( "FRIENDS" )</label>
            </div>
        </div>
    </div>

    @if ( _openMenu != HeaderMenu.None )
    {
        @* Clicking anywhere else closes the open menu. *@
        <div class="gnav-dismiss pad-skip" @onclick=@CloseMenu />
    }

    @* ── Pages render here ─────────────────────────────────────── *@
    <div class="navigator-canvas" slot="navigator-canvas" />

    <BugReportPanel @ref=BugReportPanelRef />
    <QuitPrompt @ref=QuitPromptRef />
</root>

@code
{
    public static MainMenuRoot Instance { get; set; }
    private BugReportPanel BugReportPanelRef { get; set; }
    private QuitPrompt QuitPromptRef { get; set; }

    /// <summary>
    /// A page to open as soon as the menu is up, for a scene that goes back to the menu on a page other than the hub:
    /// the gunsmith's nav tabs (<see cref="GameUtils.ReturnToMainMenu"/>).
    /// </summary>
    public static string PendingRoute { get; set; }

    /// <summary>
    /// A message to show in a dialog as soon as the menu is up, in English (translated when it's shown): why a match sent
    /// the player back here, e.g. <see cref="LobbyInputGuard"/>'s.
    /// </summary>
    public static string PendingNotice { get; set; }

    // Track the current page route so nav items can highlight correctly.
    public string ActiveRoute { get; private set; } = "/";

    public MainMenuRoot()
    {
        CustomGameSettings.Reset();
        Instance = this;
        _menuScope = new PadScope { First = () => Dropdown, Back = () => { CloseMenu(); return true; } };
        DefaultUrl = "/";
        AddDestination( "/",            typeof( HubPage ) );
        AddDestination( "/ranked",      typeof( RankedPage ) );
        AddDestination( "/operators",   typeof( OperatorsPage ) );
        AddDestination( "/lobbies",     typeof( LobbyList ) );
        AddDestination( "/store",       typeof( StorePage ) );
        AddDestination( "/new",         typeof( CreateLobbyPage ) );
        AddDestination( "/career",      typeof( CareerLanding ) );
        AddDestination( "/barracks/career", typeof( CareerLanding ) );
        AddDestination( "/barracks",    typeof( BarracksPage ) );
        AddDestination( "/theater",     typeof( TheaterPage ) );
        AddDestination( "/settings",    typeof( SettingsPage ) );
    }

    /// <summary>Called by each page in OnNavigationOpen to highlight the correct nav tab.</summary>
    public void SetActiveRoute( string route )
    {
        ActiveRoute = route;
        _openMenu = HeaderMenu.None;
        StateHasChanged();
    }

    private bool IsActive( params string[] routes )
        => routes.Any( r => ActiveRoute.Equals( r, System.StringComparison.OrdinalIgnoreCase ) );

    // ── Controller tab navigation ──────────────────────────────
    // The header's tabs in order, for LB / RB. WEAPONS is the gunsmith, which loads its own scene; its LB / RB step back
    // out to PLAY and OPERATORS (GunsmithPanel.NavTabs).
    private const string GunsmithRoute = "gunsmith";

    private static readonly string[] ControllerNavRoutes =
    {
        "/",
        GunsmithRoute,
        "/operators",
        "/ranked",
        "/new",
        "/barracks",
        "/lobbies",
        "/store",
    };

    private int GetCurrentNavIndex()
    {
        for ( int i = 0; i < ControllerNavRoutes.Length; i++ )
            if ( IsActive( ControllerNavRoutes[i] ) ) return i;
        return 0;
    }

    private void NavPrev() => NavTo( (GetCurrentNavIndex() - 1 + ControllerNavRoutes.Length) % ControllerNavRoutes.Length );

    private void NavNext() => NavTo( (GetCurrentNavIndex() + 1) % ControllerNavRoutes.Length );

    private void NavTo( int index )
    {
        Sound.Play( "sounds/ui/menu/ui_nav_tab.sound" );

        var route = ControllerNavRoutes[index];
        if ( route == GunsmithRoute )
            OpenGunsmith();
        else
            this.Navigate( route );
    }

    // Down at the start, so a bumper still held from the gunsmith's LB / RB doesn't step on again as the menu comes up.
    private bool _lbWasDown = true, _rbWasDown = true;

    public override void Tick()
    {
        base.Tick();
        Instance = this; // the live, ticking root (constructor may run for other instances)
        if ( PendingRoute is { } route && CurrentUrl is not null )
        {
            PendingRoute = null;
            if ( !CurrentUrlMatches( route ) )
                this.Navigate( route );
        }
        if ( PendingNotice is { } notice )
        {
            PendingNotice = null;
            DialogModal.Show( Tr( notice ), Tr( "OK" ), null );
        }
        ResponsiveLayout.Update( this );

        // The pad (PadNavigation): the header and the page are one area, with the page's own scope inside this one.
        PadNavigation.Offer( this, this );
        if ( _openMenu != HeaderMenu.None && RoundButtons.IsValid() )
            PadNavigation.Offer( RoundButtons, _menuScope, 40 );

        // The full-size header needs about 1900 units, so anything narrower than a 16:9 screen tightens it up.
        SetClass( "tight-nav", Box.Rect.Size.x * ScaleFromScreen < 1900 );

        // LB / RB are the weapon-switch actions. Tracked even off the controller, so the first press steps at once.
        var lbDown = Input.Down( "PrevSlot" );
        var rbDown = Input.Down( "NextSlot" );

        if ( Input.UsingController )
        {
            if ( lbDown && !_lbWasDown ) NavPrev();
            if ( rbDown && !_rbWasDown ) NavNext();
        }

        _lbWasDown = lbDown;
        _rbWasDown = rbDown;
    }

    // ── Round buttons: the quick menu and notifications ────────
    private enum HeaderMenu { None, More, Notifications }
    private HeaderMenu _openMenu;

    private void ToggleMenu( HeaderMenu menu )
    {
        _openMenu = _openMenu == menu ? HeaderMenu.None : menu;
        Sound.Play( "ui_button_press" );
    }

    private void CloseMenu() => _openMenu = HeaderMenu.None;

    // ── Pad (PadNavigation) ────────────────────────────────────
    // The page offers its own scope inside this one, so B, LT and RT ask the page first. Left to the root, B goes back to
    // the hub, and on the hub it's Escape: the quit prompt.
    private Panel RoundButtons { get; set; }
    private Panel Dropdown { get; set; }

    /// <summary> An open header menu: the round buttons and the menu under them, which B closes. </summary>
    private PadScope _menuScope;

    /// <summary> The page's first control, for a page that doesn't pick one. </summary>
    public Panel PadFirstFocus => CurrentPanel;

    public bool PadBack()
    {
        if ( IsActive( "/" ) ) return false;

        Sound.Play( "ui_button_press" );
        this.Navigate( "/" );
        return true;
    }

    public bool PadTab( int direction ) => false;

    private void OpenTheater()
    {
        CloseMenu();
        this.Navigate( "/theater" );
    }

    private void ReportBug()
    {
        CloseMenu();
        OpenBugReport();
    }

    private void QuitGame()
    {
        CloseMenu();
        OpenQuitPrompt();
    }

    /// <summary> Asks whether to quit (<see cref="QuitPrompt"/>): Escape, the header's QUIT GAME and the hub's power button. </summary>
    public void OpenQuitPrompt() => QuitPromptRef?.Open();

    // ── Escape ─────────────────────────────────────────────────
    /// <summary>
    /// Escape closes one thing at a time: the language list, the bug report, the quit prompt, a header menu, the hub's
    /// overlays and the squad's privacy menu. With nothing open it asks whether to quit (<see cref="QuitPrompt"/>).
    /// Called from <see cref="MainMenuPanel"/>'s update: a panel's Tick is too late to see Escape.
    /// </summary>
    public void HandleEscape()
    {
        Input.EscapePressed = false;
        if ( LanguageMenu.CloseAny() ) return;

        if ( BugReportPanelRef is { IsOpen: true } )
        {
            BugReportPanelRef.Close();
            return;
        }

        if ( QuitPromptRef is { IsOpen: true } )
        {
            QuitPromptRef.Close();
            return;
        }

        if ( _openMenu != HeaderMenu.None )
        {
            CloseMenu();
            return;
        }

        if ( Descendants.OfType<HubPage>().Any( x => x.CloseOverlay() ) ) return;
        if ( Descendants.OfType<HubSidebar>().Any( x => x.ClosePrivacyMenu() ) ) return;

        OpenQuitPrompt();
    }

    // ── Profile info ───────────────────────────────────────────
    private ulong LocalSteamId => Client.Local.IsValid() ? Client.Local.SteamId : (Connection.Local?.SteamId ?? 0UL);
    private string LocalName
    {
        get
        {
            var n = Client.Local.IsValid() ? Client.Local.DisplayName : Connection.Local?.DisplayName;
            return string.IsNullOrWhiteSpace( n ) ? Tr( "PLAYER" ) : n.ToUpper();
        }
    }
    private int PlayerLevel => Progression.GetLevel();

    // ── Gunsmith ───────────────────────────────────────────────
    public void OpenGunsmith()
    {
        var scene = ResourceLibrary.Get<SceneFile>( "scenes/gunsmith.scene" );
        if ( !scene.IsValid() ) return;
        GameMode.SetCurrent( null );
        Game.ActiveScene.Load( scene );
    }

    // ── Utility ────────────────────────────────────────────────
    public bool HasBlur { get; set; }
    public Panel BackgroundPanel { get; set; }

    public void OpenBugReport() => BugReportPanelRef?.Open();

    private void OpenFriendsList()
    {
        Game.Overlay.ShowFriendsList( new Sandbox.Modals.FriendsListModalOptions()
        {
            ShowOfflineMembers = true,
        } );
    }

    public void SetBlur( bool doBlur )
    {
        HasBlur = doBlur;
        BackgroundPanel?.StateHasChanged();
    }

    protected override int BuildHash()
        => HashCode.Combine( ActiveRoute, LocalName, PlayerLevel, Progression.GetPrestigeEmblem(), LocalSteamId, Input.UsingController, _openMenu );
}
