@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

<root class="@(IsSelected ? "selected" : "") @(Lobby.IsFull ? "full" : "") @(Lobby.InputAllows ? "" : "other-input")">
    <label class="se-name">@Lobby.Name</label>

    @if ( Lobby.Input != LobbyInput.Any )
    {
        <div class="se-input"><i>@LobbyInputRules.Icon( Lobby.Input )</i></div>
    }

    @if ( Lobby.IsFull )
    {
        <label class="se-tag">@Tr( "Full" )</label>
    }

    <div class="se-players">
        <i>group</i>
        <label>@(Lobby.Members) / @(Lobby.MaxMembers)</label>
    </div>
</root>

@code
{
    public Lobby Lobby { get; set; }
    public Action<Lobby> OnSelected { get; set; }

    public bool IsSelected { get; set; }

    protected override void OnClick( MousePanelEvent e )
    {
        OnSelected?.Invoke( Lobby );
    }

    // What the player is playing with changes whether they can join a controller-only or mouse-only lobby.
    protected override int BuildHash() => HashCode.Combine( IsSelected, Lobby.LobbyId, Lobby.Members, Lobby.MaxMembers,
        Lobby.IsFull, Lobby.Input, Lobby.InputAllows );
}
