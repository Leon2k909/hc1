@using Sandbox.UI;
@using Sandbox.Network;

@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

<root>
    <div class="sb-head">
        <div class="sb-accent"></div>
        <label class="sb-title">@Tr( "SERVER BROWSER" )</label>
        <div class="sb-head-fill"></div>
        <label class="sb-count @(IsSearching && !ShowFakeLobbies ? "searching" : "")">@CountLabel</label>
    </div>

    <div class="sb-panels">
        <div class="sb-list">
            <div class="sb-panel-head">
                <label class="sb-col-name">@Tr( "Name" )</label>
                <label class="sb-col-players">@Tr( "Players" )</label>
            </div>

            <div class="sb-rows">
                @if ( ShowFakeLobbies )
                {
                    @for ( int i = 0; i < 32; i++ )
                    {
                        var fakeLobby = new Lobby()
                        {
                            FakeId = (ulong)i
                        };
                        <ServerEntry Lobby=@fakeLobby IsSelected=@( CurrentLobby?.Equals( fakeLobby ) ?? false )  OnSelected=@OnSelected />
                    }
                }
                else if ( IsSearching )
                {
                    <div class="sb-state searching">
                        <i>search</i>
                        <label class="sb-state-title">@Tr( "Searching for sessions" )</label>
                    </div>
                }
                else if ( FetchedLobbies.Count < 1 )
                {
                    <div class="sb-state">
                        <i>dns</i>
                        <label class="sb-state-title">@Tr( "No sessions found" )</label>
                        <label class="sb-state-text">@Tr( "Refresh the list or create your own game." )</label>
                    </div>
                }
                else
                {
                    @foreach ( var info in FetchedLobbies )
                    {
                        <ServerEntry Lobby=@(new Lobby( info )) IsSelected=@( CurrentLobby?.Equals( new Lobby( info ) ) ?? false )  OnSelected=@OnSelected />
                    }
                }
            </div>
        </div>

        <div class="sb-detail @(CurrentLobby.HasValue ? "" : "empty")">
            <div class="sb-panel-head">
                <label>@Tr( "Session Details" )</label>
            </div>

            @if ( CurrentLobby.HasValue )
            {
                var selected = CurrentLobby.Value;

                <div class="sb-detail-body">
                    <label class="sb-detail-name">@selected.Name</label>

                    <div class="sb-stat">
                        <label class="sb-stat-key">@Tr( "Players" )</label>
                        <label class="sb-stat-value">@selected.Members / @selected.MaxMembers</label>

                        <div class="sb-bar">
                            <div class="sb-bar-fill @(selected.IsFull ? "full" : "")" style="width: @(FillPercent( selected ))%;" />
                        </div>
                    </div>

                    <div class="sb-stat">
                        <label class="sb-stat-key">@Tr( "Status" )</label>
                        <label class="sb-stat-value @(selected.IsFull ? "full" : "open")">@Tr( selected.IsFull ? "Full" : "Open" )</label>
                    </div>
                </div>
            }
            else
            {
                <div class="sb-state">
                    <i>touch_app</i>
                    <label class="sb-state-text">@Tr( "Select a session to see its details." )</label>
                </div>
            }
        </div>
    </div>
</root>

@code
{
    [ConVar( "fp_ui_show_fake_lobbies" )]
    public static bool ShowFakeLobbies { get; set; }

    public Lobby? CurrentLobby { get; set; }

    private List<LobbyInformation> FetchedLobbies { get; set; } = new();

    private bool IsSearching = true;

    private string CountLabel
    {
        get
        {
            if ( ShowFakeLobbies ) return Tr( "{0} FOUND", 32 );
            if ( IsSearching ) return Tr( "SEARCHING" );
            return Tr( "{0} FOUND", FetchedLobbies.Count );
        }
    }

    private static int FillPercent( Lobby lobby )
    {
        if ( lobby.MaxMembers <= 0 ) return 0;
        return Math.Clamp( lobby.Members * 100 / lobby.MaxMembers, 0, 100 );
    }

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( firstTime )
        {
            FetchLobbies();
        }
    }

    private void OnSelected( Lobby lobby )
    {
        CurrentLobby = CurrentLobby.Equals( lobby ) ? null : lobby;
        StateHasChanged();
    }

    private bool IsEditorLobby( LobbyInformation lobby )
    {
        if ( Game.IsEditor ) return false;
        return lobby.IsEditorLobby();
    }

    protected async void FetchLobbies()
    {
        IsSearching = true;
        FetchedLobbies = new();
        StateHasChanged();

        var lobbies = await Networking.QueryLobbies( Game.Ident );

        IsSearching = false;
        FetchedLobbies = lobbies.Where( x => !IsEditorLobby( x ) ).ToList();
        StateHasChanged();
    }

    public void Refresh()
    {
        CurrentLobby = null;
        StateHasChanged();
        FetchLobbies();
    }
}
