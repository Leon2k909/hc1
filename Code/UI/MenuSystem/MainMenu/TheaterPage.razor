@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using System.Linq;
@using System.Collections.Generic;

@inherits Panel
@implements INavigatorPage
@attribute [StyleSheet]
@namespace Facepunch.UI

<root class="hc1 theater-page">
    <MenuTopbar Title="THEATER" />

    <div class="theater-content">
        <div class="movie-list">
        @if ( Replays.Count == 0 )
        {
            <div class="empty-state">
                <label>No replays found. Play a match to record one!</label>
            </div>
        }
        else
        {
            @foreach ( var replay in Replays )
            {
                <div class="movie-card">
                    <div class="movie-info" onclick=@(() => PlayReplay(replay.Path))>
                        <label class="movie-name">@replay.Name</label>
                        <label class="movie-date">@replay.Date</label>
                    </div>
                    <div class="movie-play" onclick=@(() => PlayReplay(replay.Path))>
                        <i>play_arrow</i>
                    </div>
                    <div class="movie-delete" onclick=@(() => DeleteReplay(replay.Path))>
                        <i>delete</i>
                    </div>
                </div>
            }
        }
        </div>
    </div>
</root>

@code
{
    public void OnNavigationOpen()  => MainMenuRoot.Instance?.SetActiveRoute( "/theater" );
    public void OnNavigationClose() { }

    struct ReplayInfo
    {
        public string Name;
        public string Path;
        public string Date;
    }

    private List<ReplayInfo> Replays = new();

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( firstTime )
        {
            RefreshReplays();
        }
    }

    void RefreshReplays()
    {
        Replays.Clear();

        if ( FileSystem.Data.DirectoryExists( "replays" ) )
        {
            var files = FileSystem.Data.FindFile( "replays", "*.movie" ).ToList();
            
            // Auto-expire clips older than 7 days
            foreach ( var file in files )
            {
                var nameParts = file.Replace( ".movie", "" ).Split('_');
                if ( nameParts.Length >= 3 )
                {
                    string dateStr = $"{nameParts[nameParts.Length-2]}_{nameParts[nameParts.Length-1]}";
                    if ( System.DateTime.TryParseExact( dateStr, "yyyyMMdd_HHmmss", null, System.Globalization.DateTimeStyles.None, out var date ) )
                    {
                        if ( (System.DateTime.Now - date).TotalDays > 7 )
                        {
                            FileSystem.Data.DeleteFile( $"replays/{file}" );
                            continue;
                        }
                    }
                }
            }
        }

        LoadReplays();
    }

    void LoadReplays()
    {
        Replays.Clear();

        if ( FileSystem.Data.DirectoryExists( "replays" ) )
        {
            var files = FileSystem.Data.FindFile( "replays", "*.movie" ).ToList();

            foreach ( var file in files.OrderByDescending(x => x) )
            {
                var nameParts = file.Replace( ".movie", "" ).Split('_');
                string dateStr = "Unknown Date";
                if (nameParts.Length >= 3) {
                    dateStr = $"{nameParts[nameParts.Length-2]} {nameParts[nameParts.Length-1].Substring(0,2)}:{nameParts[nameParts.Length-1].Substring(2,2)}";
                }

                Replays.Add( new ReplayInfo
                {
                    Name = nameParts[0].Replace( "_", " " ),
                    Path = $"replays/{file}",
                    Date = dateStr
                });
            }
        }
        StateHasChanged();
    }

    void DeleteReplay( string path )
    {
        if ( FileSystem.Data.FileExists( path ) )
        {
            FileSystem.Data.DeleteFile( path );
            LoadReplays();
        }
    }

    void PlayReplay( string path )
    {
        // Store path so the theater scene can load it
        Game.Cookies.Set( "theater_replay_path", path );
        
        var scene = ResourceLibrary.Get<SceneFile>( "scenes/theater_playback.scene" );
        if ( scene != null )
        {
            Game.ActiveScene.Load( scene );
        }
    }
}
