@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;
@using System.Linq;
@using System.Collections.Generic;

@inherits Panel
@implements INavigatorPage
@attribute [StyleSheet]
@namespace Facepunch.UI

@* The saved replays (TheaterReplays), laid out like SESSIONS' server browser. Watching one loads theater_playback.scene. *@
<root class="hc1 theater-page">
    <MenuTopbar Title="THEATER" />

    <div class="th-body">
        <div class="th-head">
            <div class="th-accent"></div>
            <label class="th-heading">@Tr( "REPLAYS" )</label>
            <div class="th-head-fill"></div>
            @if ( MatchRecorder.RecordingOff )
            {
                <label class="th-off">@Tr( "Theater Recording is off in the settings" )</label>
            }
            <label class="th-count">@CountLabel</label>
        </div>

        <div class="th-panels">
            <div class="th-list">
                <div class="th-panel-head">
                    <label class="th-col-map">@Tr( "Map" )</label>
                    <label class="th-col-mode">@Tr( "Mode" )</label>
                    <label class="th-col-date">@Tr( "Recorded" )</label>
                    <label class="th-col-length">@Tr( "Length" )</label>
                </div>

                <div class="th-rows">
                    @if ( Replays.Count == 0 )
                    {
                        <div class="th-state">
                            <i>movie</i>
                            <label class="th-state-text">@Tr( "No replays found. Play a match to record one!" )</label>
                        </div>
                    }
                    else
                    {
                        @foreach ( var replay in Replays )
                        {
                            <div class="th-row @(replay.Id == SelectedId ? "selected" : "")" onclick=@(() => Select( replay.Id ))>
                                <label class="th-col-map">@replay.Info.MapTitle</label>
                                <label class="th-col-mode">@ModeName( replay.Info )</label>
                                <label class="th-col-date">@DateLabel( replay.Info )</label>
                                <label class="th-col-length">@TheaterOverlay.FormatTime( replay.Info.Duration )</label>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="th-detail @(Selected is null ? "empty" : "")">
                <div class="th-panel-head">
                    <label>@Tr( "Replay Details" )</label>
                </div>

                @if ( Selected is { } selected )
                {
                    <div class="th-detail-body">
                        <label class="th-detail-name">@selected.Info.MapTitle</label>
                        <div class="th-stat"><label class="th-stat-key">@Tr( "Mode" )</label><label class="th-stat-value">@ModeName( selected.Info )</label></div>
                        <div class="th-stat"><label class="th-stat-key">@Tr( "Recorded" )</label><label class="th-stat-value">@DateLabel( selected.Info )</label></div>
                        <div class="th-stat"><label class="th-stat-key">@Tr( "Length" )</label><label class="th-stat-value">@TheaterOverlay.FormatTime( selected.Info.Duration )</label></div>
                        <div class="th-stat"><label class="th-stat-key">@Tr( "Players" )</label><label class="th-stat-value">@CountPeople( selected.Info, false )</label></div>
                        <div class="th-stat"><label class="th-stat-key">@Tr( "Bots" )</label><label class="th-stat-value">@CountPeople( selected.Info, true )</label></div>
                        <label class="th-note">@Tr( "The newest {0} replays are kept, for {1} days.", TheaterReplays.MaxReplays, TheaterReplays.MaxAgeDays )</label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="th-footer">
        <div class="th-action @(Selected is null ? "disabled" : "")" onclick=@DeleteSelected><i>delete</i><label>@Tr( "Delete" )</label></div>
        <div class="th-action primary @(Selected is null ? "disabled" : "")" onclick=@WatchSelected><i>play_arrow</i><label>@Tr( "Watch Replay" )</label></div>
    </div>
</root>

@code
{
    public void OnNavigationOpen() => MainMenuRoot.Instance?.SetActiveRoute( "/theater" );
    public void OnNavigationClose() { }

    List<TheaterReplays.Entry> Replays = new();
    string SelectedId;

    TheaterReplays.Entry Selected => Replays.FirstOrDefault( x => x.Id == SelectedId );

    string CountLabel => Tr( "Saved: {0} / {1}", Replays.Count, TheaterReplays.MaxReplays );

    protected override void OnAfterTreeRender( bool firstTime )
    {
        if ( firstTime )
            Refresh();
    }

    void Refresh()
    {
        TheaterReplays.Prune();
        Replays = TheaterReplays.List();

        if ( Selected is null )
            SelectedId = Replays.FirstOrDefault()?.Id;

        StateHasChanged();
    }

    void Select( string id )
    {
        SelectedId = id;
        StateHasChanged();
    }

    void WatchSelected()
    {
        if ( Selected is not { } replay )
            return;

        Game.Cookies.Set( TheaterController.ReplayCookie, replay.Id );

        var scene = ResourceLibrary.Get<SceneFile>( "scenes/theater_playback.scene" );
        if ( scene is not null )
            Game.ActiveScene.Load( scene );
    }

    void DeleteSelected()
    {
        if ( Selected is not { } replay )
            return;

        DialogModal.Show( Tr( "Delete this replay?" ), Tr( "Delete" ), Tr( "Cancel" ), () =>
        {
            TheaterReplays.Delete( replay.Id );
            SelectedId = null;
            Refresh();
        } );
    }

    string ModeName( TheaterReplays.Info info ) => string.IsNullOrWhiteSpace( info.Mode ) ? "" : Tr( info.Mode );

    static string DateLabel( TheaterReplays.Info info ) => info.Recorded.ToString( "yyyy-MM-dd HH:mm" );

    /// <summary> People, not lives: a bot that died five times is one bot. </summary>
    static int CountPeople( TheaterReplays.Info info, bool bots ) =>
        info.Soldiers?.Where( x => x.Bot == bots ).Select( x => x.Name ).Distinct().Count() ?? 0;

    protected override int BuildHash() => HashCode.Combine( Replays.Count, SelectedId, MatchRecorder.RecordingOff );
}
