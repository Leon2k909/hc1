@using Sandbox;
@using Sandbox.UI;

@namespace Facepunch.UI
@inherits Panel
@attribute [StyleSheet]

<root class="hc1 bug-report-root">
    @if ( IsOpen )
    {
        <div class="br-backdrop" onclick=@((e) => { e.StopPropagation(); Close(); }) />

        <div class="br-modal">
            <div class="br-topbar" />

            <div class="br-head">
                <label class="br-title">@Tr( "Report a Bug" )</label>
                <div class="br-close" onclick=@Close><i>close</i></div>
            </div>

            @if ( IsAdmin )
            {
                <div class="br-tabs">
                    <div class="br-tab @(CurrentTab == "report" ? "active" : "")" onclick=@(() => SetTab( "report" ))>
                        <label>Report Bug</label>
                    </div>
                    <div class="br-tab @(CurrentTab == "view" ? "active" : "")" onclick=@(() => SetTab( "view" ))>
                        <label>Submitted Reports</label>
                        <label class="br-badge">ADMIN</label>
                    </div>
                </div>
            }

            @if ( CurrentTab == "view" && IsAdmin )
            {
                var reports = GetReports().ToList();
                <div class="br-list">
                    @if ( reports.Count == 0 )
                    {
                        <label class="br-empty">No bug reports yet.</label>
                    }
                    @foreach ( var r in reports )
                    {
                        <div class="br-entry">
                            <div class="br-entry-head">
                                <label class="br-entry-title">@r.Title</label>
                                <label class="br-entry-category">@r.Category</label>
                                <label class="br-entry-time">@r.Time</label>
                            </div>
                            @if ( !string.IsNullOrWhiteSpace( r.Body ) )
                            {
                                <label class="br-entry-body">@r.Body</label>
                            }
                        </div>
                    }
                </div>
                <div class="br-foot">
                    <div class="br-btn" onclick=@Close><label>Close</label></div>
                </div>
            }
            else
            {
                <label class="br-section">@Tr( "Title" )</label>
                <TextEntry @ref=TitleEntry class=@(_titleMissing ? "br-input missing" : "br-input") Placeholder=@(Tr( "Short description..." )) />

                <label class="br-section">@Tr( "Category" )</label>
                <div class="br-categories">
                    @foreach ( var cat in Categories )
                    {
                        var capturedCat = cat;
                        <div class="br-category @(SelectedCategory == capturedCat ? "selected" : "")" onclick=@(() => PickCategory( capturedCat ))>
                            <i>@CategoryIcon( capturedCat )</i>
                            <label>@CategoryTitle( capturedCat )</label>
                        </div>
                    }
                </div>

                <label class="br-section">@Tr( "Description" )</label>
                <TextEntry @ref=BodyEntry class="br-input multiline" Multiline=@true Placeholder=@(Tr( "Detailed description..." )) />

                <div class="br-foot">
                    <div class="br-btn" onclick=@Close><label>@Tr( "Cancel" )</label></div>
                    <div class="br-btn primary" onclick=@Submit><i>send</i><label>@Tr( "Submit" )</label></div>
                </div>
            }
        </div>
    }
</root>

@code
{
    private const ulong AdminSteamId = 76561198271608270UL;
    // In English, since the report saves them; the buttons show them through Tr.
    private static readonly string[] Categories = { "Crash", "UI", "Gameplay", "Network", "Other" };

    // Other languages don't abbreviate "UI", so they look it up by its full name.
    private static string CategoryTitle( string category ) => category == "UI" && !GameText.IsEnglish ? Tr( "User interface" ) : Tr( category );

    public bool IsOpen { get; private set; }

    private ulong LocalSteamId => Client.Local.IsValid() ? Client.Local.SteamId : (Connection.Local?.SteamId ?? 0UL);
    private bool IsAdmin => LocalSteamId == AdminSteamId;

    private string CurrentTab { get; set; } = "report";

    private TextEntry TitleEntry { get; set; }
    private TextEntry BodyEntry { get; set; }
    private string SelectedCategory { get; set; } = "Other";

    /// <summary> Submit was pressed with no title: the title box is outlined red until something's typed in it. </summary>
    private bool _titleMissing;

    private static string CategoryIcon( string category ) => category switch
    {
        "Crash" => "error",
        "UI" => "web",
        "Gameplay" => "videogame_asset",
        "Network" => "wifi",
        _ => "more_horiz"
    };

    public void Open()
    {
        IsOpen = true;
        CurrentTab = "report";
        _titleMissing = false;
        // A root's class="@(...)" adds the class but never takes it off again, so it's set here.
        SetClass( "open", true );
        StateHasChanged();
    }

    /// <summary>
    /// Also Escape's, from MainMenuRoot: a panel's Tick is too late to see Escape. Over a match the pause menu takes
    /// Escape and closes with the report in it.
    /// </summary>
    public void Close()
    {
        IsOpen = false;
        SelectedCategory = "Other";
        _titleMissing = false;
        if ( TitleEntry.IsValid() ) TitleEntry.Value = "";
        if ( BodyEntry.IsValid() ) BodyEntry.Value = "";
        SetClass( "open", false );
        StateHasChanged();
    }

    private void SetTab( string tab )
    {
        if ( CurrentTab == tab ) return;
        Sound.Play( "ui_button_press" );
        CurrentTab = tab;
        StateHasChanged();
    }

    private void PickCategory( string category )
    {
        Sound.Play( "ui_button_press" );
        SelectedCategory = category;
        StateHasChanged();
    }

    public override void Tick()
    {
        base.Tick();
        if ( !IsOpen ) return;

        if ( _titleMissing && TitleEntry.IsValid() && !string.IsNullOrWhiteSpace( TitleEntry.Value ) )
        {
            _titleMissing = false;
            StateHasChanged();
        }
    }

    private void Submit()
    {
        var title = (TitleEntry.IsValid() ? TitleEntry.Value : "").Trim();
        var body  = (BodyEntry.IsValid()  ? BodyEntry.Value  : "").Trim();

        if ( string.IsNullOrEmpty( title ) )
        {
            _titleMissing = true;
            StateHasChanged();
            return;
        }

        var countRaw = Game.Cookies.Get( "hc1.bug.count", "0" );
        var count = int.TryParse( countRaw, out var n ) ? n : 0;

        Game.Cookies.Set( $"hc1.bug.{count}.title",    title );
        Game.Cookies.Set( $"hc1.bug.{count}.category", SelectedCategory );
        Game.Cookies.Set( $"hc1.bug.{count}.body",     body );
        Game.Cookies.Set( $"hc1.bug.{count}.time",     DateTime.UtcNow.ToString( "yyyy-MM-dd HH:mm" ) );
        Game.Cookies.Set( "hc1.bug.count",              (count + 1).ToString() );

        Sound.Play( "ui_button_press" );
        Close();
    }

    private record BugReport( string Title, string Category, string Body, string Time );

    private IEnumerable<BugReport> GetReports()
    {
        var countRaw = Game.Cookies.Get( "hc1.bug.count", "0" );
        if ( !int.TryParse( countRaw, out var total ) || total <= 0 )
            yield break;

        for ( int i = total - 1; i >= 0; i-- )
        {
            yield return new BugReport(
                Game.Cookies.Get( $"hc1.bug.{i}.title",    "" ),
                Game.Cookies.Get( $"hc1.bug.{i}.category", "" ),
                Game.Cookies.Get( $"hc1.bug.{i}.body",     "" ),
                Game.Cookies.Get( $"hc1.bug.{i}.time",     "" )
            );
        }
    }

    protected override int BuildHash() => HashCode.Combine( IsOpen, SelectedCategory, CurrentTab, IsAdmin, _titleMissing );
}
