@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@attribute [StyleSheet]
@namespace Facepunch.UI

<root class="hc1 hub-page">
    <div class="hub-container">
        <div class="hub-cards">

            <div class="hub-card locked" onmouseover=@PlayHoverSound>
                <div class="hub-bg campaign-bg"></div>
                <div class="hub-content">
                    <label class="hub-mode">SINGLEPLAYER</label>
                    <label class="hub-title">CAMPAIGN</label>
                    <label class="hub-desc">COMING SOON</label>
                </div>
            </div>

            <a class="hub-card main-card" href="/multiplayer" onmouseover=@PlayHoverSound>
                <div class="hub-bg multiplayer-bg"></div>
                <div class="hub-content">
                    <label class="hub-mode">COMPETITIVE</label>
                    <label class="hub-title">MULTIPLAYER</label>
                    <label class="hub-desc">PLAY NOW</label>
                </div>
            </a>

            <div class="hub-card locked" onmouseover=@PlayHoverSound>
                <div class="hub-bg br-bg"></div>
                <div class="hub-content">
                    <label class="hub-mode">WARZONE</label>
                    <label class="hub-title">BATTLE ROYALE</label>
                    <label class="hub-desc">COMING SOON</label>
                </div>
            </div>

            <div class="hub-card zombies-card" onclick=@PlayZombies onmouseover=@PlayHoverSound>
                <div class="hub-bg zombies-bg"></div>
                <div class="hub-content">
                    <label class="hub-mode">CO-OP</label>
                    <label class="hub-title">ZOMBIES</label>
                    <label class="hub-desc">PLAY NOW</label>
                </div>
            </div>

        </div>
    </div>

    @if ( _pickingZombiesMap )
    {
        <div class="map-picker">
            <div class="map-picker-backdrop" onclick=@CloseMapPicker />
            <div class="map-picker-panel">
                <div class="map-picker-header">
                    <div class="map-picker-heading">
                        <label class="kicker">CO-OP · ZOMBIES</label>
                        <label class="map-picker-title">SELECT MAP</label>
                    </div>
                    <div class="map-picker-close" onclick=@CloseMapPicker>
                        <i>close</i>
                    </div>
                </div>

                <div class="map-grid">
                    @foreach ( var map in ZombiesMaps() )
                    {
                        var image = map.GetMetadata( "Image", "" );
                        <div class="map-card" onclick=@(() => LaunchZombies( map ))>
                            @if ( string.IsNullOrWhiteSpace( image ) )
                            {
                                <div class="map-img placeholder"><i>landscape</i></div>
                            }
                            else
                            {
                                <img class="map-img" src="@image" />
                            }
                            <div class="map-shade" />
                            <label class="map-name">@map.GetMetadata( "Title", map.ResourceName ).ToUpper()</label>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</root>

@code
{
    bool _pickingZombiesMap;

    public void OnNavigationOpen()  => MainMenuRoot.Instance?.SetActiveRoute( "/" );
    public void OnNavigationClose() { }

    void PlayHoverSound() => Sound.Play( "ui.button.over" );

    static GameMode ZombiesMode() => GameObject.GetPrefab( "prefabs/game_modes/zombies.prefab" )?.GetComponent<GameMode>();

    /// <summary>Match maps that can host Zombies, Flatgrass first since it was the original.</summary>
    static List<SceneFile> ZombiesMaps()
    {
        var mode = ZombiesMode();
        if ( !mode.IsValid() ) return new();

        return GameUtils.GetMatchMaps()
            .Where( m => GameMode.GetAll( m ).Any( x => x.Ident == mode.Ident ) )
            .OrderByDescending( m => m.ResourcePath?.Contains( "flatgrass", StringComparison.OrdinalIgnoreCase ) ?? false )
            .ToList();
    }

    void PlayZombies()
    {
        var maps = ZombiesMaps();
        if ( maps.Count == 0 ) return;

        // Only ask when there's a choice to make.
        if ( maps.Count == 1 )
        {
            LaunchZombies( maps[0] );
            return;
        }

        _pickingZombiesMap = true;
        StateHasChanged();
    }

    void CloseMapPicker()
    {
        _pickingZombiesMap = false;
        StateHasChanged();
    }

    void LaunchZombies( SceneFile map )
    {
        var mode = ZombiesMode();
        if ( !mode.IsValid() || map is null ) return;

        _pickingZombiesMap = false;
        GameMode.SetCurrent( mode );
        GameMode.SetHardcore( false );
        Game.ActiveScene.Load( map );
    }
}
