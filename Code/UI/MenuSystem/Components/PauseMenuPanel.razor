@namespace Facepunch.UI
@attribute [StyleSheet]
@inherits PanelComponent

<root class="@(IsOpen ? "open" : "")">
    <PauseMenuRoot />
</root>

@code
{
    public static bool IsAnyOpen => Game.ActiveScene.IsValid() && Game.ActiveScene.GetAllComponents<PauseMenuPanel>().Any( x => x.IsValid() && x.Enabled && x.IsOpen );
    private static PauseMenuPanel Instance { get; set; }

    private bool IsOpen = false;

    protected override void OnStart()
    {
        base.OnStart();
        Instance = this;
    }

    public static void CloseAny()
    {
        Instance?.Close();
    }

    private void Close()
    {
        IsOpen = false;
        StateHasChanged();
    }

    protected override void OnUpdate()
    {
        if ( Input.EscapePressed )
        {
            Input.EscapePressed = false;
            IsOpen = !IsOpen;
            StateHasChanged();
        }
    }

    protected override void OnDisabled()
    {
        base.OnDisabled();
    }

    protected override void OnDestroy()
    {
        base.OnDestroy();
        if ( Instance == this )
            Instance = null;
    }
}
