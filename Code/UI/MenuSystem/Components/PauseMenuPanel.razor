@namespace Facepunch.UI
@attribute [StyleSheet]
@inherits PanelComponent

<root class="@(IsOpen ? "open" : "")">
    <PauseMenuRoot @ref="MenuRoot" />
</root>

@code
{
    public static bool IsAnyOpen =>
        (Instance is not null && Instance.IsValid() && Instance.Enabled && Instance.IsOpen)
        || (Game.ActiveScene.IsValid() && Game.ActiveScene.GetAllComponents<PauseMenuPanel>().Any( x => x.IsValid() && x.Enabled && x.IsOpen ));

    private static PauseMenuPanel Instance { get; set; }

    /// <summary>
    /// The pause menu's screen panel draws over every other one, the map vote's (999, MapVoteSystem) included. The
    /// prefabs gave it 999 too, and on a tie the panel made later (the vote) drew on top of the menu.
    /// </summary>
    public const int ScreenZIndex = 1000;

    private bool IsOpen = false;
    private PauseMenuRoot MenuRoot { get; set; }

    protected override void OnStart()
    {
        base.OnStart();
        Instance = this;

        if ( Components.GetInAncestorsOrSelf<ScreenPanel>() is { } screenPanel )
            screenPanel.ZIndex = ScreenZIndex;
    }

    public static void CloseAny()
    {
        Instance?.Close();
    }

    public static void ToggleAny()
    {
        if ( Instance is null || !Instance.IsValid() || !Instance.Enabled )
        {
            var pauseObject = Game.ActiveScene.CreateObject();
            pauseObject.Name = "PauseMenu";
            Instance = pauseObject.Components.Create<PauseMenuPanel>();
            pauseObject.Components.Create<ScreenPanel>().ZIndex = ScreenZIndex;
        }

        if ( Instance.IsOpen && Instance.MenuRoot?.CloseSocialPopup() == true ) return;

        Instance.SetOpen( !Instance.IsOpen );
    }

    private void SetOpen( bool open )
    {
        if ( IsOpen == open ) return;

        IsOpen = open;
        ZombiesRoundSystem.Current?.SetPausedFromMenu( open );
        StateHasChanged();
    }

    private void Close()
    {
        MenuRoot?.CloseSocialPopup();
        SetOpen( false );
    }

    protected override void OnUpdate()
    {
        if ( Input.EscapePressed )
        {
            Input.EscapePressed = false;
            if ( !LanguageMenu.CloseAny() && !GunsmithPanel.HandleEscapeAny()
                && !(IsOpen && MenuRoot?.CloseSocialPopup() == true) )
                SetOpen( !IsOpen );
        }
    }

    protected override void OnDisabled()
    {
        base.OnDisabled();
    }

    protected override void OnDestroy()
    {
        if ( IsOpen )
            ZombiesRoundSystem.Current?.SetPausedFromMenu( false );

        base.OnDestroy();
        if ( Instance == this )
            Instance = null;
    }
}
