@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@namespace Facepunch.UI
@attribute [StyleSheet]

<BugReportPanel @ref=BugReportPanelRef />

<root class="pause-page">
    <div class="pause-side">
        <div class="pause-head">
            <div class="pause-accent"></div>
            <label class="pause-title">PAUSED</label>
        </div>

        <div class="pause-items">
            <div class="pause-item primary" onclick=@(()=>PauseMenuPanel.CloseAny())><i>play_arrow</i><label>Resume</label></div>
            <div class="pause-item" onclick=@(()=>OpenGunsmith())><i>build</i><label>Gunsmith</label></div>
            <a class="pause-item" href="/settings"><i>settings</i><label>Settings</label></a>
            <div class="pause-item" onclick=@(()=>ReportBug())><i>bug_report</i><label>Report a Bug</label></div>

            <div class="pause-sep"></div>

            <div class="pause-item warn" onclick=@(()=>HandleDisconnect())><i>logout</i><label>Leave Match</label></div>
            <div class="pause-item warn" onclick=@(()=>Quit())><i>power_settings_new</i><label>Quit to Desktop</label></div>
        </div>
    </div>

    @if ( showPartyModal )
    {
        <div class="pause-modal-overlay">
            <div class="pause-modal">
                <label class="pause-modal-title">LEAVE MATCH</label>
                <label class="pause-modal-text">Do you want to bring your party members with you?</label>
                <div class="pause-item primary" @onclick=@BringParty><i>group</i><label>Bring Party</label></div>
                <div class="pause-item" @onclick=@LeaveAlone><i>person</i><label>Leave Alone</label></div>
                <div class="pause-item" @onclick=@(() => showPartyModal = false)><i>close</i><label>Cancel</label></div>
            </div>
        </div>
    }
</root>

@code
{
    bool showPartyModal = false;

    void HandleDisconnect()
    {
        if ( PartySystem.Current != null && PartySystem.Current.LocalIsLeader && PartySystem.Current.MemberIds.Count > 1 )
        {
            showPartyModal = true;
        }
        else
        {
            GameUtils.ReturnToMainMenu();
        }
    }

    void BringParty()
    {
        PartySystem.Current?.PullParty();
        showPartyModal = false;
    }

    void LeaveAlone()
    {
        GameUtils.ReturnToMainMenu();
        showPartyModal = false;
    }

    private BugReportPanel BugReportPanelRef { get; set; }

    void ReportBug() => BugReportPanelRef?.Open();

    void OpenGunsmith()
    {
        var studio = Scene.GetAllObjects( true ).FirstOrDefault( x => x.Name == "GunsmithStudio" );
        if ( !studio.IsValid() )
        {
            studio = GameObject.Clone( "prefabs/gunsmith_studio.prefab" );
            studio.Name = "GunsmithStudio";
        }

        PauseMenuPanel.CloseAny();
    }

    void Quit()
    {
        Game.Close();
    }
}
