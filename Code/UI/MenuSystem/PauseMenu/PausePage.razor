@using Sandbox;
@using Sandbox.UI;
@using Sandbox.UI.Navigation;

@inherits Panel
@implements INavigatorPage
@namespace Facepunch.UI

<BugReportPanel @ref=BugReportPanelRef />

<root class="hc1" style="width: 100%; height: 100%; justify-content: center; align-items: center;">
    <div class="inset column layout with-background" style="width: 320px;">
        <VerticalDivider />
        <div class="layout padding-extra with-gap column">
            <a class="button standard" onclick=@(()=>HandleDisconnect())><i>play_circle_outline</i>Disconnect</a>

            <div class="button standard" onclick=@(()=>OpenGunsmith())>
                <i>build</i>
                Gunsmith
            </div>

            <a class="button standard" href="/settings">
                <i>settings</i>
                Settings
            </a>

            <div class="button standard" onclick=@(()=>ReportBug())>
                <i>bug_report</i>
                Report a Bug
            </div>

            <div class="button standard" onclick=@(()=>Quit())>
                <i>power_settings_new</i>
                Quit
            </div>
        </div>

        <VerticalDivider />
    </div>

    @if ( showPartyModal )
    {
        <div class="modal-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 100;">
            <div class="modal-content" style="background: #1e1e1e; padding: 24px; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; display: flex; flex-direction: column; gap: 16px; min-width: 300px;">
                <h2 style="margin: 0; font-size: 20px; font-weight: bold; color: white;">Leave Game</h2>
                <p style="margin: 0; font-size: 14px; color: rgba(255,255,255,0.7);">Do you want to bring your party members with you?</p>
                <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                    <button class="button standard" style="background: rgba(88,119,224,0.3); border: 1px solid rgba(88,119,224,0.5);" @onclick=@BringParty>Bring Party</button>
                    <button class="button standard" @onclick=@LeaveAlone>Leave Alone</button>
                    <button class="button standard" style="opacity: 0.7;" @onclick=@(() => showPartyModal = false)>Cancel</button>
                </div>
            </div>
        </div>
    }
</root>

@code
{
    bool showPartyModal = false;

    void HandleDisconnect()
    {
        if ( PartySystem.Current != null && PartySystem.Current.LocalIsLeader && PartySystem.Current.MemberIds.Count > 1 )
        {
            showPartyModal = true;
        }
        else
        {
            GameUtils.ReturnToMainMenu();
        }
    }

    void BringParty()
    {
        PartySystem.Current?.PullParty();
        showPartyModal = false;
    }

    void LeaveAlone()
    {
        GameUtils.ReturnToMainMenu();
        showPartyModal = false;
    }

    private BugReportPanel BugReportPanelRef { get; set; }

    void ReportBug() => BugReportPanelRef?.Open();

    void OpenGunsmith()
    {
        var studio = Scene.GetAllObjects( true ).FirstOrDefault( x => x.Name == "GunsmithStudio" );
        if ( !studio.IsValid() )
        {
            studio = GameObject.Clone( "prefabs/gunsmith_studio.prefab" );
            studio.Name = "GunsmithStudio";
        }

        PauseMenuPanel.CloseAny();
    }

    void Quit()
    {
        Game.Close();
    }
}
