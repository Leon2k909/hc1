@using Sandbox;
@using Sandbox.Network
@using Sandbox.UI;
@using System.Linq;

@namespace Facepunch.UI
@inherits PanelComponent
@attribute [StyleSheet]

<root class="hc1 private-lobby">
    <div class="lobby-container">
        
        @* ----- HOST SETTINGS PANEL ----- *@
        <div class="settings-panel">
            <label class="panel-title">@Tr( "Match Settings" )</label>

            @if ( Networking.IsHost )
            {
                <div class="setting-group">
                    <label>@Tr( "Map" )</label>
                    <div class="button-list">
                        @foreach ( var map in GameUtils.GetAvailableMaps() )
                        {
                            var isSelected = PregameLobbyManager.Instance?.SelectedMapPath == map.ResourcePath;
                            <div class="lobby-button @(isSelected ? "selected" : "")" onclick=@(() => PregameLobbyManager.Instance?.SetMap( map.ResourcePath ))>
                                @map.GetMetadata("Title", map.ResourceName)
                            </div>
                        }
                    </div>
                </div>

                @if ( PregameLobbyManager.Instance != null && !string.IsNullOrEmpty(PregameLobbyManager.Instance.SelectedMapPath) )
                {
                    var currentMap = ResourceLibrary.Get<SceneFile>(PregameLobbyManager.Instance.SelectedMapPath);
                    if ( currentMap != null )
                    {
                        <div class="setting-group">
                            <label>@Tr( "Game Mode" )</label>
                            <div class="button-list">
                                @foreach ( var mode in GameMode.GetAll( currentMap ) )
                                {
                                    var isSelected = PregameLobbyManager.Instance?.SelectedGameMode == mode.Ident;
                                    <div class="lobby-button @(isSelected ? "selected" : "")" onclick=@(() => PregameLobbyManager.Instance?.SetGameMode( mode.Ident ))>
                                        @Tr( mode.Title )
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                @* Core / Hardcore choice: Core modes are off for now, every match is hardcore. Put back with Core.
                <div class="setting-group">
                    <label>Rules</label>
                    <div class="button-list row">
                        <div class="lobby-button @(!(PregameLobbyManager.Instance?.IsHardcore ?? false) ? "selected" : "")" onclick=@(() => PregameLobbyManager.Instance?.SetHardcore( false ))>CORE</div>
                        <div class="lobby-button hc-toggle @((PregameLobbyManager.Instance?.IsHardcore ?? false) ? "selected" : "")" onclick=@(() => PregameLobbyManager.Instance?.SetHardcore( true ))>HARDCORE</div>
                    </div>
                </div>
                *@


                <div class="grow" />

                <div class="lobby-button primary" onclick=@(() => PregameLobbyManager.Instance?.StartMatch())>
                    @Tr( "START MATCH" )
                </div>
            }
            else
            {
                @if ( PregameLobbyManager.Instance != null && !string.IsNullOrEmpty(PregameLobbyManager.Instance.SelectedMapPath) )
                {
                    var map = ResourceLibrary.Get<SceneFile>(PregameLobbyManager.Instance.SelectedMapPath);
                    var mode = GameMode.GetAll( map ).FirstOrDefault(x => x.Ident == PregameLobbyManager.Instance.SelectedGameMode);
                    
                    <div class="setting-info">
                        <label class="info-label">@Tr( "Map:" )</label>
                        <label class="info-value">@(map?.GetMetadata("Title", map?.ResourceName))</label>
                    </div>
                    <div class="setting-info">
                        <label class="info-label">@Tr( "Mode:" )</label>
                        @* Put back with Core modes: @(mode?.Title) @(PregameLobbyManager.Instance.IsHardcore ? "(Hardcore)" : "") *@
                        <label class="info-value">@Tr( mode?.Title )</label>
                    </div>
                }

                <div class="grow" />
                <label class="waiting-label">@Tr( "Waiting for host to start..." )</label>
            }
        </div>

        @* ----- ROSTER PANEL ----- *@
        <div class="roster-panel">
            <label class="panel-title">@Tr( "Lobby Roster" )</label>

            <div class="teams-container">
                
                @* BLUE TEAM *@
                <div class="team-column">
                    <div class="team-header ct">
                        <label>@Tr( Team.CounterTerrorist.GetName() )</label>
                        <div class="lobby-button" onclick=@(() => Client.Local?.RequestTeam(Team.CounterTerrorist))>@Tr( "JOIN" )</div>
                    </div>
                    <div class="player-list">
                        @foreach ( var player in GameUtils.AllPlayers.Where( x => x.Team == Team.CounterTerrorist ) )
                        {
                            <div class="player-card">
                                <label>@player.DisplayName</label>
                            </div>
                        }
                    </div>
                </div>

                @* RED TEAM *@
                <div class="team-column">
                    <div class="team-header t">
                        <label>@Tr( Team.Terrorist.GetName() )</label>
                        <div class="lobby-button" onclick=@(() => Client.Local?.RequestTeam(Team.Terrorist))>@Tr( "JOIN" )</div>
                    </div>
                    <div class="player-list">
                        @foreach ( var player in GameUtils.AllPlayers.Where( x => x.Team == Team.Terrorist ) )
                        {
                            <div class="player-card">
                                <label>@player.DisplayName</label>
                            </div>
                        }
                    </div>
                </div>

                @* UNASSIGNED *@
                <div class="team-column">
                    <div class="team-header un">
                        <label>@Tr( "Spectators" )</label>
                        <div class="lobby-button" onclick=@(() => Client.Local?.RequestTeam(Team.Unassigned))>@Tr( "JOIN" )</div>
                    </div>
                    <div class="player-list">
                        @foreach ( var player in GameUtils.AllPlayers.Where( x => x.Team == Team.Unassigned ) )
                        {
                            <div class="player-card">
                                <label>@player.DisplayName</label>
                            </div>
                        }
                    </div>
                </div>

            </div>
            
            <div class="lobby-button" style="align-self: flex-end;" onclick=@(() => GameUtils.ReturnToMainMenu())>
                @Tr( "Leave Lobby" )
            </div>
        </div>

    </div>
</root>

@code
{
    protected override void OnUpdate()
    {
        base.OnUpdate();
        ResponsiveLayout.Update( Panel );
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( Networking.IsHost );
        
        if ( PregameLobbyManager.Instance != null )
        {
            hash.Add( PregameLobbyManager.Instance.SelectedMapPath );
            hash.Add( PregameLobbyManager.Instance.SelectedGameMode );
            hash.Add( PregameLobbyManager.Instance.IsHardcore );
        }

        foreach ( var player in GameUtils.AllPlayers )
        {
            hash.Add( player.SteamId );
            hash.Add( player.Team );
        }

        return hash.ToHashCode();
    }
}
