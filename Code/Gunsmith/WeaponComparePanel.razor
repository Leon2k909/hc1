@using Sandbox;
@using Sandbox.UI;
@using Facepunch;

@namespace Facepunch.Gunsmith
@inherits Panel

<root class="compare-panel">
    @* The gunsmith's WEAPON STATS: the real figures behind the bars (GunsmithStats), side by side with another weapon
       or with this one from the factory. Better values are green, worse red. As the gunsmith's DETAILS (Live) it's
       the build beside the factory gun, with no controls. *@
    @if ( !Live )
    {
    @* The YOUR BUILDS / FACTORY toggle is off for now (the user: your build is enough to compare), so Factory stays
       false. Put back with the factory toggle:
    <div class="wc-controls">
        <div class="wc-toggle">
            <div class="wc-toggle-opt @(Factory ? "" : "on")" onclick=@(() => SetFactory( false ))><label>@Tr( "YOUR BUILDS" )</label></div>
            <div class="wc-toggle-opt @(Factory ? "on" : "")" onclick=@(() => SetFactory( true ))><label>@Tr( "FACTORY" )</label></div>
        </div>
        <label class="wc-controls-hint">@Tr( Factory ? "No attachments, no tuning" : "Attachments as saved for each weapon, with tuning" )</label>
    </div>
    *@

    @* The left column: the build on the gun in the active class, or one of this weapon's saved builds. *@
    @if ( MyBuilds.Any() )
    {
        <label class="wc-label">@Tr( "YOUR BUILD" )</label>
        <div class="wc-chips">
            <div class="wc-chip mine @(MyBuild is null ? "on" : "")" onclick=@(() => PickMine( null ))><label>@Tr( "CURRENT BUILD" )</label></div>
            @foreach ( var build in MyBuilds )
            {
                var b = build;
                <div class="wc-chip mine @(b == MyBuild ? "on" : "")" onclick=@(() => PickMine( b ))><label>@b.Name</label></div>
            }
        </div>
    }

    <label class="wc-label">@Tr( "COMPARE WITH" )</label>
    <div class="wc-filters">
        <div class="wc-filter @(Filter is null && !BuildsTab ? "on" : "")" onclick=@(() => SetFilter( null ))><label>@Tr( "ALL" )</label></div>
        @foreach ( var category in Categories )
        {
            var c = category;
            <div class="wc-filter @(Filter == c && !BuildsTab ? "on" : "")" onclick=@(() => SetFilter( c ))><label>@Tr( CategoryLabel( c ) )</label></div>
        }
        @if ( _builds.Count > 0 )
        {
            <div class="wc-filter @(BuildsTab ? "on" : "")" onclick=@ShowBuilds><label>@Tr( "SAVED BUILDS" )</label></div>
        }
    </div>
    <div class="wc-chips">
        <div class="wc-chip @(Other is null && !VsFactory ? "on" : "")" onclick=@(() => Pick( null ))><label>@Tr( "NONE" )</label></div>
        @if ( !Factory )
        {
            <div class="wc-chip factory @(VsFactory ? "on" : "")" onclick=@PickFactory><label>@Tr( "FACTORY" )</label></div>
        }
        @if ( BuildsTab )
        {
            @* Every gun's saved builds, this one's too, so two builds of the same gun can go side by side. *@
            <div class="wc-chip build @(Other == Weapon && OtherBuild is null ? "on" : "")" onclick=@(() => PickCurrent( Weapon ))>
                <label class="wc-chip-build">@Tr( "CURRENT BUILD" )</label>
                <label class="wc-chip-gun">@Weapon?.Name.ToUpperInvariant()</label>
            </div>
            @foreach ( var build in _builds )
            {
                var b = build;
                <div class="wc-chip build @(b == OtherBuild ? "on" : "")" onclick=@(() => PickBuild( b ))>
                    <label class="wc-chip-build">@b.Name</label>
                    <label class="wc-chip-gun">@b.Weapon.Name.ToUpperInvariant()</label>
                </div>
            }
        }
        else
        {
            @* A gun's chip says how many saved builds it has; picking it lists them below. *@
            @foreach ( var weapon in Candidates.Where( x => Filter is null || x.Category == Filter ) )
            {
                var w = weapon;
                var count = BuildCount( w );
                <div class="wc-chip gun @(w == Other && !VsFactory ? "on" : "")" onclick=@(() => Pick( w ))>
                    <label>@w.Name.ToUpperInvariant()</label>
                    @if ( count > 0 )
                    {
                        <label class="wc-chip-count">@count</label>
                    }
                </div>
            }
        }
    </div>

    @* The compared gun's builds: the one on it in the active class, then its saved ones. *@
    @if ( !BuildsTab && !VsFactory && Other is not null )
    {
        <div class="wc-builds-head">
            <label class="wc-label">@Tr( "BUILDS" )</label>
            <label class="wc-builds-gun">@Other.Name.ToUpperInvariant()</label>
        </div>
        <div class="wc-chips">
            <div class="wc-chip @(OtherBuild is null ? "on" : "")" onclick=@(() => PickCurrent( Other ))><label>@Tr( "CURRENT BUILD" )</label></div>
            @foreach ( var build in _builds.Where( x => x.Weapon == Other ) )
            {
                var b = build;
                <div class="wc-chip @(b == OtherBuild ? "on" : "")" onclick=@(() => PickBuild( b ))><label>@b.Name</label></div>
            }
        </div>
        @if ( BuildCount( Other ) == 0 )
        {
            <label class="wc-builds-hint">@Tr( "No builds saved for this weapon yet." )</label>
        }
    }

    @if ( VsFactory )
    {
        <label class="wc-factory-hint">@Tr( "The factory gun: no attachments, no tuning" )</label>
    }
    }

    @if ( _mine.IsFirearm )
    {
        var theirs = (Live || VsFactory || Other is not null) && _theirs.IsFirearm ? _theirs : null;
        <div class="wc-table">
            <div class="wc-row wc-names">
                <label class="wc-name"></label>
                <div class="wc-val mine">
                    <label class="wc-gun">@(Live ? Tr( "BUILD" ) : Weapon.Name.ToUpperInvariant())</label>
                    @if ( !Live && BuildLine( MyBuild ) is { } mineBuild )
                    {
                        <label class="wc-build">@mineBuild</label>
                    }
                </div>
                @if ( theirs is not null )
                {
                    <div class="wc-val theirs">
                        <label class="wc-gun">@(Live || VsFactory ? Tr( "FACTORY" ) : Other.Name.ToUpperInvariant())</label>
                        @if ( !Live && !VsFactory && BuildLine( OtherBuild ) is { } theirsBuild )
                        {
                            <label class="wc-build">@theirsBuild</label>
                        }
                    </div>
                }
            </div>
            @foreach ( var row in Rows( _mine, theirs ) )
            {
                @if ( row.Section is not null )
                {
                    <label class="wc-section">@Tr( row.Section )</label>
                }
                else
                {
                    var verdict = Verdict( row, true, theirs is not null );
                    @* Live, the factory gun is only the yardstick: the build's figure and its row show the change. *@
                    <div class="wc-row @(Live ? verdict : "")">
                        <label class="wc-name">@(row.Raw ? row.Name : Tr( row.Name ))</label>
                        <label class="wc-val mine @verdict">@row.Mine</label>
                        @if ( theirs is not null )
                        {
                            <label class="wc-val theirs @Verdict( row, false, !Live )">@row.Theirs</label>
                        }
                    </div>
                }
            }
        </div>
        <label class="wc-note">@Tr( "HARDCORE HITS: THE HEAD OR NECK ALWAYS KILLS. A BODY HIT MAY KILL OUTRIGHT (THE CHANCE ABOVE), ELSE IT WOUNDS FOR 3× DAMAGE. A LIMB HIT DOES 1.7× DAMAGE, AT MOST HALF YOUR HEALTH. ALL WITHIN FULL DAMAGE RANGE." )</label>
    }
    else
    {
        <label class="wc-note">@Tr( "This equipment doesn't shoot, so it has no weapon stats." )</label>
    }
</root>

@code
{
    /// <summary> The gunsmith's weapon, the left column. </summary>
    public EquipmentResource Weapon { get; set; }

    /// <summary> The weapon compared with it, the right column; null for none. </summary>
    private EquipmentResource Other { get; set; }

    /// <summary> Compare the factory guns instead of the saved builds. </summary>
    private bool Factory { get; set; }

    /// <summary> The right column is this weapon from the factory, so it shows what the build changes. </summary>
    private bool VsFactory { get; set; }

    /// <summary>
    /// The gunsmith's DETAILS, beside its parts list: <see cref="Stats"/> against <see cref="FactoryStats"/>, which the
    /// gunsmith works out as parts go on and off, with no controls.
    /// </summary>
    public bool Live { get; set; }

    /// <summary> Live: the build's figures (GunsmithPanel's, so they change as soon as its bars do). </summary>
    public GunsmithStats Stats { get; set; }

    /// <summary> Live: the factory gun's. </summary>
    public GunsmithStats FactoryStats { get; set; }

    /// <summary> The last weapon compared with, and its saved build (null: the current one), so reopening the panel keeps them. </summary>
    private static string _lastOtherPath;
    private static string _lastOtherBuild;

    /// <summary> A saved build (<see cref="GunsmithPresets"/>): a weapon's build code under its Id and a name, unique for the weapon. </summary>
    private record Build( EquipmentResource Weapon, string Id, string Name, string Code );

    /// <summary> The left column's saved build; null for the build on the gun in the active class. </summary>
    private Build MyBuild { get; set; }

    /// <summary> The right column's saved build; null for <see cref="Other"/>'s build in the active class. </summary>
    private Build OtherBuild { get; set; }

    /// <summary> The COMPARE WITH list shows the saved builds instead of the weapons. </summary>
    private bool BuildsTab { get; set; }

    /// <summary> Every gun's saved builds, read again with the figures. </summary>
    private List<Build> _builds = new();
    private int _buildsKey;

    private IEnumerable<Build> MyBuilds => _builds.Where( x => x.Weapon == Weapon );

    /// <summary> The kind of gun the COMPARE WITH list shows; null for all of them. </summary>
    private WeaponCategory? Filter { get; set; }

    private GunsmithStats _mine = new();
    private GunsmithStats _theirs = new();
    private EquipmentResource _statsFor;
    private RealTimeSince _sinceStats;
    private List<EquipmentResource> _candidates;

    /// <summary> PlayerPawn's hit points, which the hardcore hits are counted against (HealthComponent.MaxHealth). </summary>
    private const float Health = 100f;

    private const float MetersPerUnit = 0.0254f;

    /// <summary> A section's title, or a figure's row. <paramref name="Raw"/> names aren't translated (distances). </summary>
    private record Row( string Section, string Name, string Mine, string Theirs, float MineValue, float TheirsValue, int Better, bool Raw = false );

    /// <summary> Every gun that goes in a primary or secondary slot, the gunsmith's own list. </summary>
    private List<EquipmentResource> Candidates => _candidates ??= ResourceLibrary.GetAll<EquipmentResource>()
        .Where( x => (x.Slot is EquipmentSlot.Primary or EquipmentSlot.Secondary) && x.ViewModelPrefab.IsValid() && x.MainPrefab.IsValid()
            && !GunsmithLoadoutManager.IsMergedWeaponResource( x ) && x.MainPrefab.GetComponentInChildren<Shootable>( true ).IsValid() )
        .OrderBy( x => x.Slot ).ThenBy( x => x.Category ).ThenBy( x => x.Name )
        .ToList();

    /// <summary> The filter chips: each kind of gun the list has, primaries first. </summary>
    private List<WeaponCategory> Categories => _categories ??= Candidates.Select( x => x.Category ).Distinct().ToList();
    private List<WeaponCategory> _categories;

    private static string CategoryLabel( WeaponCategory category ) => category switch
    {
        WeaponCategory.AssaultRifle => "ASSAULT RIFLES",
        WeaponCategory.SMG => "SMGS",
        WeaponCategory.LMG => "LMGS",
        WeaponCategory.Sniper => "SNIPER RIFLES",
        WeaponCategory.Marksman => "MARKSMAN RIFLES",
        WeaponCategory.Shotgun => "SHOTGUNS",
        WeaponCategory.Pistol => "PISTOLS",
        WeaponCategory.Launcher => "LAUNCHERS",
        _ => category.ToString().ToUpperInvariant(),
    };

    private void SetFilter( WeaponCategory? category )
    {
        Filter = category;
        BuildsTab = false;
        StateHasChanged();
    }

    private void ShowBuilds()
    {
        BuildsTab = true;
        StateHasChanged();
    }

    /// <summary>
    /// The saved builds of every gun in the list (the gunsmith's BUILDS), keeping each side's pick by its weapon and
    /// Id: a build renamed or saved over keeps its place, and one deleted goes back to the current build.
    /// </summary>
    private void RefreshBuilds()
    {
        var weapons = Weapon is not null && !Candidates.Contains( Weapon ) ? Candidates.Prepend( Weapon ) : Candidates;
        _builds = weapons
            .SelectMany( w => GunsmithPresets.Get( w ).Where( p => !string.IsNullOrWhiteSpace( p.Name ) && !string.IsNullOrWhiteSpace( p.Code ) )
                .Select( p => new Build( w, p.Id ?? p.Name, p.Name, p.Code ) ) )
            .ToList();
        _buildsKey = _builds.Aggregate( 17, ( hash, b ) => HashCode.Combine( hash, b.Weapon, b.Id, b.Name, b.Code ) );

        MyBuild = Find( MyBuild?.Weapon, MyBuild?.Id );
        OtherBuild = Find( OtherBuild?.Weapon, OtherBuild?.Id );
        if ( _builds.Count == 0 )
            BuildsTab = false;
    }

    private Build Find( EquipmentResource weapon, string id ) =>
        weapon is null || id is null ? null : _builds.FirstOrDefault( x => x.Weapon == weapon && x.Id == id );

    /// <summary>
    /// The line under a column's gun: its saved build's name, or CURRENT BUILD when either side is a saved build or
    /// both sides are this gun. Null when it's only guns side by side.
    /// </summary>
    private string BuildLine( Build build ) =>
        build is not null ? build.Name
        : MyBuild is not null || OtherBuild is not null || Other == Weapon
            || _builds.Any( x => x.Weapon == Weapon || x.Weapon == Other ) ? Tr( "CURRENT BUILD" )
        : null;

    private int BuildCount( EquipmentResource weapon ) => _builds.Count( x => x.Weapon == weapon );

    public override void Tick()
    {
        base.Tick();
        SetClass( "live", Live );

        if ( Live )
        {
            _mine = Stats ?? new GunsmithStats();
            _theirs = FactoryStats ?? new GunsmithStats();
            return;
        }

        if ( _statsFor != Weapon )
        {
            _statsFor = Weapon;
            VsFactory = false;
            MyBuild = null;
            OtherBuild = null;
            RefreshBuilds();
            (Other, OtherBuild) = PickDefault();
            // The list opens on the compared gun's kind (else this one's), so its chip and its builds are in view.
            BuildsTab = false;
            Filter = (Other ?? Weapon)?.Category;
            _sinceStats = 10f;
        }

        // The builds and tuning can change under the panel, so the figures are read again a few times a second.
        if ( _sinceStats < 0.5f )
            return;

        _sinceStats = 0f;
        RefreshBuilds();
        _mine = Weapon is null ? new GunsmithStats()
            : MyBuild is not null ? GunsmithStats.Compute( Weapon, MyBuild.Code )
            : GunsmithStats.Compute( Weapon, !Factory );
        _theirs = VsFactory && Weapon is not null ? GunsmithStats.Compute( Weapon, false )
            : Other is null ? new GunsmithStats()
            : OtherBuild is not null ? GunsmithStats.Compute( Other, OtherBuild.Code )
            : GunsmithStats.Compute( Other, !Factory );
    }

    /// <summary>
    /// The saved build compared last, if it's still there, else the weapon compared last, else another of the same
    /// kind (the RPK against the Kastovs), else none. Never this weapon's current build beside itself.
    /// </summary>
    private (EquipmentResource Weapon, Build Build) PickDefault()
    {
        var last = Candidates.FirstOrDefault( x => string.Equals( x.ResourcePath, _lastOtherPath, StringComparison.OrdinalIgnoreCase ) );
        if ( Find( last, _lastOtherBuild ) is { } saved )
            return (last, saved);

        var others = Candidates.Where( x => x != Weapon ).ToList();
        return (others.FirstOrDefault( x => x == last )
            ?? others.FirstOrDefault( x => x.Category == Weapon?.Category )
            ?? others.FirstOrDefault( x => x.Slot == Weapon?.Slot ), null);
    }

    /// <summary>
    /// The right column: <paramref name="weapon"/>'s build in the active class, whose saved builds then show below. This
    /// weapon starts on one of its saved builds other than the left column's, since its current build beside itself
    /// would show nothing.
    /// </summary>
    private void Pick( EquipmentResource weapon )
    {
        VsFactory = false;
        Other = weapon;
        OtherBuild = weapon is not null && weapon == Weapon ? MyBuilds.FirstOrDefault( x => x != MyBuild ) : null;
        Remember();
        _sinceStats = 10f;
        StateHasChanged();
    }

    /// <summary> The right column: a saved build of any gun, this one's included. </summary>
    private void PickBuild( Build build )
    {
        VsFactory = false;
        Other = build.Weapon;
        OtherBuild = build;
        Remember();
        _sinceStats = 10f;
        StateHasChanged();
    }

    /// <summary> The right column: <paramref name="weapon"/>'s build in the active class, not one of its saved builds. </summary>
    private void PickCurrent( EquipmentResource weapon )
    {
        VsFactory = false;
        Other = weapon;
        OtherBuild = null;
        Remember();
        _sinceStats = 10f;
        StateHasChanged();
    }

    /// <summary> The left column: one of this weapon's saved builds, or null for the current build. </summary>
    private void PickMine( Build build )
    {
        MyBuild = build;
        _sinceStats = 10f;
        StateHasChanged();
    }

    private void Remember()
    {
        _lastOtherPath = Other?.ResourcePath;
        _lastOtherBuild = OtherBuild?.Id;
    }

    private void PickFactory()
    {
        VsFactory = true;
        Other = null;
        OtherBuild = null;
        _sinceStats = 10f;
        StateHasChanged();
    }

    private void SetFactory( bool factory )
    {
        Factory = factory;
        // The factory gun beside itself would show nothing.
        if ( factory )
            VsFactory = false;
        _sinceStats = 10f;
        StateHasChanged();
    }

    private IEnumerable<Row> Rows( GunsmithStats a, GunsmithStats b )
    {
        yield return Section( "FIREPOWER" );
        yield return Compare( "DAMAGE", a, b, s => s.BulletDamage * s.Pellets, DamageText, 1 );
        yield return Compare( "FIRE RATE", a, b, s => s.Rpm, s => $"{s.Rpm:0} RPM", 1 );
        yield return Compare( "DAMAGE PER SECOND", a, b, Dps, s => $"{Dps( s ):0}", 1 );
        yield return Compare( "TIME TO EMPTY", a, b, EmptyTime, s => SecondsText( EmptyTime( s ) ), 0 );

        yield return Section( "HARDCORE HITS — UNARMORED / CLOSE RANGE" );
        yield return Compare( "HEAD HITS TO KILL", a, b, s => HeadHits( s ), s => HitsText( HeadHits( s ), s ), -1 );
        yield return Compare( "BODY HITS TO KILL", a, b, s => BodyHits( s ), s => HitsText( BodyHits( s ), s ), -1 );
        yield return Compare( "BODY TIME TO KILL", a, b, s => KillTime( BodyHits( s ), s ), s => KillTimeText( BodyHits( s ), s ), -1 );
        yield return Compare( "LIMB HITS TO KILL", a, b, s => LimbHits( s ), s => HitsText( LimbHits( s ), s ), -1 );
        yield return Compare( "LIMB TIME TO KILL", a, b, s => KillTime( LimbHits( s ), s ), s => KillTimeText( LimbHits( s ), s ), -1 );

        yield return Section( "DAMAGE BY RANGE" );
        yield return AtRange( 10, a, b, s => s.RangeDamage.At10 );
        yield return AtRange( 25, a, b, s => s.RangeDamage.At25 );
        yield return AtRange( 50, a, b, s => s.RangeDamage.At50 );
        yield return AtRange( 100, a, b, s => s.RangeDamage.At100 );
        yield return AtRange( 200, a, b, s => s.RangeDamage.At200 );

        yield return Section( "RANGE" );
        yield return Compare( "FULL DAMAGE RANGE", a, b, s => s.FullDamageRange ?? 100000f, s => s.FullDamageRange is { } m ? $"{m:0} M" : Tr( "NO FALLOFF" ), 1 );
        yield return Compare( "MUZZLE VELOCITY", a, b, s => s.MuzzleVelocity, s => s.MuzzleVelocity > 0f ? $"{s.MuzzleVelocity:0} M/S" : "-", 1 );

        yield return Section( "HANDLING" );
        yield return Compare( "AIM DOWN SIGHTS", a, b, s => s.AimTime, s => $"{s.AimTime * 1000f:0} MS", -1 );
        yield return Compare( "WEIGHT", a, b, s => s.Mass, s => s.Mass > 0f ? $"{s.Mass:0.00} KG" : "-", -1 );
        yield return Compare( "RELOAD", a, b, s => s.ReloadTime, s => ReloadText( s.ReloadTime, s ), -1 );
        yield return Compare( "EMPTY RELOAD", a, b, s => s.EmptyReloadTime, s => ReloadText( s.EmptyReloadTime, s ), -1 );
        yield return Compare( "RECOIL CONTROL", a, b, s => s.Control, s => s.ControlText, 1 );
        yield return Compare( "VERTICAL RECOIL", a, b, s => s.VerticalRecoil, s => $"{s.VerticalRecoil * 100f:0}", -1 );
        yield return Compare( "HORIZONTAL RECOIL", a, b, s => s.HorizontalRecoil, s => $"{s.HorizontalRecoil * 100f:0}", -1 );

        yield return Section( "MOBILITY" );
        yield return Compare( "WALK SPEED", a, b, s => s.WalkSpeedUnits, s => SpeedText( s.WalkSpeedUnits ), 1 );
        yield return Compare( "SPRINT SPEED", a, b, s => s.SprintSpeedUnits, s => SpeedText( s.SprintSpeedUnits ), 1 );
        yield return Compare( "CROUCH SPEED", a, b, s => s.CrouchSpeedUnits, s => SpeedText( s.CrouchSpeedUnits ), 1 );
        yield return Compare( "PRONE SPEED", a, b, s => s.ProneSpeedUnits, s => SpeedText( s.ProneSpeedUnits ), 1 );

        yield return Section( "AMMO" );
        yield return Compare( "MAGAZINE", a, b, s => s.Rounds, s => $"{s.Rounds}", 1 );
        yield return Compare( "SPARE ROUNDS", a, b, s => s.Reserve, s => $"{s.Reserve}", 1 );
        yield return Compare( "FIRE MODE", a, b, s => 0f, s => s.FireModeShown, 0 );
    }

    private static Row Section( string title ) => new( title, null, null, null, 0f, 0f, 0 );

    /// <summary> One shot's damage where it hits at <paramref name="meters"/>: each pellet's, times the pellets. </summary>
    private static Row AtRange( int meters, GunsmithStats a, GunsmithStats b, Func<GunsmithStats, float> bullet )
    {
        string Text( GunsmithStats s ) => bullet( s ) <= 0f ? "-" : s.Pellets > 1 ? $"{bullet( s ):0.#} ×{s.Pellets}" : $"{bullet( s ):0.#}";
        return new( null, $"{meters} M", Text( a ), b is null ? null : Text( b ), bullet( a ) * a.Pellets, b is null ? 0f : bullet( b ) * b.Pellets, 1, true );
    }

    /// <summary> A row: each weapon's value and text, and whether more (1) or less (-1) is better (0: neither). </summary>
    private static Row Compare( string name, GunsmithStats a, GunsmithStats b, Func<GunsmithStats, float> value, Func<GunsmithStats, string> text, int better ) =>
        new( null, name, text( a ), b is null ? null : text( b ), value( a ), b is null ? 0f : value( b ), better );

    /// <summary> "better" or "worse" for one side of a row, when it's compared and the two differ. </summary>
    private static string Verdict( Row row, bool mine, bool compared )
    {
        if ( !compared || row.Better == 0 )
            return "";

        var (own, other) = mine ? (row.MineValue, row.TheirsValue) : (row.TheirsValue, row.MineValue);
        if ( MathF.Abs( own - other ) <= MathF.Max( MathF.Abs( own ), MathF.Abs( other ) ) * 0.005f )
            return "";

        return (own > other) == (row.Better > 0) ? "better" : "worse";
    }

    private static string DamageText( GunsmithStats s ) => s.Pellets > 1 ? $"{s.BulletDamage:0.#} ×{s.Pellets}" : $"{s.BulletDamage:0.#}";

    private static float Dps( GunsmithStats s ) => s.BulletDamage * s.Pellets * s.Rpm / 60f;

    /// <summary> From the first round to the last of a full magazine, at the full fire rate. </summary>
    private static float EmptyTime( GunsmithStats s ) => s.Rpm <= 0f ? 0f : (s.Rounds - 1) * 60f / s.Rpm;

    /// <summary> From the first hit to the killing one, at the full fire rate, if every shot hits. </summary>
    private static float KillTime( int shots, GunsmithStats s ) => shots <= 0 || s.Rpm <= 0f ? 0f : (shots - 1) * 60f / s.Rpm;

    private static string KillTimeText( int shots, GunsmithStats s ) => shots <= 0 || s.Rpm <= 0f ? "-" : $"{KillTime( shots, s ) * 1000f:0} MS";

    private static string SecondsText( float seconds ) => seconds <= 0f ? "-" : $"{seconds:0.00} S";

    // Unarmored, full-damage regional trauma; range and protection change these counts.
    private static int HeadHits( GunsmithStats s ) => ShotsFor( HardcoreTrauma.Damage( s.BulletDamage, TraumaRegion.Head, Health ) * s.Pellets );
    private static int BodyHits( GunsmithStats s ) => ShotsFor( HardcoreTrauma.Damage( s.BulletDamage, TraumaRegion.Chest, Health ) * s.Pellets );

    /// <summary> Shots to kill with arm and leg hits: 1.7× the damage, each bullet at most half the health. </summary>
    private static int LimbHits( GunsmithStats s ) => ShotsFor( MathF.Min( s.BulletDamage * HealthComponent.LimbWoundScale, Health * 0.5f ) * s.Pellets );

    private static int ShotsFor( float damagePerShot ) => damagePerShot <= 0f ? 0 : (int)MathF.Ceiling( Health / damagePerShot - 0.0001f );

    private static string HitsText( int shots, GunsmithStats s ) => shots <= 0 ? "-" : s.Pellets > 1 ? Tr( shots == 1 ? "{0} BLAST" : "{0} BLASTS", shots ) : $"{shots}";

    private static string ReloadText( float seconds, GunsmithStats s ) => seconds <= 0f ? "-" : s.SingleReload ? Tr( "{0:0.0#} S / ROUND", seconds ) : $"{seconds:0.0#} S";

    private static string SpeedText( float unitsPerSecond ) => $"{unitsPerSecond * MetersPerUnit:0.00} M/S";

    protected override int BuildHash() =>
        HashCode.Combine( HashCode.Combine( Weapon, Other, Factory, VsFactory, Live, Filter, _mine, _theirs ), MyBuild, OtherBuild, BuildsTab, _buildsKey );
}
