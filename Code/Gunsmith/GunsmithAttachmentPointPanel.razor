@using Facepunch.UI
@using Sandbox
@using Sandbox.UI

@namespace Facepunch.Gunsmith
@inherits Panel

<root class="hc1">
    @if ( IsViewingOptions )
    {
        @foreach ( var part in GetPartsForCategory() )
        {
            var isCurrent = AttachmentPoint.IsValid() && part == AttachmentPoint.CurrentPart;

            <div class="entry layout grow center @(isCurrent ? "current" : "")" style="justify-content: center; align-items: center;" onclick=@(() => SetPart( part ) )>
                <label class="white micro">@part.Name</label>
            </div>
        }

        <div class="entry layout grow center" style="justify-content: center; align-items: center;" onclick=@(() => ClearThis() )>
            <label class="white micro">@Tr( "None" )</label>
        </div>
    }
    else
    {
        <div class="entry layout grow center" style="justify-content: center; align-items: center;" onclick=@(() => Toggle() )>
            @if ( AttachmentPoint.IsValid() && AttachmentPoint.CurrentPart is not null )
            {
                <label class="white micro">@AttachmentPoint.CurrentPart.Name</label>
            }
            else
            {
                <label class="white micro">@Tr( Category == GunsmithPartType.RearGrip ? "Rear Grip" : Category.ToString() )</label>
            }
        </div>
    }
</root>

@code
{
    public GunsmithAttachmentPoint AttachmentPoint { get; set; }
    public GunsmithWeapon Weapon { get; set; }
    public GunsmithPartType Category { get; set; }

    public bool IsViewingOptions { get; set; }

    public GunsmithAttachmentPointPanel()
    {
        BindClass( "open", () => IsViewingOptions );
    }

    public override void Tick()
    {
        if ( !AttachmentPoint.IsValid() || AttachmentPoint.Scene?.Camera is null )
            return;

        var screenPos = AttachmentPoint.Scene.Camera.PointToScreenNormal( AttachmentPoint.WorldPosition );

        // Hacky hack hack, but temporary.
        if ( Category == GunsmithPartType.Optic )
            screenPos = screenPos.WithX( screenPos.x - 0.05f ).WithY( screenPos.y - 0.25f );
        if ( Category == GunsmithPartType.Charm )
            screenPos = screenPos.WithX( screenPos.x ).WithY( screenPos.y + 0.05f );

        Style.Left = Length.Fraction( screenPos.x );
        Style.Top = Length.Fraction( screenPos.y );
    }

    private void ClearThis()
    {
        if ( !AttachmentPoint.IsValid() )
            return;

        SaveAndApplyPart( null );
        IsViewingOptions = false;
    }

    private void Toggle()
    {
        IsViewingOptions ^= true;
    }

    private void SetPart( GunsmithPart part )
    {
        if ( !AttachmentPoint.IsValid() )
            return;

        SaveAndApplyPart( part );
        IsViewingOptions = false;
    }

    private void SaveAndApplyPart( GunsmithPart part )
    {
        if ( !Weapon.IsValid() || !Weapon.Resource.IsValid() )
            return;

        GunsmithLoadoutManager.SetAttachment( Weapon.Resource, AttachmentPoint.Category, part );
        // New prefab meshes need the saved camo as soon as they are equipped.
        GunsmithLoadoutManager.ApplyAttachments( Weapon.Resource, Weapon.GameObject );
    }

    private IEnumerable<GunsmithPart> GetPartsForCategory()
    {
        // The PostLoad category cache can be empty after an editor restart even
        // while ResourceLibrary contains the parts. Use the live catalogue,
        // matching the Customize tab and saved-loadout resolver.
        var parts = ResourceLibrary.GetAll<GunsmithPart>()
            .Where( x => x.IsValid() && x.Category == Category )
            // Failed/incomplete prefab loads must not appear as usable options.
            .Where( x => x.MainPrefab.IsValid() || x.ModifyBodygroups )
            .OrderBy( x => x.RequiredLevel )
            .ThenBy( x => x.Name );

        if ( !Weapon.IsValid() || !Weapon.Resource.IsValid() )
            return parts.ToList();

        return parts.Where( x => x.Supports( Weapon.Resource ) ).ToList();
    }

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( IsViewingOptions );
        hash.Add( AttachmentPoint?.CurrentPart );
        hash.Add( Weapon?.Resource );
        foreach ( var part in GetPartsForCategory() ) hash.Add( part );
        return hash.ToHashCode();
    }
}
