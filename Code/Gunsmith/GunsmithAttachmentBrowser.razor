@using Sandbox
@using Sandbox.UI
@using Facepunch.UI
@namespace Facepunch.Gunsmith
@inherits Panel

@{
    var points = GetPoints().ToList();
    var unlockPoints = AttachmentUnlocks.AvailablePoints;
}
<root class="hc1 @(SelectedPoint.IsValid() ? "browsing" : "") @(points.Any() ? "has-slots" : "no-slots")">
    @* The gunsmith's right column: one row per slot, and picking a slot swaps the list for that slot's parts. *@
    @if ( SelectedPoint.IsValid() )
    {
        <div class="ab-head">
            <div class="ab-back" onclick=@Close><i>arrow_back</i></div>
            <div class="ab-heading">
                <label class="ab-caption">@Tr( "ATTACHMENTS" )</label>
                <label class="ab-title">@CategoryName( SelectedPoint.Category )</label>
            </div>
            <label class="ab-count">@OptionCountLabel( SelectedPoint.Category )</label>
        </div>
    }
    else
    {
        <div class="ab-head">
            <div class="ab-bar" />
            <label class="ab-title">@Tr( "ATTACHMENTS" )</label>
            @if ( points.Any() )
            {
                <label class="ab-count">@Tr( "{0} / {1} EQUIPPED", EquippedCount, points.Count )</label>
            }
        </div>
    }

    @* Unlock points: one every 5 player levels, spent on any locked attachment (AttachmentUnlocks). *@
    @if ( Weapon.IsValid() && !AttachmentUnlocks.UnlockAll )
    {
        <div class="ab-points @(unlockPoints > 0 ? "has-points" : "")">
            <i>key</i>
            <label class="ab-points-count">@unlockPoints</label>
            <label class="ab-points-label">@Tr( unlockPoints == 1 ? "UNLOCK POINT" : "UNLOCK POINTS" )</label>
            <label class="ab-points-next">@(AttachmentUnlocks.NextPointLevel is { } nextPoint ? Tr( "NEXT AT PLAYER LV {0}", nextPoint ) : Tr( "ALL EARNED" ))</label>
        </div>
    }

    @if ( SelectedPoint.IsValid() )
    {
        var options = new List<GunsmithPart> { null };
        options.AddRange( GetParts( SelectedPoint.Category ) );
        <div class="ab-list">
            @foreach ( var part in options )
            {
                var equipped = SelectedPoint.CurrentPart == part;
                var unlocked = IsUnlocked( part );
                var armed = !unlocked && part == _armedPart;
                var picture = Picture( part );
                var state = StateText( part, equipped, unlocked, armed, unlockPoints );
                <div class="ab-option @(equipped ? "equipped" : "") @(!unlocked ? "locked" : "") @(!unlocked && unlockPoints > 0 ? "buyable" : "") @(armed ? "armed" : "")" onclick=@(() => Equip( part ))>
                    <div class="ab-icon @(picture is not null ? "pictured" : "")">
                        @if ( picture is not null )
                        {
                            <Image class="ab-picture" Texture=@picture />
                        }
                        else
                        {
                            <i>@(part is null ? "block" : CategoryIcon( SelectedPoint.Category ))</i>
                        }
                    </div>
                    <div class="ab-copy">
                        <label class="ab-part">@(part?.Name ?? StandardName( SelectedPoint.Category ))</label>
                        <label class="ab-desc">@OptionDescription( part )</label>
                        @if ( part.IsValid() && MathF.Abs( part.Mass ) >= 0.005f )
                        {
                            <label class="ab-weight">@WeightText( part )</label>
                        }
                        @if ( state is not null )
                        {
                            <label class="ab-state">@state</label>
                        }
                    </div>
                    <div class="ab-plus"><i>@(equipped ? "check" : unlocked ? "add" : armed ? "lock_open" : unlockPoints > 0 ? "key" : "lock")</i></div>
                </div>
            }
        </div>
        <label class="ab-hint">@Tr( "CHANGES SAVE AUTOMATICALLY" )</label>
    }
    else
    {
        <div class="ab-list">
            @foreach ( var point in points )
            {
                var current = point.CurrentPart;
                var picture = current.IsValid() ? Picture( current ) : null;
                var count = CountParts( point.Category );
                <div class="ab-slot @(current.IsValid() ? "equipped" : "") @(count.Total == 0 && !current.IsValid() ? "empty" : "")" onclick=@(() => SelectPoint( point ))>
                    <div class="ab-icon @(picture is not null ? "pictured" : "")">
                        @if ( picture is not null )
                        {
                            <Image class="ab-picture" Texture=@picture />
                        }
                        else
                        {
                            <i>@CategoryIcon( point.Category )</i>
                        }
                    </div>
                    <div class="ab-copy">
                        <div class="ab-slot-head">
                            <label class="ab-slot-name">@CategoryName( point.Category )</label>
                            <label class="ab-slot-count">@SlotCountText( count )</label>
                        </div>
                        <label class="ab-part">@(current.IsValid() ? current.Name : StandardName( point.Category ))</label>
                    </div>
                    <div class="ab-plus"><i>@(current.IsValid() ? "swap_horiz" : "add")</i></div>
                </div>
            }
            @if ( !points.Any() )
            {
                <label class="ab-empty">@Tr( "This weapon has no attachment slots" )</label>
            }
        </div>
    }
</root>

@code
{
    public GunsmithWeapon Weapon { get; set; }
    public GunsmithAttachmentPoint SelectedPoint { get; private set; }
    private GunsmithWeapon PreviousWeapon;
    private GunsmithPartType? selectedCategory;
    private string selectedWeaponPath;
    private int EquippedCount => GetPoints().Count( p => p.CurrentPart.IsValid() );

    /// <summary> A locked part clicked once with a point to spend: the next click on it spends the point. </summary>
    private GunsmithPart _armedPart;
    private RealTimeSince _armedSince;

    /// <summary> How long a first click on a locked part waits for the second. </summary>
    private const float ArmedTime = 4f;

    /// <summary> The parts <paramref name="category"/> takes on this gun, and how many of them are unlocked. </summary>
    private (int Unlocked, int Total) CountParts( GunsmithPartType category )
    {
        var parts = GetParts( category ).ToList();
        return (parts.Count( IsUnlocked ), parts.Count);
    }

    private string OptionCountLabel( GunsmithPartType category )
    {
        var (unlocked, total) = CountParts( category );
        if ( unlocked < total ) return Tr( "{0} / {1} UNLOCKED", unlocked, total );
        return total == 1 ? Tr( "1 OPTION" ) : Tr( "{0} OPTIONS", total );
    }

    /// <summary> A slot row's count: how many parts fit it (0 for none), or unlocked/all while some are locked. </summary>
    private static string SlotCountText( (int Unlocked, int Total) count ) =>
        count.Unlocked < count.Total ? $"{count.Unlocked}/{count.Total}" : count.Total.ToString();

    /// <summary> The part's picture as fitted to this gun (AttachmentThumbnails), or null while it's drawn or for none. </summary>
    private Texture Picture( GunsmithPart part ) => part is null || !Weapon.IsValid() ? null : AttachmentThumbnails.Get( part, Weapon.Renderer?.Model );

    private string StateText( GunsmithPart part, bool equipped, bool unlocked, bool armed, int unlockPoints )
    {
        if ( equipped ) return Tr( "EQUIPPED" );
        if ( armed ) return Tr( "CLICK AGAIN TO SPEND 1 UNLOCK POINT" );
        if ( !unlocked )
        {
            var level = AttachmentUnlocks.GetRequiredLevel( Weapon.Resource, part );
            return unlockPoints > 0 ? Tr( "UNLOCKS AT LV {0} · OR 1 UNLOCK POINT", level ) : Tr( "UNLOCKS AT LV {0}", level );
        }
        return AttachmentUnlocks.IsUnlockedByPoint( Weapon.Resource, part ) ? Tr( "UNLOCKED WITH A POINT" ) : null;
    }

    // Keep selection local to this browser. One slot owns the column at a time.
    public override void Tick()
    {
        base.Tick();
        AttachmentThumbnails.Pump();
        if ( _armedPart is not null && _armedSince > ArmedTime )
        {
            _armedPart = null;
            StateHasChanged();
        }
        if ( PreviousWeapon != Weapon )
        {
            PreviousWeapon = Weapon;
            if ( selectedCategory.HasValue && Weapon.IsValid() && Weapon.Resource.IsValid()
                && string.Equals( Weapon.Resource.ResourcePath, selectedWeaponPath, System.StringComparison.OrdinalIgnoreCase ) )
            {
                SelectedPoint = GetPoints().FirstOrDefault( p => p.Category == selectedCategory.Value );
                if ( !SelectedPoint.IsValid() ) Close();
                else StateHasChanged();
            }
            else Close();
        }
    }

    private IEnumerable<GunsmithAttachmentPoint> GetPoints()
    {
        if ( !Weapon.IsValid() ) return Enumerable.Empty<GunsmithAttachmentPoint>();
        return Weapon.GetComponentsInChildren<GunsmithAttachmentPoint>( true )
            .Where( p => AttachmentUnlocks.IsAttachment( p.Category ) )
            .GroupBy( p => p.Category ).Select( g => g.First() ).OrderBy( p => CategoryOrder( p.Category ) );
    }

    // In unlock order: what the weapon has unlocked first, then what its next levels bring.
    private IEnumerable<GunsmithPart> GetParts( GunsmithPartType category ) => ResourceLibrary.GetAll<GunsmithPart>()
        .Where( p => p.IsValid() && p.Category == category && AttachmentUnlocks.IsOffered( p ) )
        .Where( p => Weapon.IsValid() && p.Supports( Weapon.Resource ) )
        .OrderBy( p => AttachmentUnlocks.GetRequiredLevel( Weapon.Resource, p ) ).ThenBy( p => p.Name );

    private bool IsUnlocked( GunsmithPart part ) => Weapon.IsValid() && AttachmentUnlocks.IsUnlocked( Weapon.Resource, part );

    public void SelectPoint( GunsmithAttachmentPoint point )
    {
        SelectedPoint = point;
        selectedCategory = point.Category;
        selectedWeaponPath = Weapon.Resource.ResourcePath;
        StateHasChanged();
    }

    public void Close()
    {
        SelectedPoint = null;
        selectedCategory = null;
        selectedWeaponPath = null;
        _armedPart = null;
        StateHasChanged();
    }

    private void Equip( GunsmithPart part )
    {
        if ( !Weapon.IsValid() || !Weapon.Resource.IsValid() || !SelectedPoint.IsValid() ) return;
        if ( !IsUnlocked( part ) && !TryBuy( part ) ) return;
        _armedPart = null;
        if ( part is not null && (part.Category != SelectedPoint.Category || !part.Supports( Weapon.Resource )) ) return;
        GunsmithLoadoutManager.SetAttachment( Weapon.Resource, SelectedPoint.Category, part );
        var gunsmith = Weapon.GetComponentInParent<GunsmithSystem>();
        if ( gunsmith.IsValid() ) gunsmith.ApplyPreviewAttachments( Weapon.Resource );
        else GunsmithLoadoutManager.ApplyAttachments( Weapon.Resource, Weapon.GameObject );
        StateHasChanged();
    }

    /// <summary>
    /// A locked part: with a point to spend, the first click asks and a second click within a few seconds spends it (true,
    /// and the part goes on). Without one, says when it unlocks.
    /// </summary>
    private bool TryBuy( GunsmithPart part )
    {
        var weapon = Weapon.Resource;
        if ( AttachmentUnlocks.AvailablePoints <= 0 )
        {
            _armedPart = null;
            var required = AttachmentUnlocks.GetRequiredLevel( weapon, part );
            GunsmithPanel.Instance?.Notify( new GunsmithMessage( "{0} IS LOCKED", part.Name.ToUpperInvariant() ),
                AttachmentUnlocks.NextPointLevel is { } level
                    ? new GunsmithMessage( "Unlocks at {0} level {1}, or with an unlock point (next at player level {2})", weapon.Name, required, level )
                    : new GunsmithMessage( "Unlocks at {0} level {1}", weapon.Name, required ), "lock" );
            return false;
        }

        if ( _armedPart != part || _armedSince > ArmedTime )
        {
            _armedPart = part;
            _armedSince = 0;
            StateHasChanged();
            return false;
        }

        _armedPart = null;
        if ( !AttachmentUnlocks.TrySpendPoint( weapon, part ) ) return false;

        var left = AttachmentUnlocks.AvailablePoints;
        GunsmithPanel.Instance?.Notify( new GunsmithMessage( "{0} UNLOCKED", part.Name.ToUpperInvariant() ),
            new GunsmithMessage( left == 1 ? "Unlock point spent on the {0}: {1} point left" : "Unlock point spent on the {0}: {1} points left", weapon.Name, left ), "key" );
        return true;
    }

    private static int CategoryOrder( GunsmithPartType category ) => category switch
    {
        GunsmithPartType.Muzzle => 0, GunsmithPartType.Barrel => 1, GunsmithPartType.Optic => 2,
        GunsmithPartType.Underbarrel => 3, GunsmithPartType.Magazine => 4, GunsmithPartType.RearGrip => 5,
        GunsmithPartType.Stock => 6, GunsmithPartType.Laser => 7, GunsmithPartType.Rail => 8, GunsmithPartType.Action => 9,
        GunsmithPartType.Trigger => 10, GunsmithPartType.Ammunition => 11, _ => 12
    };

    // These return text in the player's language, for showing.
    private static string StandardName( GunsmithPartType category ) => Tr( category == GunsmithPartType.Ammunition ? "Standard Rounds" : "Standard" );

    private string OptionDescription( GunsmithPart part ) => GunsmithAttachmentEffects.Describe( part ) is { } effects ? Tr( effects )
        : !string.IsNullOrWhiteSpace( part?.Description ) ? Tr( part.Description )
        : SelectedPoint.Category == GunsmithPartType.Ammunition ? Tr( part?.UsesTracerRounds == true ? "Visible bullet trails" : "No visible bullet trails" )
        : part is null ? Tr( "Original weapon part" ) : part.IsSuppressor ? Tr( "Suppressor" ) : CategoryName( part.Category );

    /// <summary> What the part adds to the gun's weight (GunsmithPart.Mass), e.g. "+0.45 KG". </summary>
    private static string WeightText( GunsmithPart part ) => $"{part.Mass:+0.00;-0.00} KG";

    private static string CategoryName( GunsmithPartType category ) => Tr( category == GunsmithPartType.RearGrip ? "REAR GRIP" : category.ToString().ToUpperInvariant() );
    private static string CategoryIcon( GunsmithPartType category ) => category switch
    {
        GunsmithPartType.Optic => "filter_center_focus", GunsmithPartType.Muzzle => "volume_off",
        GunsmithPartType.Barrel => "straighten", GunsmithPartType.Stock => "view_week", GunsmithPartType.Rail => "horizontal_rule",
        GunsmithPartType.Underbarrel => "pan_tool", GunsmithPartType.RearGrip => "back_hand",
        GunsmithPartType.Magazine => "view_stream", GunsmithPartType.Ammunition => "linear_scale", GunsmithPartType.Laser => "flare",
        GunsmithPartType.Action => "autorenew", GunsmithPartType.Trigger => "touch_app", _ => "build"
    };

    protected override int BuildHash()
    {
        var hash = new HashCode();
        hash.Add( Weapon ); hash.Add( SelectedPoint );
        if ( Weapon.IsValid() && Weapon.Resource.IsValid() ) hash.Add( WeaponProgression.GetLevel( Weapon.Resource ) );
        hash.Add( AttachmentUnlocks.UnlockAll );
        hash.Add( AttachmentUnlocks.AvailablePoints ); hash.Add( AttachmentUnlocks.NextPointLevel );
        hash.Add( _armedPart ); hash.Add( AttachmentThumbnails.Version );
        foreach ( var point in GetPoints() )
        {
            hash.Add( point ); hash.Add( point.CurrentPart );
            foreach ( var part in GetParts( point.Category ) ) hash.Add( part );
        }
        return hash.ToHashCode();
    }
}
