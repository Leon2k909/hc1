@using Sandbox;
@using Sandbox.UI;
@using Facepunch.Gunsmith;
@using Facepunch.UI;

@inherits PanelComponent
@namespace Facepunch

@{
    var equip = GetEquipment();
    var inMatch = InMatch;
    var activeClass = GunsmithLoadoutManager.GetActiveClassIndex();
    var activeClassIndices = GunsmithLoadoutManager.GetActiveClassIndices();
    var activeClassNum = activeClassIndices.IndexOf( activeClass ) + 1;
}

<root class="hc1 gunsmith">
    @* ===================== HEADER: the main menu's nav bar (MainMenuRoot) ===================== *@
    <div class="global-nav">
        <div class="gnav-logo" @onclick=@(() => GoToMenu( "/" ))>
            <label class="gnav-game-name">RAZED</label>
        </div>

        <div class="gnav-items">
            @* Over a match the tabs would leave it, so only the menu's gunsmith has them. *@
            @if ( !inMatch )
            {
                @foreach ( var tab in NavTabs )
                {
                    var route = tab.Route;
                    <div class="gnav-item @(route is null ? "active" : "")" @onclick=@(() => GoToMenu( route ))>
                        <i>@tab.Icon</i>
                        <label>@Tr( tab.Label )</label>
                        <div class="gnav-item-bar" />
                    </div>
                }
            }
        </div>

        @if ( !inMatch )
        {
            <PartyPanel />
        }

        <div class="gnav-right">
            <div class="gnav-round-btns">
                @if ( !inMatch )
                {
                    <div class="gnav-round-btn" @onclick=@(() => GoToMenu( "/settings" ))>
                        <i>settings</i>
                        <label class="gnav-tip">@Tr( "SETTINGS" )</label>
                    </div>
                }
            </div>

                <div class="gnav-profile" @onclick=@(() => GoToMenu( "/barracks" ))>
                @if ( Progression.GetPrestige() > 0 )
                {
                    <img class="gnav-prestige" src="/ui/prestige/prestige_@(Progression.GetPrestige())_readable.png" />
                }
                <div class="gnav-profile-info">
                    <label class="gnav-profile-name">@LocalName</label>
                    <label class="gnav-profile-level">@Tr( "LV {0}", Progression.GetLevel() )</label>
                </div>
                @if ( LocalSteamId != 0 )
                {
                    <img class="gnav-avatar" src="avatar:@LocalSteamId" />
                }
                else
                {
                    <div class="gnav-avatar gnav-avatar-placeholder"><i>person</i></div>
                }
                @if ( !inMatch )
                {
                    <label class="gnav-tip">@Tr( "PROFILE" )</label>
                }
            </div>

            @if ( inMatch )
            {
                <div class="gnav-icon-btn" @onclick=@Leave>
                    <i>close</i>
                    <label class="gnav-tip right">@Tr( "BACK TO MATCH" )</label>
                </div>
            }
            else
            {
                <div class="gnav-icon-btn" @onclick=@OpenFriendsList>
                    <i>group</i>
                    <label class="gnav-tip right">@Tr( "FRIENDS" )</label>
                </div>
            }
        </div>
    </div>

    @* ===================== BREADCRUMBS ===================== *@
    <div class="gs-crumbs">
        <div class="gs-crumb-back" @onclick=@GoBackStep>
            <i>arrow_back</i>
            <label>@Tr( BackLabel )</label>
        </div>
        <label class="gs-crumb">@Tr( inMatch ? "MATCH" : "WEAPONS" )</label>
        <i class="gs-crumb-sep">chevron_right</i>
        <label class="gs-crumb @(CrumbPage is null ? "current" : "link")" @onclick=@CloseLayers>@Tr( "GUNSMITH" )</label>
        @if ( CrumbPage is { } crumbPage )
        {
            <i class="gs-crumb-sep">chevron_right</i>
            <label class="gs-crumb current">@crumbPage</label>
        }
    </div>

    <div class="gs-body">
        @* ===================== LEFT: LOADOUT ===================== *@
        <div class="gs-col gs-left gs-panel">
            @if ( ShowDetails && _stats.IsFirearm )
            {
                @* ── DETAILS: the figures behind the bars, beside the factory gun's. The parts list on the right stays
                   open, and they follow each part as it goes on or comes off. ── *@
                <div class="gs-page-head">
                    <div class="gs-square-btn" @onclick=@(() => ShowDetails = false)><i>arrow_back</i></div>
                    <div class="gs-page-title">
                        <label class="gs-page-caption">@GetEquipmentName()</label>
                        <label class="gs-page-name">@Tr( "DETAILS" )</label>
                    </div>
                </div>
                <label class="gs-details-hint">@Tr( "Change attachments and these figures change with them. Green is better than the factory gun, red is worse." )</label>
                <div class="gs-details">
                    <WeaponComparePanel Weapon=@equip Live=@true Stats=@_stats FactoryStats=@_baseStats />
                </div>
            }
            else if ( IsPickerOpen )
            {
                @* ── One slot's choices, with a way back to the loadout ── *@
                <div class="gs-page-head">
                    <div class="gs-square-btn" @onclick=@ClosePicker><i>arrow_back</i></div>
                    <div class="gs-page-title">
                        <label class="gs-page-caption">@GunsmithLoadoutManager.GetClassName( activeClass )</label>
                        <label class="gs-page-name">@PickerTitle</label>
                    </div>
                </div>

                @if ( SelectedPerkCategory == 0 && SelectedSlot is EquipmentSlot.Primary or EquipmentSlot.Secondary )
                {
                    <div class="gs-chips">
                        @foreach ( var category in PickerCategories( SelectedSlot ) )
                        {
                            var c = category;
                            <div class="gs-chip @(SelectedWeaponCategory == c ? "active" : "")" @onclick=@(() => SelectedWeaponCategory = c)>
                                <label>@Tr( CategoryChip( c ) )</label>
                            </div>
                        }
                    </div>
                }

                <div class="gs-page-list">
                    @if ( SelectedPerkCategory > 0 )
                    {
                        @foreach ( var perk in PerkResource.All.Where( x => (int)x.Category == SelectedPerkCategory ).OrderBy( x => x.Name ) )
                        {
                            var p = perk;
                            var perkEquipped = GunsmithLoadoutManager.GetPerk( SelectedPerkCategory ) is { } perkId
                                && (perkId == p.ResourceName || perkId == p.ResourcePath);
                            <div class="gs-choice perk @(perkEquipped ? "equipped" : "")" @onclick=@(() => SelectPerk( p ))>
                                <div class="gs-choice-glyph"><i>@PerkGlyph( p )</i></div>
                                <div class="gs-choice-copy">
                                    <label class="gs-choice-name">@Tr( p.Name.ToUpper() )</label>
                                    <label class="gs-choice-desc">@Tr( p.Description )</label>
                                </div>
                                @if ( perkEquipped ) { <i class="gs-choice-check">check</i> }
                            </div>
                        }
                    }
                    else if ( SelectedSlot is EquipmentSlot.Primary or EquipmentSlot.Secondary )
                    {
                        @foreach ( var weapon in GetWeaponsForSlot( SelectedSlot ) )
                        {
                            var w = weapon;
                            var shown = equip == w;
                            var inClass = IsLoadoutSet( w );
                            var favourite = GunsmithLoadoutManager.IsFavorite( w.ResourcePath );
                            <div class="gs-choice weapon @(shown ? "shown" : "") @(inClass ? "equipped" : "")" @onclick=@(() => SelectWeapon( w ))>
                                <div class="gs-choice-img">
                                    @if ( !string.IsNullOrEmpty( w.Icon ) )
                                    {
                                        <div class="gs-img-square" style="background-image: url( '@w.Icon' )" />
                                    }
                                </div>
                                <div class="gs-choice-copy">
                                    <div class="gs-choice-name-row">
                                        <label class="gs-choice-name">@w.Name.ToUpper()</label>
                                        @if ( w.IsWip ) { <label class="wip-tag">@Tr( "WIP" )</label> }
                                        @if ( ShowReviewNote( w ) ) { <label class="review-tag">CHECK</label> }
                                    </div>
                                    <div class="gs-choice-meta">
                                        <label class="gs-lv-key">@Tr( "LV" )</label>
                                        <label class="gs-lv-num">@WeaponProgression.GetLevel( w )</label>
                                        @if ( inClass ) { <label class="gs-choice-state">@Tr( "EQUIPPED" )</label> }
                                    </div>
                                </div>
                                <i class="gs-fav @(favourite ? "on" : "")" @onclick=@(( PanelEvent e ) => ClickInside( e, () => ToggleFavourite( w.ResourcePath ) ))>@(favourite ? "star" : "star_border")</i>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach ( var item in GunsmithLoadoutManager.GetSlotChoices( SelectedSlot ) )
                        {
                            var g = item;
                            var inClass = IsLoadoutSet( g );
                            <div class="gs-choice gear @(inClass ? "equipped" : "")" @onclick=@(() => SelectGear( g ))>
                                <div class="gs-choice-img gear">
                                    @if ( !string.IsNullOrEmpty( g.Icon ) )
                                    {
                                        <div class="gs-img-square" style="background-image: url( '@g.Icon' )" />
                                    }
                                </div>
                                <div class="gs-choice-copy">
                                    <label class="gs-choice-name">@g.Name.ToUpper()</label>
                                    @if ( inClass ) { <label class="gs-choice-state">@Tr( "EQUIPPED" )</label> }
                                </div>
                                @if ( inClass ) { <i class="gs-choice-check">check</i> }
                            </div>
                        }
                    }
                </div>
            }
            else if ( IsClassListOpen )
            {
                @* ── Every class: pick one, name it, add or delete ── *@
                <div class="gs-page-head">
                    <div class="gs-square-btn" @onclick=@(() => IsClassListOpen = false)><i>arrow_back</i></div>
                    <div class="gs-page-title">
                        <label class="gs-page-caption">@Tr( "LOADOUT" )</label>
                        <label class="gs-page-name">@Tr( "CLASSES" )</label>
                    </div>
                    <label class="gs-head-count">@($"{activeClassIndices.Count} / {MaxClasses}")</label>
                </div>

                <div class="gs-rename">
                    <label class="gs-section-label">@Tr( "CLASS NAME" )</label>
                    <TextEntry class="gs-input" Value:bind=@ActiveClassName />
                </div>

                <div class="gs-page-list">
                    @for ( int i = 0; i < activeClassIndices.Count; i++ )
                    {
                        var idx = activeClassIndices[i];
                        var number = i + 1;
                        var isActive = activeClass == idx;
                        <div class="gs-choice class @(isActive ? "equipped" : "")" @onclick=@(() => PickClass( idx ))>
                            <label class="gs-choice-num">@number</label>
                            <div class="gs-choice-copy">
                                <label class="gs-choice-name">@GunsmithLoadoutManager.GetClassName( idx )</label>
                                <label class="gs-choice-desc">@GetClassPrimaryName( idx )</label>
                            </div>
                            @if ( isActive ) { <i class="gs-choice-check">check</i> }
                        </div>
                    }
                    @if ( activeClassIndices.Count < MaxClasses )
                    {
                        <div class="gs-choice class create" @onclick=@CreateClass>
                            <i class="gs-choice-num">add</i>
                            <div class="gs-choice-copy">
                                <label class="gs-choice-name">@Tr( "CREATE CLASS" )</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="gs-wide-btn danger @(activeClassIndices.Count <= 1 ? "disabled" : "") @(_confirmDelete ? "armed" : "")" @onclick=@DeleteActiveClass>
                    <i>delete</i>
                    <label>@Tr( _confirmDelete ? "CLICK AGAIN TO DELETE" : "DELETE CLASS" )</label>
                </div>
            }
            else
            {
                @* ── The class: weapons, equipment and perks ── *@
                <div class="gs-panel-head">
                    <div class="gs-head-bar" />
                    <label class="gs-panel-title">@Tr( "LOADOUT" )</label>
                    <label class="gs-head-count">@($"{activeClassNum}/{activeClassIndices.Count}")</label>
                    <div class="gs-square-btn small" @onclick=@(() => CycleClass( -1 ))><i>chevron_left</i></div>
                    <div class="gs-square-btn small" @onclick=@(() => CycleClass( 1 ))><i>chevron_right</i></div>
                </div>

                <div class="gs-loadout">
                    <div class="gs-class-card" @onclick=@OpenClassList>
                        <div class="gs-class-icon"><i>gps_fixed</i></div>
                        <div class="gs-class-copy">
                            <label class="gs-class-name">@GunsmithLoadoutManager.GetClassName( activeClass )</label>
                            <label class="gs-class-blurb">@Tr( ClassBlurb( activeClass ) )</label>
                        </div>
                        <i class="gs-class-more">more_horiz</i>
                    </div>

                    <label class="gs-section-label">@Tr( "PRIMARY WEAPON" )</label>
                    @{ var primary = GetDisplayedSlotResource( EquipmentSlot.Primary ); }
                    <div class="gs-weapon-card big @(primary is not null && primary == equip ? "active" : "") @(primary is null ? "empty" : "")" @onclick=@(() => ClickWeaponCard( EquipmentSlot.Primary ))>
                        <div class="gs-card-main">
                            @if ( !string.IsNullOrEmpty( primary?.Icon ) )
                            {
                                <div class="gs-card-img"><div class="gs-img-square" style="background-image: url( '@primary.Icon' )" /></div>
                            }
                            <label class="gs-card-name">@(primary?.Name.ToUpper() ?? Tr( "EMPTY" ))</label>
                            @if ( primary is not null )
                            {
                                <div class="gs-card-level">
                                    <label class="gs-lv-key">@Tr( "LV" )</label>
                                    <label class="gs-lv-num">@WeaponProgression.GetLevel( primary )</label>
                                    <div class="gs-card-xp"><div class="gs-card-xp-fill" style="width: @Pct( WeaponProgression.GetLevelProgress( primary ) )" /></div>
                                </div>
                            }
                        </div>
                        <div class="gs-card-chevron" @onclick=@(( PanelEvent e ) => ClickInside( e, () => SelectSlot( EquipmentSlot.Primary ) ))><i>chevron_right</i></div>
                    </div>

                    <label class="gs-section-label">@Tr( "SECONDARY WEAPON" )</label>
                    @{ var secondary = GetDisplayedSlotResource( EquipmentSlot.Secondary ); }
                    <div class="gs-weapon-card @(secondary is not null && secondary == equip ? "active" : "") @(secondary is null ? "empty" : "")" @onclick=@(() => ClickWeaponCard( EquipmentSlot.Secondary ))>
                        <div class="gs-card-img side">
                            @if ( !string.IsNullOrEmpty( secondary?.Icon ) )
                            {
                                <div class="gs-img-square" style="background-image: url( '@secondary.Icon' )" />
                            }
                            else
                            {
                                <i class="gs-card-add">add</i>
                            }
                        </div>
                        <div class="gs-card-copy">
                            <label class="gs-card-name">@(secondary?.Name.ToUpper() ?? Tr( "EMPTY" ))</label>
                            @if ( secondary is not null )
                            {
                                <div class="gs-card-level">
                                    <label class="gs-lv-key">@Tr( "LV" )</label>
                                    <label class="gs-lv-num">@WeaponProgression.GetLevel( secondary )</label>
                                </div>
                            }
                        </div>
                        <div class="gs-card-chevron" @onclick=@(( PanelEvent e ) => ClickInside( e, () => SelectSlot( EquipmentSlot.Secondary ) ))><i>chevron_right</i></div>
                    </div>

                    @foreach ( var gearSlot in GearSlots )
                    {
                        var gs = gearSlot;
                        var gear = GetEquippedResource( gs );
                        <label class="gs-section-label">@Tr( SlotTitle( gs ) )</label>
                        <div class="gs-gear-row @(gear is null ? "empty" : "")" @onclick=@(() => SelectSlot( gs ))>
                            <div class="gs-gear-img">
                                @if ( !string.IsNullOrEmpty( gear?.Icon ) )
                                {
                                    <div class="gs-img-square" style="background-image: url( '@gear.Icon' )" />
                                }
                                else
                                {
                                    <i class="gs-card-add">add</i>
                                }
                            </div>
                            <label class="gs-gear-name">@(gear?.Name.ToUpper() ?? Tr( "EMPTY" ))</label>
                            <div class="gs-card-chevron"><i>chevron_right</i></div>
                        </div>
                    }

                    <label class="gs-section-label">@Tr( "PERKS" )</label>
                    <div class="gs-perks">
                        @for ( int i = 1; i <= 3; i++ )
                        {
                            var pc = i;
                            var perk = GunsmithLoadoutManager.GetPerkResource( activeClass, pc );
                            <div class="gs-perk @(perk is null ? "empty" : "")" @onclick=@(() => SelectPerkCategory( pc ))>
                                <i class="gs-perk-glyph">@PerkGlyph( perk )</i>
                                <label class="gs-perk-num">@Tr( "PERK {0}", pc )</label>
                                <label class="gs-perk-name">@(perk is null ? Tr( "EMPTY" ) : Tr( perk.Name.ToUpper() ))</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="gs-wide-btn" @onclick=@SaveLoadout>
                    <i>save</i>
                    <label>@Tr( "SAVE LOADOUT" )</label>
                </div>
            }
        </div>

        @* ===================== CENTRE: the weapon ===================== *@
        <div class="gs-col gs-center">
            <div class="gs-hero">
                <div class="gs-hero-main">
                    <label class="gs-hero-category">@Tr( CategoryTitle( equip ) )</label>
                    <div class="gs-hero-name-row">
                        <label class="gs-hero-name">@GetEquipmentName().ToUpper()</label>
                        @if ( equip?.IsWip == true ) { <label class="wip-tag">@Tr( "WIP" )</label> }
                        @if ( ShowReviewNote( equip ) ) { <label class="review-tag">NEEDS CHECKING</label> }
                    </div>
                    @if ( equip is not null )
                    {
                        <div class="gs-hero-level">
                            <label class="gs-hero-lv">@Tr( "LV {0}", WeaponProgression.GetLevel( equip ) )</label>
                            <div class="gs-xp-bar"><div class="gs-xp-fill" style="width: @Pct( WeaponProgression.GetLevelProgress( equip ) )" /></div>
                            <label class="gs-hero-xp">@XpText( equip )</label>
                            @if ( AttachmentUnlocks.IsDeveloper )
                            {
                                @* Leon's account only (AttachmentUnlocks.DeveloperSteamId): every attachment and camo, whatever the level. *@
                                <div class="gs-dev-unlock @(AttachmentUnlocks.UnlockAll ? "on" : "")" @onclick=@ToggleUnlockAll>
                                    <i>@(AttachmentUnlocks.UnlockAll ? "lock_open" : "lock")</i>
                                    <label>@(AttachmentUnlocks.UnlockAll ? "ALL UNLOCKED" : "UNLOCK ALL")</label>
                                </div>
                            }
                        </div>
                        @if ( NextUnlockText( equip ) is { } nextUnlock )
                        {
                            <label class="gs-hero-next">@nextUnlock</label>
                        }
                        @if ( !string.IsNullOrWhiteSpace( equip.Description ) )
                        {
                            <label class="gs-hero-desc">@Tr( equip.Description.ToUpper() )</label>
                        }
                        @if ( ShowReviewNote( equip ) )
                        {
                            @* What still needs checking in-game (EquipmentResource.ReviewNote), for the developer only. *@
                            <div class="gs-review-note">
                                <i>fact_check</i>
                                <label>@equip.ReviewNote</label>
                            </div>
                        }
                    }
                </div>

                @if ( _stats.IsFirearm && _stats.TagList.Any() )
                {
                    <div class="gs-tags">
                        <div class="gs-tag-list">
                            @foreach ( var tag in _stats.TagList )
                            {
                                <label class="gs-tag">@Tr( tag )</label>
                            }
                        </div>
                        <div class="gs-tag-bar" />
                    </div>
                }
            </div>

            @* The gun is framed in here (GunsmithController); dragging and scrolling here turn and zoom it. *@
            <div class="gs-stage" @ref="StageRef">
                <label class="gs-stage-hint">@Tr( IsFirstPerson ? "FIRST-PERSON VIEW · ESC TO RETURN" : "DRAG TO ROTATE · RIGHT-DRAG TO PAN · SCROLL TO ZOOM" )</label>
            </div>

            <div class="gs-center-bottom">
                @if ( _stats.IsFirearm )
                {
                    <div class="gs-stats gs-panel">
                        <div class="gs-stat-rows">
                            @foreach ( var row in StatRows() )
                            {
                                var low = MathF.Min( row.Value, row.Base );
                                var change = MathF.Abs( row.Value - row.Base );
                                var trend = row.Value > row.Base + 0.005f ? "up" : row.Value < row.Base - 0.005f ? "down" : "";
                                <div class="gs-stat @trend">
                                    <label class="gs-stat-name">@Tr( row.Name )</label>
                                    <div class="gs-stat-track">
                                        <div class="gs-stat-fill" style="width: @Pct( low )" />
                                        @if ( trend != "" )
                                        {
                                            <div class="gs-stat-change" style="left: @Pct( low ); width: @Pct( change )" />
                                        }
                                    </div>
                                    <label class="gs-stat-value">@row.Text</label>
                                </div>
                            }
                        </div>
                        <div class="gs-stat-side">
                            <label class="gs-side-label">@Tr( "ROUNDS" )</label>
                            <label class="gs-side-value big @(_stats.Rounds > _baseStats.Rounds ? "up" : _stats.Rounds < _baseStats.Rounds ? "down" : "")">@_stats.Rounds</label>
                            <div class="gs-side-line" />
                            <label class="gs-side-label">@Tr( "FIRE MODE" )</label>
                            <label class="gs-side-value">@_stats.FireModeShown</label>
                            @* The figures behind the bars, in the loadout column while parts are changed (ShowDetails). *@
                            <div class="gs-stats-details @(ShowDetails ? "open" : "")" @onclick=@ToggleDetails>
                                <i>bar_chart</i>
                                <label>@Tr( "DETAILS" )</label>
                            </div>
                        </div>
                    </div>
                }

                <div class="gs-actions">
                    <div class="gs-action range locked" @onclick=@(() => Notify( "FIRING RANGE", "Coming in a later update", "lock" ))>
                        <i class="gs-action-icon">gps_fixed</i>
                        <div class="gs-action-copy">
                            <label class="gs-action-title">@Tr( "FIRING RANGE" )</label>
                            <label class="gs-action-sub">@Tr( "COMING SOON" )</label>
                        </div>
                        <i class="gs-action-lock">lock</i>
                    </div>
                    @* Weapon tuning is off (see WeaponTuningManager). Put back with tuning:
                    <div class="gs-action tuning @(ShowTuning ? "open" : "")" @onclick=@ToggleTuning>
                        <i class="gs-action-icon">tune</i>
                        <div class="gs-action-copy">
                            <label class="gs-action-title">@Tr( "TUNING" )</label>
                            <label class="gs-action-sub @(IsTuned( equip ) ? "tuned" : "")">@Tr( IsTuned( equip ) ? "TUNED" : "FINE TUNE STATS" )</label>
                        </div>
                    </div>
                    *@
                    @if ( _stats.IsFirearm )
                    {
                        <div class="gs-action compare @(ShowCompare ? "open" : "")" @onclick=@OpenCompare>
                            <i class="gs-action-icon">compare_arrows</i>
                            <div class="gs-action-copy">
                                <label class="gs-action-title">@Tr( "COMPARE" )</label>
                                <label class="gs-action-sub">@Tr( "ADVANCED STATS" )</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ===================== RIGHT: BUILD / CUSTOMIZE ===================== *@
        <div class="gs-col gs-right">
            <div class="gs-mode-tabs">
                <div class="gs-mode-tab @(Mode == GunsmithViewMode.Build ? "active" : "")" @onclick=@(() => SetMode( GunsmithViewMode.Build ))>
                    <label>@Tr( "BUILD" )</label>
                </div>
                <div class="gs-mode-tab @(Mode == GunsmithViewMode.Customize ? "active" : "")" @onclick=@(() => SetMode( GunsmithViewMode.Customize ))>
                    <label>@CustomizeWord</label>
                </div>
            </div>

            @if ( Mode == GunsmithViewMode.Build )
            {
                <GunsmithAttachmentBrowser @ref="BrowserRef" Weapon=@(System?.Weapon) />

                <div class="gs-presets-card" @onclick=@OpenPresets>
                    <i class="gs-presets-icon">description</i>
                    <div class="gs-presets-copy">
                        <label class="gs-presets-title">@Tr( "PRESETS" )</label>
                        <label class="gs-presets-sub">@Tr( "SAVE & MANAGE" )</label>
                    </div>
                    <i class="gs-presets-chevron">chevron_right</i>
                </div>
            }
            else
            {
                <div class="gs-customize gs-panel">
                    <div class="gs-panel-head">
                        <div class="gs-head-bar" />
                        <label class="gs-panel-title">@CustomizeWord</label>
                    </div>

                    <div class="gs-cust-tabs">
                        @foreach ( CustomizeTab tab in Enum.GetValues( typeof( CustomizeTab ) ) )
                        {
                            var t = tab;
                            <div class="gs-cust-tab @(ActiveCustomizeTab == t ? "active" : "")" @onclick=@(() => SelectCustomizeTab( t ))>
                                <label>@CustomizeTabName( t )</label>
                            </div>
                        }
                    </div>

                    <div class="gs-cust-body">
                        @if ( CamoTabCategory( ActiveCustomizeTab ) is { } camoCategory )
                        {
                            @* ── Camos: patterns (paged), solid colours, mastery, animated, glowing and 3D ── *@
                            var solid = ActiveCustomizeTab == CustomizeTab.Solid;
                            var glow = ActiveCustomizeTab == CustomizeTab.Glowing;
                            var paged = ActiveCustomizeTab == CustomizeTab.Standard;
                            var tabParts = CamoTabParts( ActiveCustomizeTab ).ToList();
                            var pageCount = Math.Max( 1, (int)Math.Ceiling( tabParts.Count / (double)CamosPerPage ) );
                            var shownParts = paged ? tabParts.Skip( CamoPage * CamosPerPage ).Take( CamosPerPage ).ToList() : tabParts;
                            GunsmithLoadoutManager.TryGetAttachment( equip, camoCategory, out var equippedCamo );

                            <div class="cust-grid">
                                @foreach ( var camo in shownParts )
                                {
                                    var part = camo;
                                    var unlocked = IsUnlocked( part );
                                    var isEquipped = equippedCamo == part;
                                    var favourite = GunsmithLoadoutManager.IsFavorite( part.ResourcePath );
                                    @* Keyed, so another tab's tiles aren't reused: a tile keeps a style property its new style
                                       leaves out, which left the Standard tab's pictures on the Solid tab's colours. *@
                                    <div @key="part" class="cust-item @(isEquipped ? "active" : "") @(!unlocked ? "locked" : "")" style="@CamoTileStyle( part, solid, glow )" @onclick=@(() => EquipPart( part ))>
                                        @if ( isEquipped ) { <i class="cust-check">check</i> }
                                        @if ( !unlocked )
                                        {
                                            <div class="cust-lock">
                                                <i>lock</i>
                                                <label>@Tr( "LV {0}", part.RequiredLevel )</label>
                                            </div>
                                        }
                                        <i class="cust-fav @(favourite ? "on" : "")" @onclick=@(( PanelEvent e ) => ClickInside( e, () => ToggleFavourite( part.ResourcePath ) ))>@(favourite ? "star" : "star_border")</i>
                                    </div>
                                }
                                @if ( !tabParts.Any() )
                                {
                                    <label class="cust-empty">@Tr( EmptyCamoText( ActiveCustomizeTab ) )</label>
                                }
                            </div>

                            @if ( paged && pageCount > 1 )
                            {
                                <div class="gs-pager">
                                    <div class="gs-square-btn small @(CamoPage == 0 ? "disabled" : "")" @onclick=@(() => CamoPage = Math.Max( 0, CamoPage - 1 ))><i>chevron_left</i></div>
                                    <label class="gs-pager-label">@($"{CamoPage + 1} / {pageCount}")</label>
                                    <div class="gs-square-btn small @(CamoPage >= pageCount - 1 ? "disabled" : "")" @onclick=@(() => CamoPage = Math.Min( pageCount - 1, CamoPage + 1 ))><i>chevron_right</i></div>
                                </div>
                            }

                            @if ( ActiveCustomizeTab == CustomizeTab.Standard )
                            {
                                <div class="gs-check-row @(CamoOnOptics ? "on" : "")" @onclick=@ToggleCamoOnOptics>
                                    <i>@(CamoOnOptics ? "check_box" : "check_box_outline_blank")</i>
                                    <label>@Tr( "Apply camo to optics" )</label>
                                </div>
                                <div class="gs-check-row @(EmblemOnGun ? "on" : "")" @onclick=@ToggleEmblemOnGun>
                                    <i>@(EmblemOnGun ? "check_box" : "check_box_outline_blank")</i>
                                    <label>@Tr( "Show emblem on gun" )</label>
                                </div>
                            }

                            @if ( solid )
                            {
                                <div class="gs-cust-extra">
                                    <label class="gs-section-label">@Tr( "CUSTOM PAINT" )</label>
                                    <div class="gs-check-row @(IsCustomCamoColorEquipped ? "on" : "")" @onclick=@ToggleCustomCamoColor>
                                        <i>@(IsCustomCamoColorEquipped ? "check_box" : "check_box_outline_blank")</i>
                                        <label>@Tr( "Enable custom colour" )</label>
                                    </div>
                                    @if ( IsCustomCamoColorEquipped )
                                    {
                                        <div class="gs-subpanel">
                                            <Facepunch.UI.ColorPicker Value:bind="@CustomCamoColor" />
                                            <div class="gs-slider">
                                                <div class="gs-slider-head"><label>@Tr( "Opacity" )</label><label class="gs-slider-value">@CustomCamoOpacity.ToString( "0.00" )</label></div>
                                                <CustomSlider Value:bind="@CustomCamoOpacity" Min=@(0f) Max=@(1f) Step=@(0.01f) NumberFormat="0.00" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                            </div>
                                        </div>

                                        <label class="gs-section-label">@Tr( "FINISH" )</label>
                                        <div class="gs-chips">
                                            @for ( int fi = 0; fi < GunsmithLoadoutManager.FinishNames.Length; fi++ )
                                            {
                                                var finish = fi;
                                                <div class="gs-chip @(CustomCamoFinish == finish ? "active" : "")" @onclick=@(() => SetFinish( finish ))>
                                                    <label>@Tr( GunsmithLoadoutManager.FinishNames[finish].ToUpper() )</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if ( ActiveCustomizeTab == CustomizeTab.Animated )
                            {
                                <div class="gs-cust-extra">
                                    <label class="gs-section-label">@Tr( "CUSTOM ANIMATION" )</label>
                                    <div class="gs-check-row @(IsCustomAnimatedCamoSpeedEquipped ? "on" : "")" @onclick=@ToggleCustomAnimatedCamoSpeed>
                                        <i>@(IsCustomAnimatedCamoSpeedEquipped ? "check_box" : "check_box_outline_blank")</i>
                                        <label>@Tr( "Enable custom speed and direction" )</label>
                                    </div>
                                    @if ( IsCustomAnimatedCamoSpeedEquipped )
                                    {
                                        <div class="gs-subpanel">
                                            <div class="gs-slider">
                                                <div class="gs-slider-head"><label>@Tr( "Horizontal speed" )</label><label class="gs-slider-value">@CustomAnimatedCamoSpeedX.ToString( "0.00" )</label></div>
                                                <CustomSlider Value:bind="@CustomAnimatedCamoSpeedX" Min=@(-2f) Max=@(2f) Step=@(0.05f) NumberFormat="0.00" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                            </div>
                                            <div class="gs-slider">
                                                <div class="gs-slider-head"><label>@Tr( "Vertical speed" )</label><label class="gs-slider-value">@CustomAnimatedCamoSpeedY.ToString( "0.00" )</label></div>
                                                <CustomSlider Value:bind="@CustomAnimatedCamoSpeedY" Min=@(-2f) Max=@(2f) Step=@(0.05f) NumberFormat="0.00" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if ( ActiveCustomizeTab == CustomizeTab.Charms )
                        {
                            GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Charm, out var equippedCharm );
                            <div class="cust-grid">
                                @foreach ( var charm in GetParts( GunsmithPartType.Charm ) )
                                {
                                    var c = charm;
                                    <div class="cust-item charm @(equippedCharm == c ? "active" : "")" @onclick=@(() => EquipPart( c ))>
                                        <label class="cust-name">@c.Name</label>
                                        @if ( equippedCharm == c ) { <i class="cust-check">check</i> }
                                    </div>
                                }
                                @if ( !GetParts( GunsmithPartType.Charm ).Any() )
                                {
                                    <label class="cust-empty">@Tr( "No charms" )</label>
                                }
                            </div>
                        }
                        else if ( ActiveCustomizeTab == CustomizeTab.Stickers )
                        {
                            GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Sticker, out var equippedSticker );
                            <label class="gs-cust-note">@Tr( "Stickers go on the weapon's sticker points." )</label>
                            <div class="cust-grid">
                                @foreach ( var sticker in GetParts( GunsmithPartType.Sticker ) )
                                {
                                    var s = sticker;
                                    <div class="cust-item sticker @(equippedSticker == s ? "active" : "")" style="background-image: url( '@s.StickerImage' )" @onclick=@(() => EquipPart( s ))>
                                        @if ( equippedSticker == s ) { <i class="cust-check">check</i> }
                                    </div>
                                }
                                @if ( !GetParts( GunsmithPartType.Sticker ).Any() )
                                {
                                    <label class="cust-empty">@Tr( "No stickers" )</label>
                                }
                            </div>
                        }
                        else if ( ActiveCustomizeTab == CustomizeTab.Reticle )
                        {
                            GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Reticle, out var equippedReticle );
                            <div class="cust-grid">
                                @foreach ( var reticle in GetParts( GunsmithPartType.Reticle ) )
                                {
                                    var r = reticle;
                                    var reticlePreview = string.IsNullOrEmpty( r.ReticlePreview ) ? r.CamoTexture : r.ReticlePreview;
                                    var reticleStyle = $"background-image: url( '{reticlePreview}' ); background-image-tint: {CustomReticleColor.WithAlpha( 1f ).Hex}";
                                    <div class="cust-item reticle-item @(equippedReticle == r ? "active" : "")" @onclick=@(() => EquipPart( r ))>
                                        <div class="reticle-icon" style="@reticleStyle"></div>
                                        <label class="reticle-name">@r.Name</label>
                                        @if ( equippedReticle == r ) { <i class="cust-check">check</i> }
                                    </div>
                                }
                                @if ( !GetParts( GunsmithPartType.Reticle ).Any() )
                                {
                                    <label class="cust-empty">@Tr( "No reticles available" )</label>
                                }
                            </div>

                            <div class="gs-cust-extra">
                                <label class="gs-section-label">@Tr( "RETICLE COLOUR" )</label>
                                <div class="gs-subpanel">
                                    <Facepunch.UI.ColorPicker Value:bind="@CustomReticleColor" />
                                </div>

                                <div class="gs-cust-extra-head">
                                    <label class="gs-section-label">@Tr( "ADJUST RETICLE" )</label>
                                    <div class="gs-text-btn" @onclick=@ResetReticleTransform><label>@Tr( "RESET" )</label></div>
                                </div>
                                <div class="gs-subpanel">
                                    <div class="gs-slider">
                                        <div class="gs-slider-head"><label>@Tr( "Size" )</label><label class="gs-slider-value">@CustomReticleScale.ToString( "0.00" )x</label></div>
                                        <CustomSlider Value:bind="@CustomReticleScale" Min=@(0.25f) Max=@(3f) Step=@(0.05f) NumberFormat="0.00" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                    </div>
                                    <div class="gs-slider">
                                        <div class="gs-slider-head"><label>@Tr( "Rotation" )</label><label class="gs-slider-value">@CustomReticleRotation.ToString( "0" )°</label></div>
                                        <CustomSlider Value:bind="@CustomReticleRotation" Min=@(-180f) Max=@(180f) Step=@(5f) NumberFormat="0" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                    </div>
                                    <div class="gs-slider">
                                        <div class="gs-slider-head"><label>@Tr( "Horizontal" )</label><label class="gs-slider-value">@CustomReticleOffsetX.ToString( "+0.0;-0.0;0.0" )%</label></div>
                                        <CustomSlider Value:bind="@CustomReticleOffsetX" Min=@(-8f) Max=@(8f) Step=@(0.2f) NumberFormat="0.0" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                    </div>
                                    <div class="gs-slider">
                                        <div class="gs-slider-head"><label>@Tr( "Vertical" )</label><label class="gs-slider-value">@CustomReticleOffsetY.ToString( "+0.0;-0.0;0.0" )%</label></div>
                                        <CustomSlider Value:bind="@CustomReticleOffsetY" Min=@(-8f) Max=@(8f) Step=@(0.2f) NumberFormat="0.0" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ===================== FOOTER ===================== *@
    <div class="gs-footer">
        <label class="gs-footer-brand">RAZED</label>
        <div class="gs-footer-actions gnav-round-btns">
            <div class="gnav-round-btn @(IsShareBuildOpen ? "open" : "")" @onclick=@OpenShareBuild>
                <i>ios_share</i>
                <label class="gnav-tip">@Tr( "SHARE BUILD" )</label>
            </div>
            <div class="gnav-round-btn @(IsFirstPerson ? "open" : "")" @onclick=@ToggleFirstPerson>
                <i>visibility</i>
                <label class="gnav-tip">@Tr( "FIRST-PERSON VIEW" )</label>
            </div>
        </div>
    </div>

    <GunEmblemOverlay @ref=EmblemOverlayRef System=@System />

    @if ( _notice is not null )
    {
        <div class="gs-notice">
            <i class="gs-notice-icon">@_noticeIcon</i>
            <div class="gs-notice-copy">
                <label class="gs-notice-title">@_notice.Shown</label>
                @if ( !string.IsNullOrEmpty( _noticeBody?.English ) )
                {
                    <label class="gs-notice-body">@_noticeBody.Shown</label>
                }
            </div>
        </div>
    }

    @* ===================== SHARE BUILD ===================== *@
    @if ( IsShareBuildOpen )
    {
        <div class="gs-modal-backdrop" @onclick=@(( PanelEvent e ) => ClickBackdrop( e, CloseShareBuild ))>
            <div class="gs-modal">
                <div class="gs-modal-head">
                    <div class="gs-modal-title">
                        <label class="gs-modal-caption">@Tr( "SHARE BUILD" )</label>
                        <label class="gs-modal-name">@GetEquipmentName().ToUpper()</label>
                    </div>
                    <div class="gs-square-btn" @onclick=@CloseShareBuild><i>close</i></div>
                </div>

                <label class="gs-section-label">@Tr( "EXPORT CODE" )</label>
                <TextEntry class="gs-input code" Value:bind=@ShareBuildCode Multiline=@true />
                <div class="gs-modal-row">
                    <div class="gs-btn primary" @onclick=@CopyShareBuildCode><i>content_copy</i><label>@Tr( "COPY CODE" )</label></div>
                    <div class="gs-btn" @onclick=@RefreshShareBuildCode><i>refresh</i><label>@Tr( "REFRESH" )</label></div>
                </div>

                <label class="gs-section-label">@Tr( "IMPORT CODE" )</label>
                <TextEntry class="gs-input code" Value:bind=@ImportBuildCode Multiline=@true Placeholder=@(Tr( "Paste a shared build code..." )) />
                @if ( !string.IsNullOrWhiteSpace( ShareBuildMessage?.English ) )
                {
                    <label class="gs-modal-message @(ShareBuildMessageIsError ? "error" : "")">@ShareBuildMessage.Shown</label>
                }
                <div class="gs-btn wide" @onclick=@ImportShareBuildCode><i>download</i><label>@Tr( "APPLY TO CURRENT CLASS" )</label></div>
            </div>
        </div>
    }

    @* ===================== PRESETS ===================== *@
    @if ( IsPresetsOpen )
    {
        var presets = GunsmithPresets.Get( equip );
        var currentCode = equip is not null ? GunsmithLoadoutManager.ExportWeaponBuildCode( equip ) : null;
        <div class="gs-modal-backdrop" @onclick=@(( PanelEvent e ) => ClickBackdrop( e, ClosePresets ))>
            <div class="gs-modal">
                <div class="gs-modal-head">
                    <div class="gs-modal-title">
                        <label class="gs-modal-caption">@Tr( "PRESETS" )</label>
                        <label class="gs-modal-name">@GetEquipmentName().ToUpper()</label>
                    </div>
                    <div class="gs-square-btn" @onclick=@ClosePresets><i>close</i></div>
                </div>

                <label class="gs-modal-text">@Tr( "Save this weapon's build (attachments, camo and reticle) under a name, and put it back on any class." )</label>
                <div class="gs-modal-row">
                    <TextEntry class="gs-input grow" Value:bind=@PresetName Placeholder=@(Tr( "NAME THIS BUILD" )) />
                    <div class="gs-btn primary" @onclick=@SavePreset><i>save</i><label>@Tr( "SAVE" )</label></div>
                </div>
                @if ( !string.IsNullOrWhiteSpace( PresetMessage?.English ) )
                {
                    <label class="gs-modal-message @(PresetMessageIsError ? "error" : "")">@PresetMessage.Shown</label>
                }

                <div class="gs-preset-list">
                    @foreach ( var preset in presets )
                    {
                        var entry = preset;
                        var current = entry.Code == currentCode;
                        <div class="gs-preset @(current ? "current" : "")">
                            <i class="gs-preset-icon">description</i>
                            <label class="gs-preset-name">@entry.Name</label>
                            @if ( current )
                            {
                                <label class="gs-preset-state">@Tr( "EQUIPPED" )</label>
                            }
                            else
                            {
                                <div class="gs-btn small" @onclick=@(() => ApplyPreset( entry ))><label>@Tr( "APPLY" )</label></div>
                            }
                            <div class="gs-square-btn small danger" @onclick=@(() => DeletePreset( entry ))><i>delete</i></div>
                        </div>
                    }
                    @if ( !presets.Any() )
                    {
                        <label class="gs-modal-empty">@Tr( "No presets saved for this weapon yet." )</label>
                    }
                </div>
                <label class="gs-modal-foot">@Tr( "{0} / {1} PRESETS", presets.Count, GunsmithPresets.MaxPerWeapon )</label>
            </div>
        </div>
    }

    @* ===================== TUNING ===================== *@
    @* Weapon tuning is off (see WeaponTuningManager). Put back with tuning:
    @if ( ShowTuning )
    {
        <div class="gs-modal-backdrop" @onclick=@(( PanelEvent e ) => ClickBackdrop( e, CloseTuning ))>
            <div class="gs-modal tuning">
                <div class="gs-modal-head">
                    <div class="gs-modal-title">
                        <label class="gs-modal-caption">@Tr( "WEAPON TUNING" )</label>
                        <label class="gs-modal-name">@GetEquipmentName().ToUpper()</label>
                    </div>
                    <div class="gs-btn" @onclick=@CloseTuning><i>check</i><label>@Tr( "DONE" )</label></div>
                </div>
                <WeaponTuningPanel WeaponId=@(equip?.ResourceName) />
            </div>
        </div>
    }
    *@

    @* ===================== WEAPON STATS / COMPARE ===================== *@
    @if ( ShowCompare )
    {
        <div class="gs-modal-backdrop" @onclick=@(( PanelEvent e ) => ClickBackdrop( e, CloseCompare ))>
            <div class="gs-modal compare">
                <div class="gs-modal-head">
                    <div class="gs-modal-title">
                        <label class="gs-modal-caption">@Tr( "WEAPON STATS" )</label>
                        <label class="gs-modal-name">@GetEquipmentName().ToUpper()</label>
                    </div>
                    <div class="gs-btn" @onclick=@CloseCompare><i>check</i><label>@Tr( "DONE" )</label></div>
                </div>
                <WeaponComparePanel Weapon=@equip />
            </div>
        </div>
    }
</root>

@code
{
    internal static GunsmithPanel Instance { get; set; }
    public static bool IsAnyOpen => Game.ActiveScene.IsValid() && Game.ActiveScene.GetAllComponents<GunsmithPanel>().Any( x => x.IsValid() && x.Enabled );

    public enum GunsmithViewMode
    {
        Build,
        Customize
    }

    public enum CustomizeTab
    {
        Standard,
        Solid,
        Mastery,
        Animated,
        Glowing,
        ThreeD,
        Charms,
        Stickers,
        Reticle
    }

    [Property]
    public GunsmithSystem System { get; set; }

    private CustomizeTab ActiveCustomizeTab { get; set; } = CustomizeTab.Standard;
    private EquipmentSlot SelectedSlot { get; set; } = EquipmentSlot.Primary;
    private WeaponCategory SelectedWeaponCategory { get; set; } = WeaponCategory.AssaultRifle;
    private GunsmithViewMode Mode { get; set; } = GunsmithViewMode.Build;
    private int CamoPage { get; set; } = 0;

    private const int CamosPerPage = 15;
    private const int MaxClasses = 10;

    public bool IsCustomizing => Mode == GunsmithViewMode.Customize;
    public bool IsReticleTabOpen => IsCustomizing && ActiveCustomizeTab == CustomizeTab.Reticle;
    private bool IsFirstPerson => System.IsValid() && System.FPS;

    private Panel StageRef { get; set; }
    private GunsmithAttachmentBrowser BrowserRef { get; set; }

    /// <summary> The empty middle of the screen, in screen pixels, that GunsmithController frames the gun in. </summary>
    public Rect? StageRect => StageRef.IsValid() && StageRef.Box.Rect.Width > 1f ? StageRef.Box.Rect : null;

    /// <summary> Only the stage turns and zooms the gun: everywhere else is the gunsmith's UI. </summary>
    public bool IsPointerOverControls()
    {
        if ( IsShareBuildOpen || IsPresetsOpen || ShowTuning || ShowCompare )
            return true;

        return StageRect is not { } stage || !stage.IsInside( Mouse.Position );
    }

    /// <summary> Opened over a match from the pause menu (the "GunsmithStudio" prefab) rather than from the main menu. </summary>
    private bool InMatch
    {
        get
        {
            for ( var go = GameObject; go.IsValid(); go = go.Parent )
            {
                if ( go.Name == "GunsmithStudio" )
                    return true;
            }
            return false;
        }
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();
        ApplyDevPickerRequest();
        UpdateStats();

        if ( _notice is not null && _sinceNotice > NoticeTime )
            _notice = null;

        // Back out one step at a time: the menu's gunsmith has no pause menu, and over a match MainHUD and the pause menu ask first too.
        if ( Input.EscapePressed )
        {
            Input.EscapePressed = false;
            GoBackStep();
        }

        if ( Panel is null )
            return;

        ResponsiveLayout.Update( Panel );
        // The header's full-size tabs need about 1900 units, as in the main menu (MainMenuRoot).
        Panel.SetClass( "tight-nav", Panel.Box.Rect.Size.x * Panel.ScaleFromScreen < 1900 );
        Panel.SetClass( "in-match", InMatch );
        Panel.SetClass( "customize-mode", IsCustomizing );
        Panel.SetClass( "fps", IsFirstPerson );
    }

    protected override void OnStart()
    {
        base.OnStart();
        Instance = this;
    }

    protected override void OnEnabled()
    {
        base.OnEnabled();
        Instance = this;
    }

    protected override void OnDestroy()
    {
        base.OnDestroy();
        if ( Instance == this )
        {
            Instance = null;
        }
    }

    public static void MarkClosed()
    {
    }

    // ── Header and navigation ──────────────────────────────────────────────

    /// <summary> The main menu's tabs (MainMenuRoot). WEAPONS is this page; the others load the menu on theirs. </summary>
    private static readonly (string Route, string Icon, string Label)[] NavTabs =
    {
        ( "/", "home", "PLAY" ),
        ( null, "build", "WEAPONS" ),
        ( "/operators", "badge", "OPERATORS" ),
        ( "/ranked", "military_tech", "RANKED" ),
        ( "/new", "tune", "CUSTOM GAME" ),
        ( "/barracks", "star", "PROFILE" ),
        ( "/lobbies", "dns", "SESSIONS" ),
        ( "/store", "storefront", "STORE" ),
    };

    private ulong LocalSteamId => Client.Local.IsValid() ? Client.Local.SteamId : (Connection.Local?.SteamId ?? 0UL);

    private string LocalName
    {
        get
        {
            var n = Client.Local.IsValid() ? Client.Local.DisplayName : Connection.Local?.DisplayName;
            return string.IsNullOrWhiteSpace( n ) ? Tr( "PLAYER" ) : n.ToUpper();
        }
    }

    /// <summary> The header's navigation click (Tools/ui_sounds.py), on the UI mixer. The main menu's tabs play it too. </summary>
    private const string NavSound = "sounds/ui/menu/ui_nav_tab.sound";

    private void GoToMenu( string route )
    {
        if ( route is null || InMatch )
            return;

        Sound.Play( NavSound );
        MarkClosed();
        GameUtils.ReturnToMainMenu( route );
    }

    /// <summary> Leaves the gunsmith: back to the match it was opened over, or to the main menu. </summary>
    private void Leave()
    {
        MarkClosed();

        var studio = Scene.GetAllObjects( true ).FirstOrDefault( x => x.Name == "GunsmithStudio" );
        if ( studio.IsValid() )
        {
            studio.Destroy();
        }
        else
        {
            GameUtils.ReturnToMainMenu();
