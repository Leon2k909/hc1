    private EquipmentResource GetEquippedResource( EquipmentSlot slot )
    {
        var path = GunsmithLoadoutManager.GetSlot( slot );
        if ( string.IsNullOrEmpty( path ) ) return null;
        return ResourceLibrary.GetAll<EquipmentResource>()
            .FirstOrDefault( r => r.ResourcePath.Equals( path, StringComparison.OrdinalIgnoreCase )
                               || r.ResourceName.Equals( path, StringComparison.OrdinalIgnoreCase ) );
    }

    private EquipmentResource GetDisplayedSlotResource( EquipmentSlot slot )
    {
        var equipped = GetEquippedResource( slot );
        if ( equipped is not null )
            return equipped;

        var current = GetEquipment();
        return current is not null && current.Slot == slot ? current : null;
    }

    private string GetEquippedName( EquipmentSlot slot )
    {
        var r = GetDisplayedSlotResource( slot );
        return r != null ? r.Name.ToUpper() : "EMPTY";
    }

    private int GetEquippedLevel( EquipmentSlot slot )
    {
        var r = GetDisplayedSlotResource( slot );
        return r != null ? WeaponProgression.GetLevel( r ) : 0;
    }

    private string GetEquippedPerkName( int category )
    {
        var id = GunsmithLoadoutManager.GetPerk( category );
        if ( string.IsNullOrEmpty( id ) ) return "EMPTY";
        var p = PerkResource.All.FirstOrDefault( x =>
            x.ResourceName.Equals( id, StringComparison.OrdinalIgnoreCase )
         || x.ResourcePath.Equals( id, StringComparison.OrdinalIgnoreCase )
         || x.Name.Equals( id, StringComparison.OrdinalIgnoreCase ) );
        return p != null ? p.Name.ToUpper() : "EMPTY";
    }

    private string GetEquippedPerkIcon( int category )
    {
        var id = GunsmithLoadoutManager.GetPerk( category );
        if ( string.IsNullOrEmpty( id ) ) return "add";
        var p = PerkResource.All.FirstOrDefault( x =>
            x.ResourceName.Equals( id, StringComparison.OrdinalIgnoreCase )
         || x.ResourcePath.Equals( id, StringComparison.OrdinalIgnoreCase )
         || x.Name.Equals( id, StringComparison.OrdinalIgnoreCase ) );
        return !string.IsNullOrEmpty( p?.Icon ) ? p.Icon : "bolt";
    }

