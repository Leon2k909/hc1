@using Sandbox;
@using Sandbox.UI;
@using Facepunch.Gunsmith;
@using Facepunch.UI;

@inherits PanelComponent
@namespace Facepunch

<root class="hc1 gunsmith @(Mode == GunsmithViewMode.Customize ? "customize-mode" : "") @(ShowArmory ? "" : "armory-collapsed")">
    @* ===================== TOP BAR ===================== *@
    <div class="gs-topbar">
        <div class="gs-brand">
            <img class="gs-brand-logo" src="/ui/teams/operators_logo_banner.png" />
            <div class="gs-brand-text">
                <label class="gs-brand-name">RAZED</label>
                <label class="gs-brand-sub">GUNSMITH</label>
            </div>
        </div>

        <div class="gs-weapon-title">
            <label class="gs-weapon-name">@GetEquipmentName()</label>
            @if ( GetEquipment() is {} titleEquip )
            {
                <label class="gs-weapon-class">@($"{GetSlotName( titleEquip.Slot ).ToUpper()} · LEVEL {WeaponProgression.GetLevel( titleEquip )}")</label>
            }
        </div>

        <div class="gs-topbar-actions">
            <div class="gs-icon-btn" @onclick=@OpenShareBuild title="Share Weapon Build">
                <i>ios_share</i>
                <label>Share</label>
            </div>
            <div class="gs-icon-btn" @onclick=@OpenFriendsList title="Friends List">
                <i>group</i>
                <label>Friends</label>
            </div>
            <div class="gs-icon-btn" @onclick=@(() => ToggleFirstPerson())>
                <i>cameraswitch</i>
                <label>View</label>
            </div>
            <div class="gs-icon-btn danger" @onclick=@(() => ReturnToMainMenu())>
                <i>close</i>
                <label>Exit</label>
            </div>
        </div>
    </div>

    @* ===================== TABS ===================== *@
    <div class="gs-mode-tabs">
        <button class="gs-mode-tab gs-armory-tab @(IsArmoryVisible ? "is-selected" : "")" @onclick=@ToggleArmory><i>view_list</i> LOADOUT</button>
        <button class="gs-mode-tab @(Mode == GunsmithViewMode.Build ? "is-selected" : "")" @onclick=@(() => SetMode( GunsmithViewMode.Build ))>BUILD</button>
        <button class="gs-mode-tab @(Mode == GunsmithViewMode.Customize ? "is-selected" : "")" @onclick=@(() => SetMode( GunsmithViewMode.Customize ))>@(GameSettingsSystem.Current.Language == GameLanguage.EnglishUK ? "CUSTOMISE" : "CUSTOMIZE")</button>
    </div>

    @{
        var activeClassIndices = GunsmithLoadoutManager.GetActiveClassIndices();
        var hasManyClasses = activeClassIndices.Count > 5;
    }

    @* ===================== TOP LEFT: CLASS SELECTOR ===================== *@
    <div class="gs-class-panel @(hasManyClasses ? "has-many-classes" : "") @(ShowArmory ? "" : "collapsed")">
        <div class="gs-class-strip">
            @for ( int i = 0; i < activeClassIndices.Count; i++ )
            {
                var idx = activeClassIndices[i];
                var displayNum = i + 1;
                var classActive = GunsmithLoadoutManager.GetActiveClassIndex() == idx;
                <div class="gs-class-slot @(classActive ? "active" : "")" @onclick=@(() => SelectClass( idx ))>
                    <label class="gs-class-num">@displayNum</label>
                    <label class="gs-class-name">@GunsmithLoadoutManager.GetClassName( idx )</label>
                </div>
            }
            @if ( activeClassIndices.Count < 10 )
            {
                <div class="gs-add-class" @onclick=@CreateClass>
                    <i>add</i>
                </div>
            }
        </div>

        <div class="gs-class-actions">
            <TextEntry class="gs-rename-input" Value:bind=@ActiveClassName />
            <div class="gs-action-btn danger" @onclick=@DeleteActiveClass title="Delete Class">
                <i>delete</i>
            </div>
        </div>
    </div>

    @* ===================== LEFT: ARMORY ===================== *@
    <div class="weapon-browser @(Mode == GunsmithViewMode.Customize ? "is-hidden" : "") @(hasManyClasses ? "has-many-classes" : "") @(ShowArmory ? "" : "collapsed")">
        @* ── Equipped weapons / gear ── *@
        <label class="gs-armory-section gs-sec-weapons">WEAPONS</label>
        <div class="gs-slot-list gs-sec-weapons">
            @foreach ( var slot in new[] { EquipmentSlot.Primary, EquipmentSlot.Secondary } )
            {
                var s = slot;
                var slotActive = GetSelectedSlot() == s && SelectedPerkCategory == 0;
                var wName = GetEquippedName( s );
                var wLv   = GetEquippedLevel( s );
                var isEmpty = wName == "EMPTY";
                <div class="gs-slot-row @(slotActive ? "active" : "") @(isEmpty ? "empty" : "")" @onclick=@(() => SelectSlot( s ))>
                    <div class="gs-slot-copy">
                        <label class="gs-slot-type-badge">@GetSlotName( s ).ToUpper()</label>
                        <label class="gs-slot-weapon-name">@wName</label>
                    </div>
                    @if ( wLv > 0 )
                    {
                        <label class="gs-slot-lv">LV @wLv</label>
                    }
                    <i class="gs-slot-arrow">chevron_right</i>
                </div>
            }
        </div>

        <label class="gs-armory-section gs-sec-equipment">EQUIPMENT</label>
        <div class="gs-slot-list gs-sec-equipment">
            @foreach ( var slot in new[] { EquipmentSlot.Tactical, EquipmentSlot.Lethal } )
            {
                var s = slot;
                var slotActive = GetSelectedSlot() == s && SelectedPerkCategory == 0;
                var wName = GetEquippedName( s );
                var isEmpty = wName == "EMPTY";
                <div class="gs-slot-row gs-slot-row-sm @(slotActive ? "active" : "") @(isEmpty ? "empty" : "")" @onclick=@(() => SelectSlot( s ))>
                    <div class="gs-slot-copy">
                        <label class="gs-slot-type-badge">@GetSlotName( s ).ToUpper()</label>
                        <label class="gs-slot-weapon-name">@wName</label>
                    </div>
                    <i class="gs-slot-arrow">chevron_right</i>
                </div>
            }
        </div>

        @* ── Perks ── *@
        <label class="gs-armory-section gs-sec-perks">PERKS</label>
        <div class="gs-perk-row gs-sec-perks">
            @for ( int i = 1; i <= 3; i++ )
            {
                var pc = i;
                var perkActive = SelectedPerkCategory == pc;
                var perkName = GetEquippedPerkName( pc );
                var isEmpty = perkName == "EMPTY";
                <div class="gs-perk-slot @(perkActive ? "active" : "") @(isEmpty ? "empty" : "")" @onclick=@(() => SelectPerkCategory( pc ))>
                    <i class="gs-perk-icon">@GetEquippedPerkIcon( pc )</i>
                    <label class="gs-perk-label">@perkName</label>
                    <label class="gs-perk-sub">PERK @pc</label>
                </div>
            }
        </div>

        @* ── Weapon / perk list ── *@
        <div class="weapon-list @BrowserOrderClass">
            @if ( SelectedPerkCategory > 0 )
            {
                @foreach ( var perk in PerkResource.All.Where( x => (int)x.Category == SelectedPerkCategory ).OrderBy( x => x.Name ) )
                {
                    var isEquipped = GunsmithLoadoutManager.GetPerk( SelectedPerkCategory ) == perk.ResourceName
                                  || GunsmithLoadoutManager.GetPerk( SelectedPerkCategory ) == perk.ResourcePath;
                    <button class="weapon-option is-perk @(isEquipped ? "active loadout" : "")" @onclick=@(() => GunsmithLoadoutManager.SetPerk( SelectedPerkCategory, perk.ResourceName ))>
                        <span class="weapon-name">@perk.Name</span>
                        <span class="perk-desc">@perk.Description</span>
                        @if ( isEquipped ) { <span class="weapon-state">EQUIPPED</span> }
                    </button>
                }
            }
            else
            {
                @if ( GetSelectedSlot() == EquipmentSlot.Primary || GetSelectedSlot() == EquipmentSlot.Secondary )
                {
                    var categories = GetSelectedSlot() == EquipmentSlot.Primary
                        ? new[] { WeaponCategory.AssaultRifle, WeaponCategory.SMG, WeaponCategory.LMG, WeaponCategory.Sniper, WeaponCategory.Shotgun, WeaponCategory.Marksman }
                        : new[] { WeaponCategory.Pistol, WeaponCategory.Launcher, WeaponCategory.Melee };

                    <div class="gs-cat-tabs">
                        @foreach ( var cat in categories )
                        {
                            var c = cat;
                            <button class="gs-cat-tab @(SelectedWeaponCategory == c ? "is-selected" : "")" @onclick=@(() => SelectedWeaponCategory = c)>@(c == WeaponCategory.AssaultRifle ? "ASSAULT RIFLE" : c.ToString().ToUpper())</button>
                        }
                    </div>
                }

                @foreach ( var weapon in GetWeaponsForSlot( GetSelectedSlot() ) )
                {
                    var selected = GetEquipment() == weapon;
                    var loadout  = IsLoadoutSet( weapon );
                    <button class="weapon-option @(selected ? "is-selected" : "") @(loadout ? "loadout" : "")" @onclick=@(() => SelectWeapon( weapon ))>
                        <span class="weapon-name">@weapon.Name</span>
                        <span class="weapon-lv">LV @WeaponProgression.GetLevel( weapon )</span>
                        @if ( loadout ) { <span class="weapon-state">EQUIPPED</span> }
                        @{ var wpnFav = GunsmithLoadoutManager.IsFavorite( weapon.ResourcePath ); }
                        <i class="favorite-icon" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 16px; color: @(wpnFav ? "#ffd700" : "rgba(255,255,255,0.2)");" @onclick:stopPropagation="true" @onclick=@(() => { GunsmithLoadoutManager.SetFavorite( weapon.ResourcePath, !wpnFav ); StateHasChanged(); })>@(wpnFav ? "star" : "star_border")</i>
                    </button>
                }
            }
        </div>
    </div>

    @* Stable, full-size hit targets stay clear of the weapon preview. *@
    @if ( Mode == GunsmithViewMode.Build )
    {
        <GunsmithAttachmentBrowser Weapon=@(System?.Weapon) />
    }

    <div class="layout grow">
        @*  *@
    </div>

    @* ===================== GUN EMBLEM OVERLAY ===================== *@
    <GunEmblemOverlay @ref=EmblemOverlayRef System=@System />

    @* ===================== BACKGROUND VIGNETTE ===================== *@
    <div class="gs-bg-vignette" />

    @if ( IsShareBuildOpen )
    {
        <div class="gs-share-backdrop" @onclick=@CloseShareBuild>
            <div class="gs-share-modal" @onclick:stopPropagation="true">
                <div class="gs-share-header">
                    <div class="gs-share-title">
                        <label>SHARE BUILD</label>
                        <span>@GetEquipmentName()</span>
                    </div>
                    <button class="gs-share-close" @onclick=@CloseShareBuild>
                        <i>close</i>
                    </button>
                </div>

                <label class="gs-share-label">EXPORT CODE</label>
                <TextEntry class="gs-share-code" Value:bind=@ShareBuildCode Multiline=@true />
                <div class="gs-share-actions">
                    <button class="gs-share-button primary" @onclick=@CopyShareBuildCode>
                        <i>content_copy</i>
                        <span>Copy Code</span>
                    </button>
                    <button class="gs-share-button" @onclick=@RefreshShareBuildCode>
                        <i>refresh</i>
                        <span>Refresh</span>
                    </button>
                </div>

                <label class="gs-share-label">IMPORT CODE</label>
                <TextEntry class="gs-share-code import" Value:bind=@ImportBuildCode Multiline=@true Placeholder="Paste a shared build code..." />
                @if ( !string.IsNullOrWhiteSpace( ShareBuildMessage ) )
                {
                    <label class="gs-share-message @(ShareBuildMessageIsError ? "error" : "")">@ShareBuildMessage</label>
                }
                <button class="gs-share-button import" @onclick=@ImportShareBuildCode>
                    <i>download</i>
                    <span>Apply To Current Class</span>
                </button>
            </div>
        </div>
    }

    @* ===================== BOTTOM: TUNING + LOADOUT ===================== *@
    <div class="gs-bottom @(Mode == GunsmithViewMode.Build ? "build-mode" : "")">
        @if ( Mode == GunsmithViewMode.Customize )
        {
            <div class="gs-customize-row">
                @{
                    var equip = GetEquipment();
                    var currentLevel = equip != null ? WeaponProgression.GetLifetimeLevel( equip ) : 0;
                    var isSteamAdmin = Game.SteamId == 76561198271608270ul;

                    var allCamos = GetParts( GunsmithPartType.Camoflague ).ToList();
                    var patternCamos = allCamos.Where(x => !string.IsNullOrEmpty(x.CamoTexture)).ToList();
                    var solidCamos = allCamos.Where(x => string.IsNullOrEmpty(x.CamoTexture)).ToList();
                    
                    var totalCamoPages = Math.Max( 1, (int)Math.Ceiling( (double)patternCamos.Count / 15 ) );
                    var pagedCamos = patternCamos.Skip( CamoPage * 15 ).Take( 15 );
                    GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Camoflague, out var equippedCamo );
                }

                <div class="gs-tab-nav">
                    @foreach ( CustomizeTab tab in Enum.GetValues( typeof(CustomizeTab) ) )
                    {
                        <div class="gs-tab-btn @(ActiveCustomizeTab == tab ? "active" : "")" @onclick=@(() => ActiveCustomizeTab = tab)>
                            <label>@(tab == CustomizeTab.ThreeD ? "3D" : tab.ToString())</label>
                        </div>
                    }
                </div>

                <div class="gs-tab-content">
                @if ( ActiveCustomizeTab == CustomizeTab.Standard )
                {
                @* ----- Camouflages ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Camouflages</label>
                    <div class="cust-grid">
                        @foreach ( var camo in pagedCamos )
                        {
                            var unlocked = isSteamAdmin || currentLevel >= camo.RequiredLevel;
                            var isEquipped = equippedCamo == camo;
                            var camoStyle = GetCamoTileStyle( camo );
                            <div class="cust-item @(isEquipped ? "active" : "") @(!unlocked ? "locked" : "")" style="@camoStyle; position: relative;" @onclick=@(() => EquipPart( camo ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                                @if ( !unlocked )
                                {
                                    <div class="locked-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
                                        <i style="font-size: 24px; opacity: 0.8;">lock</i>
                                        <label style="font-size: 12px; font-weight: bold; opacity: 0.8;">LV @camo.RequiredLevel</label>
                                    </div>
                                }
                                @{ var isFav = GunsmithLoadoutManager.IsFavorite( camo.ResourcePath ); }
                                <i class="favorite-icon" style="position: absolute; right: 4px; top: 4px; font-size: 14px; text-shadow: 0px 0px 4px black; color: @(isFav ? "#ffd700" : "rgba(255,255,255,0.4)"); pointer-events: all; cursor: pointer; z-index: 10;" @onclick:stopPropagation="true" @onclick=@(() => { GunsmithLoadoutManager.SetFavorite( camo.ResourcePath, !isFav ); StateHasChanged(); })>@(isFav ? "star" : "star_border")</i>
                            </div>
                        }
                    </div>

                    <div style="display: flex; flex-direction: row; gap: 8px; justify-content: center; align-items: center; margin-top: 5px;">
                        <button class="gs-icon-btn" style="padding: 4px 10px; @(CamoPage == 0 ? "opacity: 0.5; pointer-events: none;" : "")" @onclick=@(() => CamoPage--)>
                            <i>chevron_left</i> Prev
                        </button>
                        <label style="color: rgba(255,255,255,0.7); font-size: 11px; font-weight: bold; width: 60px; text-align: center;">@(CamoPage + 1) / @totalCamoPages</label>
                        <button class="gs-icon-btn" style="padding: 4px 10px; @(CamoPage >= totalCamoPages - 1 ? "opacity: 0.5; pointer-events: none;" : "")" @onclick=@(() => CamoPage++)>
                            Next <i>chevron_right</i>
                        </button>
                    </div>

                    <div class="gs-setting-btn @(CamoOnOptics ? "active" : "")" @onclick=@ToggleCamoOnOptics style="color: white; margin-top: 10px; display: flex; align-items: center; gap: 8px; cursor: pointer; opacity: 0.8; font-size: 14px;">
                        <i style="font-size: 20px;">@(CamoOnOptics ? "check_box" : "check_box_outline_blank")</i>
                        <label style="cursor: pointer;">Apply Camo to Optics</label>
                    </div>

                    <div class="gs-setting-btn @(EmblemOnGun ? "active" : "")" @onclick=@ToggleEmblemOnGun style="color: white; margin-top: 6px; display: flex; align-items: center; gap: 8px; cursor: pointer; opacity: 0.8; font-size: 14px;">
                        <i style="font-size: 20px;">@(EmblemOnGun ? "check_box" : "check_box_outline_blank")</i>
                        <label style="cursor: pointer;">Show Emblem on Gun</label>
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.Solid )
                {
                @* ----- Solid Colors ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Solid Colors</label>
                    <div class="cust-grid">
                        @foreach ( var camo in solidCamos )
                        {
                            var unlocked = isSteamAdmin || currentLevel >= camo.RequiredLevel;
                            var isEquipped = equippedCamo == camo;
                            <div class="cust-item @(isEquipped ? "active" : "") @(!unlocked ? "locked" : "")" style="background-color: @camo.CamoTint.Hex; position: relative;" @onclick=@(() => EquipPart( camo ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                                @if ( !unlocked )
                                {
                                    <div class="locked-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
                                        <i style="font-size: 24px; opacity: 0.8;">lock</i>
                                        <label style="font-size: 12px; font-weight: bold; opacity: 0.8;">LV @camo.RequiredLevel</label>
                                    </div>
                                }
                                @{ var isFav = GunsmithLoadoutManager.IsFavorite( camo.ResourcePath ); }
                                <i class="favorite-icon" style="position: absolute; right: 4px; top: 4px; font-size: 14px; text-shadow: 0px 0px 4px black; color: @(isFav ? "#ffd700" : "rgba(255,255,255,0.4)"); pointer-events: all; cursor: pointer; z-index: 10;" @onclick:stopPropagation="true" @onclick=@(() => { GunsmithLoadoutManager.SetFavorite( camo.ResourcePath, !isFav ); StateHasChanged(); })>@(isFav ? "star" : "star_border")</i>
                            </div>
                        }
                    </div>

                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1);">
                        <label class="gs-panel-label" style="font-size: 13px; color: rgba(255,255,255,0.8);">Custom Paint</label>
                        <div class="gs-setting-btn @(IsCustomCamoColorEquipped ? "active" : "")" @onclick=@ToggleCustomCamoColor style="color: white; display: flex; align-items: center; gap: 8px; cursor: pointer; opacity: 0.8; font-size: 14px; margin-bottom: 10px;">
                            <i style="font-size: 20px;">@(IsCustomCamoColorEquipped ? "check_box" : "check_box_outline_blank")</i>
                            <label style="cursor: pointer;">Enable Custom Color</label>
                        </div>
                        @if ( IsCustomCamoColorEquipped )
                        {
                            <div style="background-color: rgba(0,0,0,0.5); padding: 10px; border-radius: 4px; pointer-events: all;">
                                <Facepunch.UI.ColorPicker Value:bind="@CustomCamoColor" />
                                
                                <div style="margin-top: 10px;">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                        <label style="font-size: 12px; color: rgba(255,255,255,0.7);">Opacity</label>
                                        <label style="font-size: 12px; color: white;">@CustomCamoOpacity.ToString("0.00")</label>
                                    </div>
                                    <CustomSlider style="width: 250px;" Value:bind="@CustomCamoOpacity" Min=@(0f) Max=@(1f) Step=@(0.01f) NumberFormat="0.00" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                </div>
                            </div>

                            <label class="gs-panel-label" style="margin-top: 10px;">Finish</label>
                            <div style="flex-direction: row; gap: 6px; pointer-events: all;">
                                @for ( int fi = 0; fi < GunsmithLoadoutManager.FinishNames.Length; fi++ )
                                {
                                    var idx = fi;
                                    <div class="cust-item @(CustomCamoFinish == idx ? "active" : "")" style="width: auto; height: auto; padding: 8px 14px; font-size: 12px;" @onclick=@(() => SetFinish( idx ))>
                                        <label class="cust-name" style="font-size: 12px;">@GunsmithLoadoutManager.FinishNames[idx]</label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.Mastery )
                {
                @* ----- Mastery Camos ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Mastery Camos</label>
                    @{
                        GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.MasteryCamo, out var equippedMastery );
                    }
                    <div class="cust-grid">
                        @foreach ( var camo in GetParts( GunsmithPartType.MasteryCamo ) )
                        {
                            var unlocked = isSteamAdmin || currentLevel >= camo.RequiredLevel;
                            var isEquipped = equippedMastery == camo;
                            var camoStyle = GetCamoTileStyle( camo );
                            <div class="cust-item @(isEquipped ? "active" : "") @(!unlocked ? "locked" : "")" style="@camoStyle; position: relative;" @onclick=@(() => EquipPart( camo ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                                @if ( !unlocked )
                                {
                                    <div class="locked-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
                                        <i style="font-size: 24px; opacity: 0.8;">lock</i>
                                        <label style="font-size: 12px; font-weight: bold; opacity: 0.8;">LV @camo.RequiredLevel</label>
                                    </div>
                                }
                                @{ var isFav = GunsmithLoadoutManager.IsFavorite( camo.ResourcePath ); }
                                <i class="favorite-icon" style="position: absolute; right: 4px; top: 4px; font-size: 14px; text-shadow: 0px 0px 4px black; color: @(isFav ? "#ffd700" : "rgba(255,255,255,0.4)"); pointer-events: all; cursor: pointer; z-index: 10;" @onclick:stopPropagation="true" @onclick=@(() => { GunsmithLoadoutManager.SetFavorite( camo.ResourcePath, !isFav ); StateHasChanged(); })>@(isFav ? "star" : "star_border")</i>
                            </div>
                        }
                        @if ( !GetParts( GunsmithPartType.MasteryCamo ).Any() )
                        {
                            <label class="cust-empty">No mastery camos</label>
                        }
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.Animated )
                {
                @* ----- Animated Camos ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Animated Camos</label>
                    @{
                        GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.AnimatedCamo, out var equippedAnimated );
                    }
                    <div class="cust-grid">
                        @foreach ( var camo in GetParts( GunsmithPartType.AnimatedCamo ) )
                        {
                            var unlocked = isSteamAdmin || currentLevel >= camo.RequiredLevel;
                            var isEquipped = equippedAnimated == camo;
                            var camoStyle = GetCamoTileStyle( camo );
                            <div class="cust-item @(isEquipped ? "active" : "") @(!unlocked ? "locked" : "")" style="@camoStyle; position: relative;" @onclick=@(() => EquipPart( camo ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                                @if ( !unlocked )
                                {
                                    <div class="locked-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
                                        <i style="font-size: 24px; opacity: 0.8;">lock</i>
                                        <label style="font-size: 12px; font-weight: bold; opacity: 0.8;">LV @camo.RequiredLevel</label>
                                    </div>
                                }
                                @{ var isFav = GunsmithLoadoutManager.IsFavorite( camo.ResourcePath ); }
                                <i class="favorite-icon" style="position: absolute; right: 4px; top: 4px; font-size: 14px; text-shadow: 0px 0px 4px black; color: @(isFav ? "#ffd700" : "rgba(255,255,255,0.4)"); pointer-events: all; cursor: pointer; z-index: 10;" @onclick:stopPropagation="true" @onclick=@(() => { GunsmithLoadoutManager.SetFavorite( camo.ResourcePath, !isFav ); StateHasChanged(); })>@(isFav ? "star" : "star_border")</i>
                            </div>
                        }
                        @if ( !GetParts( GunsmithPartType.AnimatedCamo ).Any() )
                        {
                            <label class="cust-empty">No animated camos</label>
                        }
                    </div>

                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1);">
                        <label class="gs-panel-label" style="font-size: 13px; color: rgba(255,255,255,0.8);">Custom Animation</label>
                        <div class="gs-setting-btn @(IsCustomAnimatedCamoSpeedEquipped ? "active" : "")" @onclick=@ToggleCustomAnimatedCamoSpeed style="color: white; display: flex; align-items: center; gap: 8px; cursor: pointer; opacity: 0.8; font-size: 14px; margin-bottom: 10px;">
                            <i style="font-size: 20px;">@(IsCustomAnimatedCamoSpeedEquipped ? "check_box" : "check_box_outline_blank")</i>
                            <label style="cursor: pointer;">Enable Custom Speed/Direction</label>
                        </div>
                        @if ( IsCustomAnimatedCamoSpeedEquipped )
                        {
                            <div style="background-color: rgba(0,0,0,0.5); padding: 15px; border-radius: 4px; pointer-events: all; display: flex; flex-direction: column; gap: 15px;">
                                <div style="width: 250px; flex-shrink: 0;">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                        <label style="font-size: 12px; color: rgba(255,255,255,0.7); white-space: nowrap;">Horizontal Speed</label>
                                        <label style="font-size: 12px; color: white; white-space: nowrap;">@CustomAnimatedCamoSpeedX.ToString("0.00")</label>
