    /// <summary>
    /// Back (Escape, the breadcrumbs' back button): closes whatever is open on top, one step at a time, then leaves the
    /// gunsmith.
    /// </summary>
    private void GoBackStep()
    {
        if ( ShowTuning ) ShowTuning = false;
        else if ( ShowCompare ) ShowCompare = false;
        else if ( IsPresetsOpen ) ClosePresets();
        else if ( IsShareBuildOpen ) CloseShareBuild();
        else if ( IsFirstPerson ) ToggleFirstPerson();
        else if ( IsAttachmentDrawerOpen ) BrowserRef.Back();
        else if ( ShowDetails ) ShowDetails = false;
        else if ( IsPickerOpen ) ClosePicker();
        else if ( IsClassListOpen ) IsClassListOpen = false;
        else
        {
            Leave();
            return;
        }

        StateHasChanged();
    }

    /// <summary> Escape over a match: the gunsmith, when it's open, steps back before MainHUD or the pause menu take it. </summary>
    public static bool HandleEscapeAny()
    {
        var panel = Instance;
        if ( !panel.IsValid() || !panel.Enabled )
            return false;

        panel.GoBackStep();
        return true;
    }

