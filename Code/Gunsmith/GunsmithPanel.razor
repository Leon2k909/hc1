    /// <summary>Every category that paints the gun. ApplyAttachments resolves these in order, so all
    /// of them have to be cleared when a new camo is equipped — missing one makes camos look stuck.</summary>
    private static readonly GunsmithPartType[] CamoCategories =
    {
        GunsmithPartType.Camoflague,
        GunsmithPartType.MasteryCamo,
        GunsmithPartType.AnimatedCamo,
        GunsmithPartType.GlowingCamo,
        GunsmithPartType.Camoflague3D,
    };

    private static bool IsCamoCategory( GunsmithPartType category ) => category is GunsmithPartType.Camoflague
        or GunsmithPartType.MasteryCamo
        or GunsmithPartType.AnimatedCamo
        or GunsmithPartType.GlowingCamo
        or GunsmithPartType.Camoflague3D;

