        // Picking a weapon puts it in the class, as in CoD (and like perks); there's no separate Equip step. The picker
        // stays open, so you can look through the guns on the stand.
        GunsmithLoadoutManager.SetSlot( resource.Slot, resource.ResourcePath );
        System.SetEquipment( resource );
