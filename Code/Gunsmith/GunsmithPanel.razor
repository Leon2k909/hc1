                    <div class="cust-grid">
                        @foreach ( var camo in GetParts( GunsmithPartType.GlowingCamo ) )
                        {
                            var unlocked = isSteamAdmin || currentLevel >= camo.RequiredLevel;
                            var isEquipped = equippedGlowing == camo;
                            var camoStyle = GetCamoTileStyle( camo );
                            <div class="cust-item @(isEquipped ? "active" : "") @(!unlocked ? "locked" : "")" style="@camoStyle; position: relative; box-shadow: 0 0 15px @camo.CamoTint.Hex;" @onclick=@(() => EquipPart( camo ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                                @if ( !unlocked )
                                {
                                    <div class="locked-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
                                        <i style="font-size: 24px; opacity: 0.8;">lock</i>
                                        <label style="font-size: 12px; font-weight: bold; opacity: 0.8;">LV @camo.RequiredLevel</label>
                                    </div>
                                }
                                @{ var isFav = GunsmithLoadoutManager.IsFavorite( camo.ResourcePath ); }
                                <i class="favorite-icon" style="position: absolute; right: 4px; top: 4px; font-size: 14px; text-shadow: 0px 0px 4px black; color: @(isFav ? "#ffd700" : "rgba(255,255,255,0.4)"); pointer-events: all; cursor: pointer; z-index: 10;" @onclick:stopPropagation="true" @onclick=@(() => { GunsmithLoadoutManager.SetFavorite( camo.ResourcePath, !isFav ); StateHasChanged(); })>@(isFav ? "star" : "star_border")</i>
                            </div>
                        }
                        @if ( !GetParts( GunsmithPartType.GlowingCamo ).Any() )
                        {
                            <label class="cust-empty">No glowing camos</label>
                        }
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.ThreeD )
                {
                @* ----- 3D Camos ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">3D Camos</label>
                    @{
                        GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Camoflague3D, out var equippedThreeD );
                    }
                    <div class="cust-grid">
                        @foreach ( var camo in GetParts( GunsmithPartType.Camoflague3D ) )
                        {
                            var unlocked = isSteamAdmin || currentLevel >= camo.RequiredLevel;
                            var isEquipped = equippedThreeD == camo;
                            var camoStyle = GetCamoTileStyle( camo );
                            <div class="cust-item @(isEquipped ? "active" : "") @(!unlocked ? "locked" : "")" style="@camoStyle; position: relative;" @onclick=@(() => EquipPart( camo ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                                @if ( !unlocked )
                                {
                                    <div class="locked-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
                                        <i style="font-size: 24px; opacity: 0.8;">lock</i>
                                        <label style="font-size: 12px; font-weight: bold; opacity: 0.8;">LV @camo.RequiredLevel</label>
                                    </div>
                                }
                                @{ var isFav = GunsmithLoadoutManager.IsFavorite( camo.ResourcePath ); }
                                <i class="favorite-icon" style="position: absolute; right: 4px; top: 4px; font-size: 14px; text-shadow: 0px 0px 4px black; color: @(isFav ? "#ffd700" : "rgba(255,255,255,0.4)"); pointer-events: all; cursor: pointer; z-index: 10;" @onclick:stopPropagation="true" @onclick=@(() => { GunsmithLoadoutManager.SetFavorite( camo.ResourcePath, !isFav ); StateHasChanged(); })>@(isFav ? "star" : "star_border")</i>
                            </div>
                        }
                        @if ( !GetParts( GunsmithPartType.Camoflague3D ).Any() )
                        {
                            <label class="cust-empty">No 3D camos</label>
                        }
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.Charms )
                {
                @* ----- Charms ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Charms</label>
                    @{
                        GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Charm, out var equippedCharm );
                    }
                    <div class="cust-grid">
                        @foreach ( var charm in GetParts( GunsmithPartType.Charm ) )
                        {
                            var isEquipped = equippedCharm == charm;
                            <div class="cust-item charm @(isEquipped ? "active" : "")" @onclick=@(() => EquipPart( charm ))>
                                <label class="cust-name">@charm.Name</label>
                                @if ( isEquipped )
                                {
                                    <i class="cust-check">check</i>
                                }
                            </div>
                        }
                        @if ( !GetParts( GunsmithPartType.Charm ).Any() )
                        {
                            <label class="cust-empty">No charms</label>
                        }
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.Stickers )
                {
                @* ----- Stickers ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Stickers</label>
                    <label style="font-size: 11px; color: rgba(255,255,255,0.5); margin-top: -5px; margin-bottom: 10px; display: block;">Stickers will be placed on valid sticker points on the weapon.</label>
                    
                    @{
                        GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Sticker, out var equippedSticker );
                    }
                    <div class="cust-grid">
                        @foreach ( var sticker in GetParts( GunsmithPartType.Sticker ) )
                        {
                            var isEquipped = equippedSticker == sticker;
                            <div class="cust-item sticker @(isEquipped ? "active" : "")" style="background-image: url( '@sticker.StickerImage' );" @onclick=@(() => EquipPart( sticker ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                            </div>
                        }
                        @if ( !GetParts( GunsmithPartType.Sticker ).Any() )
                        {
                            <label class="cust-empty">No stickers</label>
                        }
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.Reticle )
                {
                @* ----- Reticles ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Reticle Shape</label>
                    
                    @{
                        GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.Reticle, out var equippedReticle );
                    }
                    <div class="cust-grid">
                        @foreach ( var reticle in GetParts( GunsmithPartType.Reticle ) )
                        {
                            var isEquipped = equippedReticle == reticle;
                            var reticleStyle = $"background-image: url( '{reticle.CamoTexture.Replace(".png", ".vtex")}' ); background-size: contain; background-repeat: no-repeat; background-position: center;";
                            <div class="cust-item @(isEquipped ? "active" : "")" style="@reticleStyle position: relative;" @onclick=@(() => EquipPart( reticle ))>
                                @if ( isEquipped )
                                {
                                    <i>check</i>
                                }
                            </div>
                        }
                        @if ( !GetParts( GunsmithPartType.Reticle ).Any() )
                        {
                            <label class="cust-empty">No reticles available</label>
                        }
                    </div>

                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1);">
                        <label class="gs-panel-label" style="font-size: 13px; color: rgba(255,255,255,0.8);">Reticle Color</label>
                        <div style="background-color: rgba(0,0,0,0.5); padding: 10px; border-radius: 4px; pointer-events: all; margin-top: 10px;">
                            <Facepunch.UI.ColorPicker Value:bind="@CustomReticleColor" />
                        </div>
                    </div>
                </div>
                }
                </div>
            </div>
        }
        else
        {
            <div class="gs-bottom-row">
                @if ( GetEquipment() is {} selectedEquip )
                {
                    <div class="gs-detail-head">
                        <div class="gs-lv-badge">@WeaponProgression.GetLevel( selectedEquip )</div>
                        <div class="gs-detail-meta">
                            <label class="gs-detail-name">@selectedEquip.Name</label>
                            <div class="gs-xp-wrap">
                                <div class="gs-xp-fill" style="width: @((WeaponProgression.GetLevelProgress( selectedEquip ) * 100f).ToString("0.#"))%;" />
                            </div>
                            <label class="gs-xp-label">@WeaponProgression.GetXPIntoLevel( selectedEquip ) / @WeaponProgression.GetXPForNextLevel( selectedEquip ) XP</label>
                        </div>
                    </div>
                }

                <div class="gs-tuning-btn @(ShowTuning ? "active" : "")" @onclick=@ToggleTuning>
                    <i>tune</i>
                    <label>TUNING</label>
                </div>

                <div class="gs-loadout-section">
                    <div class="gs-loadout-btn @(IsLoadoutSet() ? "set" : "")" @onclick=@SetLoadout>
                        <i>@(IsLoadoutSet() ? "check_circle" : "add_circle")</i>
                        <label>@(IsLoadoutSet() ? "Equipped" : "Equip")</label>
                    </div>
                </div>
            </div>
        }
    </div>
    @if ( ShowTuning )
    {
        <div class="gs-tuning-backdrop" @onclick=@ToggleTuning>
            <div class="gs-tuning-dialog" @onclick:stopPropagation="true">
                <div class="gs-tuning-heading"><label>WEAPON TUNING</label><button class="gs-icon-btn" @onclick=@ToggleTuning><i>close</i> Done</button></div>
                <WeaponTuningPanel WeaponId=@(GetEquipment()?.ResourceName) />
            </div>
        </div>
    }
</root>

@code
{
    internal static GunsmithPanel Instance { get; set; }
    public static bool IsAnyOpen => Game.ActiveScene.IsValid() && Game.ActiveScene.GetAllComponents<GunsmithPanel>().Any( x => x.IsValid() && x.Enabled );

    public enum GunsmithViewMode
    {
        Build,
        Customize
    }

    public enum CustomizeTab
    {
        Standard,
        Solid,
        Mastery,
        Animated,
        Glowing,
        ThreeD,
        Charms,
        Stickers,
        Reticle
    }

    [Property]
    public GunsmithSystem System { get; set; }

    private CustomizeTab ActiveCustomizeTab { get; set; } = CustomizeTab.Standard;
    private EquipmentSlot SelectedSlot { get; set; } = EquipmentSlot.Primary;
    private WeaponCategory SelectedWeaponCategory { get; set; } = WeaponCategory.AssaultRifle;
    private GunsmithViewMode Mode { get; set; } = GunsmithViewMode.Build;
    private int CamoPage { get; set; } = 0;

    public bool IsCustomizing => Mode == GunsmithViewMode.Customize;
    public bool IsArmoryVisible => ShowArmory && !IsCustomizing;
    public bool IsAttachmentBrowserOpen => Panel?.Children.OfType<GunsmithAttachmentBrowser>().Any( p => p.SelectedPoint.IsValid() ) ?? false;

    public bool IsPointerOverControls()
    {
        if ( Panel is null ) return false;
        foreach ( var child in Panel.Children )
        {
            if ( child is GunsmithAttachmentBrowser browser )
            {
                if ( browser.IsPointerOverControls() ) return true;
                continue;
            }
            if ( child.HasClass( "collapsed" ) || child.HasClass( "is-hidden" ) ) continue;
            if ( IsCustomizing && child.HasClass( "gs-class-panel" ) ) continue;
            if ( !(child.HasClass( "gs-topbar" ) || child.HasClass( "gs-mode-tabs" ) || child.HasClass( "gs-class-panel" )
                || child.HasClass( "weapon-browser" ) || child.HasClass( "gs-bottom" ) || child.HasClass( "gs-share-backdrop" ) || child.HasClass( "gs-tuning-backdrop" )) ) continue;
            if ( child.Box.Rect.IsInside( Mouse.Position ) ) return true;
        }
        return false;
    }

    protected override void OnUpdate()
    {
        base.OnUpdate();
        ResponsiveLayout.Update( Panel );
    }

    protected override void OnStart()
    {
        base.OnStart();
        Instance = this;
    }

    protected override void OnEnabled()
    {
        base.OnEnabled();
        Instance = this;
    }

    protected override void OnDisabled()
    {
        base.OnDisabled();
    }

    protected override void OnDestroy()
    {
        base.OnDestroy();
        if ( Instance == this )
        {
            Instance = null;
        }
    }

    public static void MarkClosed()
    {
    }

    private static readonly EquipmentSlot[] WeaponSlots =
    {
        EquipmentSlot.Primary,
        EquipmentSlot.Secondary,
        EquipmentSlot.Tactical,
        EquipmentSlot.Lethal,
    };

    private void ToggleFirstPerson()
    {
        if ( !System.IsValid() )
            return;

        System.Toggle();
    }

    private void ReturnToMainMenu()
    {
        MarkClosed();

        var studio = Scene.GetAllObjects( true ).FirstOrDefault( x => x.Name == "GunsmithStudio" );
        if ( studio.IsValid() )
        {
            studio.Destroy();
        }
        else
        {
            GameUtils.ReturnToMainMenu();
        }
    }

    private void OpenFriendsList()
    {
        if ( !Game.IsEditor )
        {
            Game.Overlay.ShowFriendsList( new Sandbox.Modals.FriendsListModalOptions()
            {
                ShowOfflineMembers = true,
            } );
            return;
        }

        Toast.Instance?.Show( "Friends list overlay is not available in editor" );
    }

    private bool IsShareBuildOpen { get; set; }
    private string ShareBuildCode { get; set; } = "";
    private string ImportBuildCode { get; set; } = "";
    private string ShareBuildMessage { get; set; } = "";
    private bool ShareBuildMessageIsError { get; set; }

    private void OpenShareBuild()
    {
        RefreshShareBuildCode();
        ImportBuildCode = "";
        ShareBuildMessage = "";
        ShareBuildMessageIsError = false;
        IsShareBuildOpen = true;
        StateHasChanged();
    }

    private void CloseShareBuild()
    {
        IsShareBuildOpen = false;
        StateHasChanged();
    }

    private void RefreshShareBuildCode()
    {
        var equip = GetEquipment();
        ShareBuildCode = equip is not null ? GunsmithLoadoutManager.ExportWeaponBuildCode( equip ) : "";
        ShareBuildMessage = "";
        ShareBuildMessageIsError = false;
        StateHasChanged();
    }

    private void CopyShareBuildCode()
    {
        if ( string.IsNullOrWhiteSpace( ShareBuildCode ) )
            RefreshShareBuildCode();

        if ( string.IsNullOrWhiteSpace( ShareBuildCode ) )
        {
            ShareBuildMessage = "Select a weapon before copying a build.";
            ShareBuildMessageIsError = true;
            return;
        }

        Clipboard.SetText( ShareBuildCode );
        ShareBuildMessage = "Build code copied.";
        ShareBuildMessageIsError = false;
        Toast.Instance?.Show( "Weapon build copied" );
    }

    private void ImportShareBuildCode()
    {
        var equip = GetEquipment();
        if ( equip is null )
        {
            ShareBuildMessage = "Select a weapon before importing a build.";
            ShareBuildMessageIsError = true;
            return;
        }

        if ( !GunsmithLoadoutManager.TryImportWeaponBuildCode( equip, ImportBuildCode, out var error ) )
        {
            ShareBuildMessage = error;
            ShareBuildMessageIsError = true;
            return;
        }

        PreviewCamoPart = null;
        ApplyPreviewAttachments( equip, null );
        EmblemOverlayRef?.RefreshEmblem();
        RefreshShareBuildCode();
        ShareBuildMessage = "Build applied to the current class.";
        ShareBuildMessageIsError = false;
        Toast.Instance?.Show( "Weapon build imported" );
        StateHasChanged();
    }

    private string GetEquipmentName()
    {
        if ( !System.IsValid() || !System.Equipment.IsValid() )
            return "Gunsmith";

        return System.Equipment.Name;
    }

    private string GetCamoTileStyle( GunsmithPart camo )
    {
        // No trailing semicolon: every call site already appends "; position: relative;", and the
        // resulting ";;" makes the style parser throw mid render tree, which kills the whole tile
        // along with its click handler — so camos look present but can never be equipped.
        if ( camo is null || string.IsNullOrEmpty( camo.CamoTexture ) )
            return $"background-color: {camo?.CamoTint.Hex ?? Color.White.Hex}";

        var path = camo.CamoTexture.Replace( "camos/", "camos/ui/" ).Replace( ".png", ".vtex" );
        return $"background-image: url( '{path}' )";
    }

    private EquipmentResource GetEquipment()
    {
        if ( !System.IsValid() || !System.Equipment.IsValid() )
            return null;

        return System.Equipment;
    }

    private void ApplyPreviewAttachments( EquipmentResource equip, GunsmithPart previewCamo = null )
    {
        if ( !System.IsValid() || equip is null )
            return;

        System.ApplyPreviewAttachments( equip, previewCamo );
    }

    private EquipmentSlot GetSelectedSlot()
    {
        if ( SelectedSlot is EquipmentSlot.Primary or EquipmentSlot.Secondary )
            return SelectedSlot;

        return GetEquipment()?.Slot ?? EquipmentSlot.Primary;
    }

    private IEnumerable<EquipmentSlot> GetWeaponSlots() => WeaponSlots
        .Where( slot => GetWeaponsForSlot( slot ).Any() );

    private IEnumerable<EquipmentResource> GetWeaponsForSlot( EquipmentSlot slot ) => ResourceLibrary.GetAll<EquipmentResource>()
        .Where( x => x.Slot == slot && x.Category == SelectedWeaponCategory && x.ViewModelPrefab.IsValid() && x.MainPrefab.IsValid() && !GunsmithLoadoutManager.IsMergedWeaponResource( x ) )
        .OrderByDescending( x => GunsmithLoadoutManager.IsFavorite( x.ResourcePath ) )
        .ThenBy( x => x.Name );

    private string GetSlotName( EquipmentSlot slot ) => slot switch
    {
        EquipmentSlot.Primary => "Primary",
        EquipmentSlot.Secondary => "Secondary",
        _ => slot.ToString()
    };

    private void SelectSlot( EquipmentSlot slot )
    {
        SelectedSlot = slot;
        SelectedPerkCategory = 0;
        if ( slot == EquipmentSlot.Primary )
            SelectedWeaponCategory = WeaponCategory.AssaultRifle;
        else if ( slot == EquipmentSlot.Secondary )
            SelectedWeaponCategory = WeaponCategory.Pistol;
        StateHasChanged();
    }

    private void SelectWeapon( EquipmentResource resource )
    {
        if ( !System.IsValid() || !resource.IsValid() )
            return;

        PreviewCamoPart = null;
        CamoPage = 0;
        SelectedSlot = resource.Slot;
        System.SetEquipment( resource );
        StateHasChanged();
    }

    private void SetMode( GunsmithViewMode mode )
    {
        Mode = mode;
        StateHasChanged();
    }

    private IEnumerable<GunsmithAttachmentPoint> GetAttachmentPoints()
    {
        if ( !System.IsValid() || !System.Weapon.IsValid() )
            return Enumerable.Empty<GunsmithAttachmentPoint>();

        // Charms are handled in the Customize tab now, not as a floating attachment point in Build.
        return System.Weapon.GetComponentsInChildren<GunsmithAttachmentPoint>( true )
            .Where( p => p.Category != GunsmithPartType.Charm );
    }

    private bool IsLoadoutSet()
    {
        var equip = GetEquipment();
        if ( equip is null ) return false;
        return IsLoadoutSet( equip );
    }

    private int SelectedPerkCategory { get; set; } = 0;

    private string ActiveClassName
    {
        get => GunsmithLoadoutManager.GetClassName( GunsmithLoadoutManager.GetActiveClassIndex() );
        set
        {
            GunsmithLoadoutManager.SetClassName( GunsmithLoadoutManager.GetActiveClassIndex(), value );
            StateHasChanged();
        }
    }

    private void SelectClass( int index )
    {
        GunsmithLoadoutManager.SetActiveClassIndex( index );
        RefreshAfterActiveClassChanged();
    }

    private void CreateClass()
    {
        GunsmithLoadoutManager.CreateNewClass();
        RefreshAfterActiveClassChanged();
    }

    private void DeleteActiveClass()
    {
        GunsmithLoadoutManager.DeleteClass( GunsmithLoadoutManager.GetActiveClassIndex() );
        RefreshAfterActiveClassChanged();
    }

    private void RefreshAfterActiveClassChanged()
    {
        PreviewCamoPart = null;
        CamoPage = 0;

        var selectedSlot = GetSelectedSlot();
        var selectedSlotResource = GetEquippedResource( selectedSlot );
        var current = GetEquipment();
        var next = selectedSlotResource
                   ?? GetEquippedResource( EquipmentSlot.Primary )
                   ?? GetEquippedResource( EquipmentSlot.Secondary )
                   ?? current;

        if ( next is not null )
        {
            SelectedSlot = next.Slot;

            if ( next.Slot == EquipmentSlot.Primary || next.Slot == EquipmentSlot.Secondary )
                SelectedWeaponCategory = next.Category;
        }

        if ( System.IsValid() && next is not null && next.IsValid() && next != current )
        {
            System.SetEquipment( next );
        }
        else if ( current is not null )
        {
            ApplyPreviewAttachments( current, null );
        }

        EmblemOverlayRef?.RefreshEmblem();
        StateHasChanged();
    }

    private void SelectPerkCategory( int pc )
    {
        SelectedPerkCategory = pc;
        StateHasChanged();
    }

    private bool IsLoadoutSet( EquipmentResource resource )
    {
        if ( resource.Slot == EquipmentSlot.Tactical ) return GunsmithLoadoutManager.GetTactical() == resource.ResourceName || GunsmithLoadoutManager.GetTactical() == resource.ResourcePath;
        if ( resource.Slot == EquipmentSlot.Lethal ) return GunsmithLoadoutManager.GetLethal() == resource.ResourceName || GunsmithLoadoutManager.GetLethal() == resource.ResourcePath;
        return GunsmithLoadoutManager.GetSlot( resource.Slot ) == resource.ResourceName || GunsmithLoadoutManager.GetSlot( resource.Slot ) == resource.ResourcePath;
    }

    private void SetLoadout()
    {
        var equip = GetEquipment();
        if ( equip is null ) return;
        GunsmithLoadoutManager.SetSlot( equip.Slot, equip.ResourcePath );
        StateHasChanged();
    }

    private IEnumerable<GunsmithPart> GetParts( GunsmithPartType category )
    {
        var equip = GetEquipment();
        return ResourceLibrary.GetAll<GunsmithPart>()
            .Where( x => x.Category == category && (equip is null || x.Supports( equip )) )
            .OrderByDescending( x => GunsmithLoadoutManager.IsFavorite( x.ResourcePath ) )
            .ThenBy( x => x.Name );
    }

