                                    <CustomSlider style="width: 250px;" Value:bind="@CustomAnimatedCamoSpeedX" Min=@(-2f) Max=@(2f) Step=@(0.05f) NumberFormat="0.00" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                </div>
                                <div style="width: 250px; flex-shrink: 0;">
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                                        <label style="font-size: 12px; color: rgba(255,255,255,0.7); white-space: nowrap;">Vertical Speed</label>
                                        <label style="font-size: 12px; color: white; white-space: nowrap;">@CustomAnimatedCamoSpeedY.ToString("0.00")</label>
                                    </div>
                                    <CustomSlider style="width: 250px;" Value:bind="@CustomAnimatedCamoSpeedY" Min=@(-2f) Max=@(2f) Step=@(0.05f) NumberFormat="0.00" ShowTextEntry="@false" ShowValueTooltip="@false" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
                }

                @if ( ActiveCustomizeTab == CustomizeTab.Glowing )
                {
                @* ----- Glowing Camos ----- *@
                <div class="gs-cust-section">
                    <label class="gs-panel-label">Glowing Camos</label>
                    @{
                        GunsmithLoadoutManager.TryGetAttachment( equip, GunsmithPartType.GlowingCamo, out var equippedGlowing );
