    private string GetCamoTileStyle( GunsmithPart camo )
    {
        // No trailing semicolon: callers append more, and a ";;" makes the style parser throw mid render tree, which
        // kills the whole tile along with its click handler — so camos look present but can never be equipped.
        if ( camo is null || string.IsNullOrEmpty( camo.CamoTexture ) )
            return $"background-color: {camo?.CamoTint.Hex ?? Color.White.Hex}";

        var path = camo.CamoTexture.Replace( "camos/", "camos/ui/" ).Replace( ".png", ".vtex" );
        return $"background-image: url( '{path}' )";
    }

    private string CamoTileStyle( GunsmithPart camo, bool solid, bool glow )
    {
        var style = solid ? $"background-color: {camo.CamoTint.Hex}" : GetCamoTileStyle( camo );
        return glow ? $"{style}; box-shadow: 0 0 15px {camo.CamoTint.Hex}" : style;
    }

