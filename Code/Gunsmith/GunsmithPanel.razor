    /// <summary>
    /// Every pick is saved as it's made (and PlayerLoadout keeps the host's copy in step), so SAVE LOADOUT confirms the
    /// class. Over a match it also picks the class, as the class menu does, which swaps it in straight after a spawn.
    /// </summary>
    private void SaveLoadout()
    {
        Sound.Play( "ui_button_press" );
        Notify( new GunsmithMessage( "{0} SAVED", ActiveClassName ), InMatch ? SendClassToMatch() : "Ready for your next match" );
    }

    /// <summary>
    /// Over a match: sends the active class to the host (PlayerLoadout.SendActiveClass), which gives it now if you've only
    /// just spawned, otherwise on your next spawn. Returns what happened, for the notice.
    /// </summary>
    private GunsmithMessage SendClassToMatch()
    {
        var client = Client.Local;
        if ( !client.IsValid() )
            return null;

        if ( !PlayerLoadout.ClassesEnabled )
            return "Classes aren't used in this mode";

        if ( client.Loadout.SendActiveClass( true ) )
        {
            // Perks run on the owner, from the active class.
            client.PlayerPawn?.GetComponent<PlayerPerks>()?.LoadFromCookies();
            return "Equipped now";
        }

        return "Equipped when you next spawn";
    }

    // ── Stats ──────────────────────────────────────────────────────────────

    private GunsmithStats _stats = new();
    private GunsmithStats _baseStats = new();
    private EquipmentResource _statsFor;
    private RealTimeSince _sinceStats;

    /// <summary> The bars read the prefabs and the saved build, so they're worked out a few times a second, not every frame. </summary>
    private void UpdateStats()
    {
        var equip = GetEquipment();
        if ( equip == _statsFor && _sinceStats < 0.25f )
            return;

        if ( equip != _statsFor )
            _baseStats = equip is not null ? GunsmithStats.Compute( equip, false ) : new GunsmithStats();

        _statsFor = equip;
        _sinceStats = 0f;
        _stats = equip is not null ? GunsmithStats.Compute( equip ) : new GunsmithStats();
    }

    /// <summary>
    /// The stat bars: the build's value, and the factory weapon's, which the bar shows the difference from. HANDLING
    /// (aim-down-sights time) stands where CoD has accuracy: the game has no spread or bloom to rate.
    /// </summary>
    private IEnumerable<(string Name, float Value, float Base, string Text)> StatRows()
    {
        yield return ( "DAMAGE", _stats.Damage, _baseStats.Damage, _stats.DamageText );
        yield return ( "FIRE RATE", _stats.FireRate, _baseStats.FireRate, _stats.FireRateText );
        yield return ( "HANDLING", _stats.Handling, _baseStats.Handling, _stats.HandlingText );
        yield return ( "MOBILITY", _stats.Mobility, _baseStats.Mobility, _stats.MobilityText );
        yield return ( "RANGE", _stats.Range, _baseStats.Range, _stats.FullDamageRange is null ? Tr( "NO FALLOFF" ) : _stats.RangeText );
        yield return ( "CONTROL", _stats.Control, _baseStats.Control, _stats.ControlText );
    }

    /// <summary> A style percentage, always with a decimal point whatever the player's locale. </summary>
    private static string Pct( float fraction ) =>
        $"{(fraction.Clamp( 0f, 1f ) * 100f).ToString( "0.##", global::System.Globalization.CultureInfo.InvariantCulture )}%";

    private static string XpText( EquipmentResource resource ) => WeaponProgression.GetXPForNextLevel( resource ) > 0
        ? $"{WeaponProgression.GetXPIntoLevel( resource )} / {WeaponProgression.GetXPForNextLevel( resource )} XP"
        : Tr( "MAX LEVEL" );

    /// <summary> What the weapon's next level with an unlock brings, e.g. "LV 5 UNLOCKS: COMPENSATOR, HOLO SIGHT". </summary>
    private static string NextUnlockText( EquipmentResource resource )
    {
        if ( resource is null || AttachmentUnlocks.UnlockAll )
            return null;

        for ( var level = WeaponProgression.GetLevel( resource ) + 1; level <= WeaponProgression.MaxLevel; level++ )
        {
            var parts = AttachmentUnlocks.GetUnlocksAt( resource, level ).Select( p => p.Name.ToUpperInvariant() ).Take( 3 ).ToList();
            if ( parts.Count > 0 )
                return Tr( "LV {0} UNLOCKS: {1}", level, string.Join( ", ", parts ) );
        }
        return null;
    }

    /// <summary>
    /// Whether to show a gun's <see cref="EquipmentResource.ReviewNote"/>: only in the editor and on the developer's
    /// account, like UNLOCK ALL. Players never see it.
    /// </summary>
    private static bool ShowReviewNote( EquipmentResource equipment ) =>
        !string.IsNullOrWhiteSpace( equipment?.ReviewNote ) && ( Game.IsEditor || AttachmentUnlocks.IsDeveloper );

