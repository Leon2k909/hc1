    private void RefreshShareBuildCode()
    {
        var equip = GetEquipment();
        ShareBuildCode = equip is not null ? GunsmithLoadoutManager.ExportWeaponBuildCode( equip ) : "";
        ShareBuildMessage = null;
        ShareBuildMessageIsError = false;
        StateHasChanged();
    }

    private void CopyShareBuildCode()
    {
        if ( string.IsNullOrWhiteSpace( ShareBuildCode ) )
            RefreshShareBuildCode();

        if ( string.IsNullOrWhiteSpace( ShareBuildCode ) )
        {
            ShareBuildMessage = "Select a weapon before copying a build.";
            ShareBuildMessageIsError = true;
            return;
        }

        Clipboard.SetText( ShareBuildCode );
        ShareBuildMessage = "Build code copied.";
        ShareBuildMessageIsError = false;
    }

    private void ImportShareBuildCode()
    {
        var equip = GetEquipment();
        if ( equip is null )
        {
            ShareBuildMessage = "Select a weapon before importing a build.";
            ShareBuildMessageIsError = true;
            return;
        }

        if ( !GunsmithLoadoutManager.TryImportWeaponBuildCode( equip, ImportBuildCode, out var error ) )
        {
            ShareBuildMessage = error;
            ShareBuildMessageIsError = true;
            return;
        }

        RefreshAfterBuildChanged( equip );
        RefreshShareBuildCode();
        var locked = LockedParts( equip );
        ShareBuildMessage = locked.Count == 0
            ? "Build applied to the current class."
            : new GunsmithMessage( "Build applied to the current class. Left off until unlocked: {0}.", locked );
        ShareBuildMessageIsError = false;
        StateHasChanged();
    }

    /// <summary> The parts of a build the weapon's level hasn't unlocked, which stay off the gun until it has. </summary>
    private static List<GunsmithMessage> LockedParts( EquipmentResource equip ) =>
        GunsmithLoadoutManager.GetLockedAttachments( equip )
            .Select( p => new GunsmithMessage( "{0} (LV {1})", p.Name, AttachmentUnlocks.GetRequiredLevel( equip, p ) ) )
            .ToList();

