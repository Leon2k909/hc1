    // Clicks bubble up to every parent's handler (`@onclick:stopPropagation` does nothing here), so a modal's
    // backdrop saw every click inside it: DONE closed the tuning panel and the backdrop's toggle opened it again.

    /// <summary> A control inside a clickable row or card: runs without the row's own click firing too. </summary>
    private static void ClickInside( PanelEvent e, Action action )
    {
        e.StopPropagation();
        action();
    }

    /// <summary> A modal's backdrop closes it only when the click lands on the backdrop, not inside the modal. </summary>
    private static void ClickBackdrop( PanelEvent e, Action close )
    {
        if ( e.Target == e.This ) close();
    }

    private bool IsUnlocked( GunsmithPart part )
    {
        if ( AttachmentUnlocks.UnlockAll ) return true;

        var equip = GetEquipment();
        if ( equip is null ) return false;

        if ( IsCamoCategory( part.Category ) )
            return WeaponProgression.GetLifetimeLevel( equip ) >= part.RequiredLevel;

        return WeaponProgression.GetLevel( equip ) >= part.RequiredLevel;
    }

    private void EquipPart( GunsmithPart part )
    {
        var equip = GetEquipment();
        if ( equip is null || part is null ) return;

        if ( !IsUnlocked( part ) )
        {
            // Just preview it
            if ( IsCamoCategory( part.Category ) )
            {
                PreviewCamoPart = part;
                ApplyPreviewAttachments( equip, PreviewCamoPart );
            }
            return;
        }

        if ( IsCamoCategory( part.Category ) )
        {
            PreviewCamoPart = null;
        }

        // Toggle: clicking the equipped part removes it.
        if ( GunsmithLoadoutManager.HasAttachment( equip, part ) )
        {
            GunsmithLoadoutManager.SetAttachment( equip, part.Category, null );
        }
        else
        {
            // Only one camo is worn at a time, and ApplyAttachments resolves the categories in a fixed
            // order (Camoflague3D first, plain Camoflague last) — so a camo left in any other category
            // silently wins and the one you just clicked never shows. Clear every other category.
            if ( IsCamoCategory( part.Category ) )
            {
                foreach ( var category in CamoCategories )
                {
                    if ( category == part.Category ) continue;
                    GunsmithLoadoutManager.SetAttachment( equip, category, null );
                }

                GunsmithLoadoutManager.SetUseCustomCamoColor( equip, false );
            }

            GunsmithLoadoutManager.SetAttachment( equip, part.Category, part );
        }

        // Re-apply to update visuals.
        ApplyPreviewAttachments( equip, PreviewCamoPart );

        StateHasChanged();
    }

    protected override int BuildHash()
    {
        if ( !System.IsValid() )
            return 0;

        var equip = GetEquipment();
        var hash = new HashCode();
        hash.Add( System.Equipment );
        hash.Add( System.FPS );
        hash.Add( System.Weapon );
        hash.Add( equip is null ? 0 : WeaponProgression.GetXP( equip ) );
        hash.Add( AttachmentUnlocks.UnlockAll );
        hash.Add( IsTuned( equip ) );
        hash.Add( ShowCompare );
        hash.Add( ShowDetails );
        foreach ( var slot in GunsmithLoadoutManager.ClassSlots )
            hash.Add( GunsmithLoadoutManager.GetSlot( slot ) );
        for ( var i = 1; i <= 3; i++ )
            hash.Add( GunsmithLoadoutManager.GetPerk( i ) );

        hash.Add( Mode );
        hash.Add( ActiveCustomizeTab );
        hash.Add( CamoPage );
        hash.Add( PreviewCamoPart );
        hash.Add( CamoOnOptics );
        hash.Add( CustomCamoColor );
        hash.Add( IsCustomCamoColorEquipped );

        hash.Add( IsPickerOpen );
        hash.Add( SelectedSlot );
        hash.Add( SelectedWeaponCategory );
        hash.Add( SelectedPerkCategory );
        hash.Add( IsClassListOpen );
        hash.Add( _confirmDelete );
        hash.Add( GunsmithLoadoutManager.GetActiveClassIndex() );
        hash.Add( GunsmithLoadoutManager.GetActiveClassIndices().Count );
        hash.Add( ActiveClassName );

        hash.Add( ShowTuning );
        hash.Add( IsShareBuildOpen );
        hash.Add( ShareBuildCode );
        hash.Add( ShareBuildMessage );
        hash.Add( IsPresetsOpen );
        hash.Add( PresetMessage );
        hash.Add( _presetsVersion );

        hash.Add( _stats );
        hash.Add( _baseStats );
        hash.Add( _notice );
        hash.Add( _noticeBody );
        hash.Add( IsAttachmentDrawerOpen ? BrowserRef.SelectedPoint : null );
        hash.Add( IsAttachmentDrawerOpen && BrowserRef.IsTuning );
        hash.Add( Progression.GetLevel() );
        hash.Add( Progression.GetPrestige() );
        hash.Add( LocalName );
        return hash.ToHashCode();
    }
