    /// <summary> DELETE CLASS asks for a second click, and the last class can't be deleted. </summary>
    private void DeleteActiveClass()
    {
        if ( GunsmithLoadoutManager.GetActiveClassIndices().Count <= 1 )
            return;

        if ( !_confirmDelete )
        {
            _confirmDelete = true;
            return;
        }

        _confirmDelete = false;
        GunsmithLoadoutManager.DeleteClass( GunsmithLoadoutManager.GetActiveClassIndex() );
        RefreshAfterActiveClassChanged();
    }

    private void RefreshAfterActiveClassChanged()
    {
        PreviewCamoPart = null;
        CamoPage = 0;
        _confirmDelete = false;

        // Keep showing the same kind of weapon in the new class: its primary, or its secondary if that's on show.
        var current = GetEquipment();
        var shownSlot = current?.Slot == EquipmentSlot.Secondary ? EquipmentSlot.Secondary : EquipmentSlot.Primary;
        var next = GetEquippedResource( shownSlot )
                   ?? GetEquippedResource( EquipmentSlot.Primary )
                   ?? GetEquippedResource( EquipmentSlot.Secondary )
                   ?? current;

        if ( System.IsValid() && next is not null && next.IsValid() && next != current )
        {
            System.SetEquipment( next );
        }
        else if ( current is not null )
        {
            ApplyPreviewAttachments( current, null );
        }

        EmblemOverlayRef?.RefreshEmblem();
        StateHasChanged();
    }

